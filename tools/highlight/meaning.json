  "rxfs": {
    "extension": ".rxfs",
    "scope_name": "source.rxfs",
    "note": "the program language tools/native/rxfc.py compiles: 64-bit variables, every operator is a call of a leaf. The extension is .rxfs (the final name); pymergetic.rxf is the Python package and never a file extension",
    "keywords": [
      {
        "group": "directive",
        "scope": "keyword.control.directive.rxfs",
        "words": [
          "include",
          "const"
        ]
      },
      {
        "group": "function",
        "scope": "storage.type.function.rxfs",
        "words": [
          "program",
          "proc",
          "macro",
          "fn"
        ],
        "note": "a declaration: the next name is the name of the function"
      },
      {
        "group": "storage",
        "scope": "storage.type.rxfs",
        "words": [
          "var"
        ]
      },
      {
        "group": "flow",
        "scope": "keyword.control.flow.rxfs",
        "words": [
          "if",
          "else",
          "while",
          "switch",
          "case",
          "default",
          "break",
          "continue",
          "return",
          "refuse"
        ]
      },
      {
        "group": "proc",
        "scope": "keyword.control.proc.rxfs",
        "words": [
          "call",
          "ret"
        ]
      }
    ],
    "precedence": [
