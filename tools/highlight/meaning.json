{
  "about": "The meaning table of the RXF languages. This file is the one source the grammars of editors/rxf-highlight are generated from (tools/highlight/grammar_gen.py) and the one source the highlighting colors its meaning from: what every leaf of the function table is, what every operator of .rxfs lowers to, and which words and references .rxfd has. tests/test_highlight.py pins every transcribed part back to its source of truth; never edit the grammars by hand.",
  "sources": {
    "leaves": "native/graph.h (enum rxf_graph_leaf, shape_of): the ids are not invented here",
    "leaf_names": "tools/native/graph_header.py (RXF_LEAF_* names lowered)",
    "operators": "tools/native/rxfc.py (BINARY, binary(), unary()); native/front is the self-hosted mirror and names the same leaves in native/front/words.rxf",
    "enums": "starter/pymergetic/rxf/kinds.xml: the module pymergetic.rxf.kinds that attribute values name (pymergetic.rxf.kinds.FunctionImplementation.Semantic)",
    "ground_enums": "starter/__init__.xml: the enumerations of the ground",
    "core_enums": "src/pymergetic/rxf/core/kinds.pyi: pymergetic.rxf.core.kinds",
    "refusal_sets": "starter/pymergetic/rxf/foundation/__init__.xml",
    "reference_shapes": "src/pymergetic/rxf/core/xml/xml.hpp and the deltas of starter/"
  },
  "leaves": {
    "note": "the ids of the function table of the runtime context: one entry per native Function a graph calls. There is no leaf 0; the ids are 1 to 48 and a program that needs none of them is only moves and branches",
    "classes": {
      "arith": "the wrapping integer operations of 64 bits",
      "checked": "the checked integer operations: the status of the call is the overflow",
      "compare": "the comparisons: less and equal; the other comparisons are worked out of these",
      "bitwise": "bitwise not, and, or",
      "shift": "the shifts",
      "divrem": "integer division and remainder, 32 and 64 bits, signed and unsigned",
      "mem": "memory: copy, compare, fill",
      "hash": "the hash and the hashed containers",
      "runtime": "the runtime context: objects, transactions, borrows, text, search",
      "platform": "the pumps of the platform: live and uart",
      "compile": "the compiler as a leaf of the function table",
      "safety": "the safe point of compiled code"
    },
