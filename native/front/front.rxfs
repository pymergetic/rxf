# The front end of the language as a program of the interpreter (docs/19).
#
# Source text goes in; the words of a program of native/graph.h come out. It is the compiler of
# tools/native/rxfc.py as a program that the interpreter runs: the same language, the same words,
# byte for byte (tests/test_front.py).
#
# The request is the one of native/front/words.rxfs: source, the files an `include` can name, the
# numbers the source may use, and where the words go. The work memory holds the tables of the
# names, the tokens, the labels and the patches -- everything that does not fit in the frame.

include "words.rxfs";

program front(context, request) {
    var sp;
    var work;
    var st, at, R, R0, tk, ow, w, fr, ev_kind, ev_value;
    var ntoks, nframes, nval, nop, npatch, nlabel, ntemps, ntlive, slot_end;
    var g0, g1, g2, g3;
    var d;

    work = rq(R_WORK);
    sp = work + W_CALLSTACK;

    store64(work + G_SOURCE, rq(R_SOURCE));
    store64(work + G_SOURCE_SIZE, rq(R_SOURCE_SIZE));
    store64(work + G_OUT, rq(R_OUT));
    store64(work + G_OUT_CAP, rq(R_OUT_CAPACITY) >> 3);
    store64(work + G_WIDE, NONE);
    store64(work + G_BACK, NONE);
    store64(work + G_LASTLINE, 0);
    store64(work + G_ARENATOP, 0);
    store64(work + G_NINST, 0);
    store64(work + G_NCONST, 0);
    store64(work + G_NMACRO, 0);
    store64(work + G_NFN, 0);
    store64(work + G_NPROC, 0);
    store64(work + G_NVAR, 0);
    store64(work + G_NSITE, 0);
    store64(work + G_NCONSTRUCT, 0);
    store64(work + G_NCASE, 0);
    store64(work + G_NBODYREC, 0);
    store64(work + G_NSW, 0);
    store64(work + G_NMPARM, 0);
    store64(work + G_NFPARM, 0);
    store64(work + G_NFILES, 0);
    store64(work + G_NPARAMS, 0);
    store64(work + G_HAS_PROGRAM, 0);
    store64(work + G_CUR_PROC, 0);
    store64(work + G_CUR_LEN, 0);

    st = 0;
    at = 0;
    R = 0;
    R0 = 0;
    tk = 0;
    ow = 0;
    w = 0;
    fr = 0;
    ev_kind = 0;
    ev_value = 0;
    ntoks = 0;
    nframes = 0;
    nval = 0;
    nop = 0;
    npatch = 0;
    nlabel = 0;
    ntemps = 0;
    ntlive = 0;
    slot_end = 0;
    g0 = 0;
    g1 = 0;
    g2 = 0;
    g3 = 0;

    # the text bytes a synthetic bracket token points at, and the name `sp`
    store64(work + W_SYNTH, 40 | (41 << 8) | (115 << 16) | (112 << 24));
    store64(work + G_SP_TEXT, work + W_SYNTH + 2);

    # the numbers the request says the source may use
    store64(work + SC_I, 0);
    while load64(work + SC_I) < rq(R_CONST_COUNT) {
        store64(work + AC_TEXT,
                load64(rq(R_CONSTS) + (load64(work + SC_I) * CONST_ROW)));
        store64(work + AC_LEN,
                load64(rq(R_CONSTS) + (load64(work + SC_I) * CONST_ROW) + 8));
        store64(work + AC_VALUE,
                load64(rq(R_CONSTS) + (load64(work + SC_I) * CONST_ROW) + 16));
        call add_const;
        if st != 0 { break; }
        store64(work + SC_I, load64(work + SC_I) + 1);
    }

    if st == 0 {
        g0 = rq(R_SOURCE);
        g1 = rq(R_SOURCE_SIZE);
        call lex;
    }

    if st == 0 {
        g0 = work + W_TOKENS;
        g1 = ntoks;
        g2 = F_FILE;
        g3 = 0;
        call frame_push;
    }

    while st == 0 {
        call peek_tok;
        if R == 0 { break; }
        call item;
    }

    if st == 0 {
        call ways_back;
    }
    if st == 0 {
        call resolve_labels;
        store64(load64(work + G_OUT) + 8, slot_end);
        store64(request + R_OUT_SIZE, ow * 8);
        store64(request + R_AT, 0);
        return 0;
    }
    store64(request + R_AT, at);
    store64(request + R_OUT_SIZE, 0);
    refuse st;
}

include "lex.rxfs";
include "stream.rxfs";
include "emit.rxfs";
include "expr.rxfs";
include "parse.rxfs";
