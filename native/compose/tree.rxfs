# The tree: reading the arena of the live image as the typed object tree the composer works on.
#
# The arena is RXFB v6 (the structs of src/pymergetic/rxftk/core/ground.h): a 192-byte header, a
# directory of index chunks (4096 slots each, one cell offset per slot), and a stream of cells.
# A cell is a 64-byte header (type, parent, payload size, name, flags, ref count), then its payload
# aligned to 16, then its references (24 bytes each). A handle is a slot number; the index maps it
# to the offset of its cell, or marks it free.
#
# What is here is the reader the composer stands on: a handle to its cell, the name of a cell, and
# the child of an object with a given name. Arguments come in the shared words g0..g2; the answers
# are R (and R0..R2 where more). Every proc keeps its own scratch in the words the program
# declares (compose.rxfs), so one proc may call another without its own state being disturbed.

# ---- a handle to its cell ----------------------------------------------------------------------
# g0: handle. R: the arena offset of the cell, or HANDLE_NONE when the slot is free or out of range.
proc cell_of {
    R = HANDLE_NONE;
    if g0 < load64(work + W_HANDLES) {
        t0 = g0 >> 12;                            # the index chunk
        if t0 < load64(work + W_CHUNKS) {
            t1 = g0 & (INDEX_CHUNK - 1);          # the slot in the chunk
            t2 = arena_q(load64(work + W_INDEX_OFF) + (t0 << 3));   # the index block cell
            t2 = arena_q(t2 + CELL_BYTES + (t1 << 3));              # the entry: a cell offset
            if (t2 & 1) == 0 {
                R = t2;
            }
        }
    }
    ret;
}

# ---- the name of a cell ------------------------------------------------------------------------
# g0: the arena offset of a cell. R: the arena offset of its NUL-terminated name, 0 when unnamed.
# A cell that is not there (cell_of's HANDLE_NONE) carries no name; without this guard its name
# offset would be read from a wrapped address and the compare would walk off the arena.
proc name_of {
    R = 0;
    if g0 == HANDLE_NONE {
        ret;
    }
    R = arena_q(g0 + C_NAME);
    ret;
}

# g0: the arena offset of a name. g1: the address of the bytes to compare. g2: how many.
# R: 1 when the name is exactly those bytes (same length, then a NUL), else 0. A name at offset 0
# is no name (name_of's answer for a cell that carries none) and never matches.
proc name_eq {
    R = 0;
    if g0 == 0 {
        ret;
    }
    e0 = load64(work + W_ARENA) + g0;
    e1 = 0;
    while e1 < g2 {
        if (load8(e0 + e1) & 0xFF) != (load8(g1 + e1) & 0xFF) {
            ret;
        }
        e1 = e1 + 1;
    }
    if (load8(e0 + g2) & 0xFF) == 0 {
        R = 1;
    }
    ret;
}

# ---- the child of an object with a given name ---------------------------------------------------
# g0: the handle of the parent. g1: the address of the name bytes. g2: how many.
# R: the handle of the child whose name is those bytes, or HANDLE_NONE. The map at W_MAP answers
# the names this request has answered already (words.rxfs): the hash of (parent, name) probes its
# rows, a row of an older request answers nothing, and what the probe misses scans the index and
# fills the row the probe ended on. So a name is walked once per request, not once per question.
proc child_named {
    R = HANDLE_NONE;
    k0 = g0;                                  # the parent
    k1 = g1;                                  # the name bytes
    k2 = g2;                                  # how many

    # the hash of (parent, name): what a row of the map is keyed by
    k7 = 5381;
    k3 = 0;
    while k3 < k2 {
        k7 = xor64_(((k7 << 5) + k7), (load8(k1 + k3) & 0xFF));
        k3 = k3 + 1;
    }
    k7 = xor64_(((k7 << 5) + k7), k0);

    # the probe: the rows of this request walk from the hash; the first row of an older request is
    # empty to this one, so it is where the answer goes and where the walk ends
    k8 = k7 & (NMAP - 1);
    k10 = load64(work + W_MAP_EPOCH);
    k11 = HANDLE_NONE;
    k12 = 0;
    while k12 < NMAP {
        k9 = work + W_MAP + (k8 * MAP_ROW);
        if load64(k9 + 8) != k10 {
            k11 = k9;
            k12 = NMAP;
        }
        if load64(k9 + 8) == k10 {
            if load64(k9 + 0) == k7 {
                if load64(k9 + 16) == k0 {
                    R = load64(k9 + 24);
                    ret;
                }
            }
            k8 = (k8 + 1) & (NMAP - 1);
            k12 = k12 + 1;
        }
    }

    # what the probe missed: the scan of the index
    k13 = HANDLE_NONE;
    k3 = 0;
    k4 = load64(work + W_HANDLES);
    while k3 < k4 {
        g0 = k3;
        call cell_of;                         # R = the cell of k3
        if R != HANDLE_NONE {
            k5 = R;
            k6 = arena_q(k5 + C_TYPE) & KIND_MASK;
            if k6 != KIND_BLOCK {
                if k6 != KIND_DEAD {
                    if arena_q(k5 + C_PARENT) == k0 {
                        g0 = arena_q(k5 + C_NAME);
                        g1 = k1;
                        g2 = k2;
                        call name_eq;
                        if R == 1 {
                            k13 = k3;
                            k3 = k4;
                        }
                    }
                }
            }
        }
        k3 = k3 + 1;
    }

    # the answer -- the child, or the none of a name no handle names -- is what the row holds. A map
    # whose rows are all live keeps the hash's own row (a name that is asked again finds it there)
    if k11 == HANDLE_NONE {
        k11 = work + W_MAP + ((k7 & (NMAP - 1)) * MAP_ROW);
    }
    store64(k11 + 0, k7);
    store64(k11 + 8, k10);
    store64(k11 + 16, k0);
    store64(k11 + 24, k13);
    R = k13;
    ret;
}

# ---- the children of every parent ---------------------------------------------------------------
# W_KHEAD[p] is the first child of the parent p, W_KNEXT[h] the next child of the same parent
# (words.rxfs) -- the chains a gather walks instead of the arena. The children go in downward, so a
# chain comes out in handle order. Built once a request at its first gather; what is too tall for
# the arrays builds nothing and the gathers scan as before.
proc kids_build {
    m1 = load64(work + W_HANDLES);            # how many handles
    if m1 > KID_MAX {
        ret;
    }
    if (W_KHEAD + (m1 << 3)) > W_PLAN {
        ret;
    }
    store64(work + W_KIDS_EPOCH, load64(work + W_MAP_EPOCH));
    store64(work + W_KIDS_H, m1);

    # the chains start empty
    m0 = 0;
    while m0 < m1 {
        store32(work + W_KHEAD + (m0 << 2), NONE32);
        m0 = m0 + 1;
    }

    # the children, downward: the chain of a parent then walks in handle order
    m0 = m1;
    while m0 > 0 {
        m0 = m0 - 1;
        g0 = m0;
        call cell_of;
        m2 = R;
        if m2 != HANDLE_NONE {
            if (arena_q(m2 + C_TYPE) & KIND_MASK) != KIND_DEAD {
                m3 = arena_q(m2 + C_PARENT);
                if m3 < KID_MAX {
                    store32(work + W_KNEXT + (m0 << 2), load32(work + W_KHEAD + (m3 << 2)));
                    store32(work + W_KHEAD + (m3 << 2), m0);
                }
            }
        }
    }
    ret;
}

# ---- the value of a field of an object ----------------------------------------------------------
# g0: the handle of the object. g1: the handle of the Field that names the value.
# R: the value -- the target handle when the field is a reference, else the number it holds. The
# Field carries the byte offset in the payload and, for a reference, the flag that says so; a
# scalar takes the size of its value type.
proc read_value {
    v0 = g0;                              # the object
    v1 = g1;                              # the Field
    g0 = v0;
    call cell_of;
    v2 = R;                               # the object cell
    g0 = v1;
    call cell_of;
    v3 = R;                               # the Field cell
    v4 = arena_q(v3 + CELL_BYTES + F_OFFSET);   # the byte offset in the owner payload
    v5 = arena_q(v3 + CELL_BYTES + F_FLAGS) & 0xFFFFFFFF;
    if (v5 & FIELD_REF) != 0 {
        R = arena_q(v2 + CELL_BYTES + v4);   # a reference: the target handle
        ret;
    }
    v6 = arena_q(v3 + CELL_BYTES + F_VALUE_TYPE);   # the type of the value
    g0 = v6;
    call cell_of;
    v7 = R;
    v8 = arena_q(v7 + CELL_BYTES + T_SIZE);   # its size
    v9 = arena_q(v2 + CELL_BYTES + v4);   # the raw bytes, read whole and masked
    if v8 < 8 {
        v10 = (1 << (v8 << 3)) - 1;
        R = v9 & v10;
    } else {
        R = v9;
    }
    ret;
}
