# The numbers of the HMAC-BLAKE2s kernel: the layout its buffers add to the work region and
# the byte of xor. Included before the program's entry; the procs are
# hmac_blake2s_kernel.rxfs, after it. The map of the hash is blake2s_words.rxfs; the glue
# sits past its stack (WKEY of that map is the keyed block of BLAKE2s itself, so the padded
# key of HMAC gets the name WKPAD).

include "blake2s_words.rxfs";

#   WIPAD   64   the inner block K' ^ ipad
#   WOPAD   64   the outer block K' ^ opad
#   WINNER  32   the inner digest
#   WKPAD   64   the padded key K'

const WIPAD = 768;
const WOPAD = 832;
const WINNER = 896;
const WKPAD = 928;

# one byte of xor: (a | b) - (a & b) is a ^ b for bytes; the language has no ^ operator
fn xor8_(a, b) = (((((a) | (b)) & 0xFF) - (((a) & (b)) & 0xFF)) & 0xFF);
