# The HMAC-BLAKE2s-256 of a message (the RFC 2104 construction over BLAKE2s-256 of RFC 7693;
# no RFC names this instantiation, so the vectors are pinned from the standard library's own
# hmac over blake2s, and the key of hkdf_blake2s rides on these words). The kernel is
# hmac_blake2s_words.rxfs and hmac_blake2s_kernel.rxfs; this file is the program around it.
#
# It takes whole words: the key (key, key_len), the message (msg, msg_len), where the 32-byte
# tag lands (out), and a work region of at least 1280 bytes (work). It answers 0.

include "hmac_blake2s_words.rxfs";

program hmac_blake2s(key, key_len, msg, msg_len, out, work) {
    var sp;
    var k0, k1, k2, k3, k4;
    var c0, c1, c2;
    var v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15;
    var u0, u1, u2, u3;
    var f0, f1, f2;
    var m0, m1, m2, m3, m4, m5;

    sp = work + WSTACK;

    m0 = key;
    m1 = key_len;
    call hmac_key;
    call hmac_begin;
    m2 = msg;
    m3 = msg_len;
    call hmac_update;
    m4 = out;
    call hmac_end;
    return 0;
}

include "hmac_blake2s_kernel.rxfs";
