# The SHA-256 kernel of the crypto words: the one source of the hash, shared by the programs
# that hash (sha256, hmac_kernel, and what comes after). It is `.rxfs` (tools/native/rxfc.py);
# the frame contract is the one of native/compose/hash.rxfs: the procs take their scratch from
# the frame of the run, so the entry of every program that includes this file declares:
#
#   k0, k1, k2            the kernel's interface: bytes/length in, where the digest lands
#   c0 .. c13             the scratch of sha256_compress
#   u0 .. u3              the scratch of sha256_update
#   f0 .. f2              the scratch of sha256_final
#   sp                    the stack of the ways back, at work + WSTACK
#
# The numbers are sha256_words.rxfs (the work layout and the arithmetic), which the program
# includes before its entry. The procs, in the order a caller uses them: sha256_init,
# sha256_update (a piece of the message, as often as it comes), sha256_final (where the
# 32-byte digest lands).

# ---- the constants of the round (SHA-256 K[0..63]), two to a word -------------------------------
proc sha256_k_init {
    store64(work + WK +   0, 0x428a2f9871374491);   # K[0], K[1]
    store64(work + WK +   8, 0xb5c0fbcfe9b5dba5);   # K[2], K[3]
    store64(work + WK +  16, 0x3956c25b59f111f1);   # K[4], K[5]
    store64(work + WK +  24, 0x923f82a4ab1c5ed5);   # K[6], K[7]
    store64(work + WK +  32, 0xd807aa9812835b01);   # K[8], K[9]
    store64(work + WK +  40, 0x243185be550c7dc3);   # K[10], K[11]
    store64(work + WK +  48, 0x72be5d7480deb1fe);   # K[12], K[13]
    store64(work + WK +  56, 0x9bdc06a7c19bf174);   # K[14], K[15]
    store64(work + WK +  64, 0xe49b69c1efbe4786);   # K[16], K[17]
    store64(work + WK +  72, 0x0fc19dc6240ca1cc);   # K[18], K[19]
    store64(work + WK +  80, 0x2de92c6f4a7484aa);   # K[20], K[21]
    store64(work + WK +  88, 0x5cb0a9dc76f988da);   # K[22], K[23]
    store64(work + WK +  96, 0x983e5152a831c66d);   # K[24], K[25]
    store64(work + WK + 104, 0xb00327c8bf597fc7);   # K[26], K[27]
    store64(work + WK + 112, 0xc6e00bf3d5a79147);   # K[28], K[29]
    store64(work + WK + 120, 0x06ca635114292967);   # K[30], K[31]
    store64(work + WK + 128, 0x27b70a852e1b2138);   # K[32], K[33]
    store64(work + WK + 136, 0x4d2c6dfc53380d13);   # K[34], K[35]
    store64(work + WK + 144, 0x650a7354766a0abb);   # K[36], K[37]
    store64(work + WK + 152, 0x81c2c92e92722c85);   # K[38], K[39]
    store64(work + WK + 160, 0xa2bfe8a1a81a664b);   # K[40], K[41]
    store64(work + WK + 168, 0xc24b8b70c76c51a3);   # K[42], K[43]
    store64(work + WK + 176, 0xd192e819d6990624);   # K[44], K[45]
    store64(work + WK + 184, 0xf40e3585106aa070);   # K[46], K[47]
    store64(work + WK + 192, 0x19a4c1161e376c08);   # K[48], K[49]
    store64(work + WK + 200, 0x2748774c34b0bcb5);   # K[50], K[51]
    store64(work + WK + 208, 0x391c0cb34ed8aa4a);   # K[52], K[53]
    store64(work + WK + 216, 0x5b9cca4f682e6ff3);   # K[54], K[55]
    store64(work + WK + 224, 0x748f82ee78a5636f);   # K[56], K[57]
    store64(work + WK + 232, 0x84c878148cc70208);   # K[58], K[59]
    store64(work + WK + 240, 0x90befffaa4506ceb);   # K[60], K[61]
    store64(work + WK + 248, 0xbef9a3f7c67178f2);   # K[62], K[63]
    ret;
}

# ---- the compression of the block at WPART ------------------------------------------------------
proc sha256_compress {
    # the schedule W[0..15] from the block: word i is four bytes big-endian
    c0 = 0;
    while c0 < 16 {
        c1 = work + WPART + (c0 << 2);
        c2 = ((load8(c1) & 0xFF) << 24) | ((load8(c1 + 1) & 0xFF) << 16) | ((load8(c1 + 2) & 0xFF) << 8) | (load8(c1 + 3) & 0xFF);
        store64(work + WRING + (c0 << 3), c2);
        c0 = c0 + 1;
    }
    # a..h start as the state
    c0 = 0;
    while c0 < 8 {
        store64(work + WWORK + (c0 << 3), load64(work + WSTATE + (c0 << 3)));
        c0 = c0 + 1;
    }
    # the 64 rounds
    c0 = 0;
    while c0 < 64 {
        if c0 >= 16 {
            # W[i] = s1(W[i-2]) + W[i-7] + s0(W[i-15]) + W[i-16], into the ring
            c4 = load64(work + WRING + (((c0 - 2) & 15) << 3));
            c5 = load64(work + WRING + (((c0 - 7) & 15) << 3));
            c6 = load64(work + WRING + (((c0 - 15) & 15) << 3));
            c7 = load64(work + WRING + (((c0 - 16) & 15) << 3));
            c2 = add32_(add32_(add32_(s1_(c4), c5), s0_(c6)), c7);
            store64(work + WRING + ((c0 & 15) << 3), c2);
        } else {
            c2 = load64(work + WRING + (c0 << 3));
        }
        # K[i], two to a word: the high half when i is even
        c3 = load64(work + WK + ((c0 >> 1) << 3));
        if (c0 & 1) == 0 {
            c3 = (c3 >> 32) & 0xFFFFFFFF;
        } else {
            c3 = u32_(c3);
        }
        # a..h
        c4 = load64(work + WWORK +  0);
        c5 = load64(work + WWORK +  8);
        c6 = load64(work + WWORK + 16);
        c7 = load64(work + WWORK + 24);
        c8 = load64(work + WWORK + 32);
        c9 = load64(work + WWORK + 40);
        c10 = load64(work + WWORK + 48);
        c11 = load64(work + WWORK + 56);
        # t1 = h + S1(e) + ch(e,f,g) + K[i] + W[i]; t2 = S0(a) + maj(a,b,c)
        c12 = add32_(add32_(add32_(add32_(c11, S1_(c8)), ch_(c8, c9, c10)), c3), c2);
        c13 = add32_(S0_(c4), maj_(c4, c5, c6));
        store64(work + WWORK +  0, add32_(c12, c13));
        store64(work + WWORK +  8, c4);
        store64(work + WWORK + 16, c5);
        store64(work + WWORK + 24, c6);
        store64(work + WWORK + 32, add32_(c7, c12));
        store64(work + WWORK + 40, c8);
        store64(work + WWORK + 48, c9);
        store64(work + WWORK + 56, c10);
        c0 = c0 + 1;
    }
    # fold the working words into the state
    c0 = 0;
    while c0 < 8 {
        store64(work + WSTATE + (c0 << 3),
            add32_(load64(work + WSTATE + (c0 << 3)), load64(work + WWORK + (c0 << 3))));
        c0 = c0 + 1;
    }
    ret;
}

# ---- the state of a new message -----------------------------------------------------------------
proc sha256_init {
    call sha256_k_init;
    store64(work + WSTATE +  0, 0x6a09e667);
    store64(work + WSTATE +  8, 0xbb67ae85);
    store64(work + WSTATE + 16, 0x3c6ef372);
    store64(work + WSTATE + 24, 0xa54ff53a);
    store64(work + WSTATE + 32, 0x510e527f);
    store64(work + WSTATE + 40, 0x9b05688c);
    store64(work + WSTATE + 48, 0x1f83d9ab);
    store64(work + WSTATE + 56, 0x5be0cd19);
    store64(work + WBOOK, 0);          # partlen
    store64(work + WBOOK + 8, 0);      # the total bytes
    ret;
}

# ---- a piece of the message --------------------------------------------------------------------
proc sha256_update {
    # k0 = the bytes, k1 = their length
    u0 = k0;
    u1 = k1;
    u2 = load64(work + WBOOK);         # partlen
    while u1 > 0 {
        u3 = 64 - u2;
        if u3 > u1 {
            u3 = u1;
        }
        copy(work + WPART + u2, u0, u3);
        u2 = u2 + u3;
        u0 = u0 + u3;
        u1 = u1 - u3;
        if u2 == 64 {
            call sha256_compress;
            u2 = 0;
        }
    }
    store64(work + WBOOK, u2);
    store64(work + WBOOK + 8, load64(work + WBOOK + 8) + k1);
    ret;
}

# ---- the padding and the digest -----------------------------------------------------------------
proc sha256_final {
    # k0 = where the 32-byte digest lands
    f0 = load64(work + WBOOK);         # partlen
    f1 = load64(work + WBOOK + 8) << 3;    # the length of the message in bits
    store8(work + WPART + f0, 0x80);
    f0 = f0 + 1;
    if f0 > 56 {
        fill(work + WPART + f0, 0, 64 - f0);
        call sha256_compress;
        fill(work + WPART, 0, 56);
    } else {
        fill(work + WPART + f0, 0, 56 - f0);
    }
    store32(work + WPART + 56, bswap32_(f1 >> 32));
    store32(work + WPART + 60, bswap32_(u32_(f1)));
    call sha256_compress;
    f2 = 0;
    while f2 < 8 {
        store32(k0 + (f2 << 2), bswap32_(u32_(load64(work + WSTATE + (f2 << 3)))));
        f2 = f2 + 1;
    }
    ret;
}
