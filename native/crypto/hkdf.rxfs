# HKDF (RFC 5869) over HMAC-SHA-256: the two faces of the derivation, extract and expand,
# as one program over the words hmac_kernel.rxfs and the one derivation of hkdf_kernel.rxfs.
# The BLAKE2s flavor is hkdf_blake2s.rxfs, the same faces over the other hash -- both are
# what the module's two entries pm_crypto_hkdf_extract and pm_crypto_hkdf_expand mean.
#
# The faces (the same two the C face has in pm_crypto.h):
#
#   FACE_EXTRACT  1   PRK = HMAC(salt, IKM) (RFC 5869, 2.2): salt, salt_len is the salt,
#                     ikm, ikm_len the input keying material, and out takes the 32-byte PRK
#   FACE_EXPAND   2   the first out_len bytes of T(1) || T(2) || ... (RFC 5869, 2.3): prk is
#                     the 32-byte key, info, info_len the context, out takes out_len bytes
#                     (at most 255 * 32 = 8160, what one byte of counter can count)
#
# Each face takes what it needs: extract reads salt and ikm, expand reads prk and info. The
# work region is at least 1280 bytes (work). It answers 0.

include "hmac_words.rxfs";

const FACE_EXTRACT = 1;
const FACE_EXPAND = 2;

const WZERO = 864;
const WPRK = 896;
const WTPREV = 928;
const WTCUR = 960;
const WCOUNT = 992;

program hkdf(op, salt, salt_len, ikm, ikm_len, prk, info, info_len, out, out_len, work) {
    var sp;
    var k0, k1, k2;
    var c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13;
    var u0, u1, u2, u3;
    var f0, f1, f2;
    var m0, m1, m2, m3, m4, m5;
    var n0, n1, n2, n3, n4, n5, n6;

    sp = work + WSTACK;

    if op == FACE_EXTRACT {
        m0 = salt;
        m1 = salt_len;
        m2 = ikm;
        m3 = ikm_len;
        m4 = out;
        call hkdf_extract;
        return 0;
    }
    if op == FACE_EXPAND {
        if out_len > 8160 {
            refuse RXF_REFUSE_UNSUPPORTED;
        }
        m0 = prk;
        m1 = info;
        m2 = info_len;
        m3 = out;
        m4 = out_len;
        call hkdf_expand;
        return 0;
    }
    refuse RXF_REFUSE_UNSUPPORTED;
}

include "hmac_kernel.rxfs";
include "hkdf_kernel.rxfs";
