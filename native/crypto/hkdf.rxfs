# The HKDF of RFC 5869 over the HMAC-SHA-256 of hmac_kernel.rxfs: a pseudorandom key from
# input keying material (extract), and as much output keying material as asked for (expand).
#
# It takes whole words: the salt (salt, salt_len) -- an empty salt is the hash length of
# zeroes, the input keying material (ikm, ikm_len), the info (info, info_len), where the
# output lands (out) and how much of it is wanted (out_len, at most 255 * 32), and a work
# region of at least 1280 bytes (work). It answers 0, and refuses an out_len past what the
# counter of the expansion can reach.
#
# The buffers this program adds to the work region:
#
#   WZERO  32   the salt of zeroes
#   WPRK   32   the pseudorandom key
#   WTPREV 32   T(i-1) of the expansion
#   WTCUR  32   T(i)
#   WCOUNT  1   the counter i

include "hmac_words.rxfs";

const WZERO = 864;
const WPRK = 896;
const WTPREV = 928;
const WTCUR = 960;
const WCOUNT = 992;

program hkdf(salt, salt_len, ikm, ikm_len, info, info_len, out, out_len, work) {
    var sp;
    var k0, k1, k2;
    var c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13;
    var u0, u1, u2, u3;
    var f0, f1, f2;
    var m0, m1, m2, m3, m4, m5;
    var n0, n1, n2, n3, n4;

    sp = work + WSTACK;

    if out_len > 8160 {
        refuse RXF_REFUSE_UNSUPPORTED;
    }

    # ---- extract: PRK = HMAC(salt, IKM) ---------------------------------------------------------
    n3 = salt;
    n4 = salt_len;
    if salt_len == 0 {
        fill(work + WZERO, 0, 32);
        n3 = work + WZERO;
        n4 = 32;
    }
    m0 = n3;
    m1 = n4;
    call hmac_key;
    call hmac_begin;
    m2 = ikm;
    m3 = ikm_len;
    call hmac_update;
    m4 = work + WPRK;
    call hmac_end;

    # ---- expand: T(i) = HMAC(PRK, T(i-1) || info || i) ------------------------------------------
    n0 = 0;                         # how many bytes of the output are made
    n1 = 1;                         # the counter i
    while n0 < out_len {
        store8(work + WCOUNT, n1);
        m0 = work + WPRK;
        m1 = 32;
        call hmac_key;
        call hmac_begin;
        if n1 > 1 {
            m2 = work + WTPREV;
            m3 = 32;
            call hmac_update;
        }
        if info_len > 0 {
            m2 = info;
            m3 = info_len;
            call hmac_update;
        }
        m2 = work + WCOUNT;
        m3 = 1;
        call hmac_update;
        m4 = work + WTCUR;
        call hmac_end;
        # the bytes of T(i) join the output; T(i) is the T(i-1) of the next round
        n2 = 32;
        if n2 > out_len - n0 {
            n2 = out_len - n0;
        }
        copy(out + n0, work + WTCUR, n2);
        n0 = n0 + n2;
        copy(work + WTPREV, work + WTCUR, 32);
        n1 = n1 + 1;
    }
    return 0;
}

include "hmac_kernel.rxfs";
