# The SHA-256 of a message (FIPS 180-4): the first primitive of the crypto words of the image.
#
# This is the defining source of the card's SHA-256. The words are the program every machine
# runs (native/graph.h) -- the interpreter, and the in-image compiler of docs/18. The Rust tree
# of src/ is retired: the suite of native/crypto/ is written here and its vectors pass through
# these words (test_crypto_rxfs.py).
#
# The kernel is sha256_words.rxfs (the numbers) and sha256_kernel.rxfs (the procs) -- the one
# source of the compression. This file is the program around it. It takes whole words: the
# message (data, len), where the 32-byte digest lands (out), and a work region of at least
# 1280 bytes (work). It answers 0.

include "sha256_words.rxfs";

program sha256(data, len, out, work) {
    var sp;
    var k0, k1, k2;
    var c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13;
    var u0, u1, u2, u3;
    var f0, f1, f2;

    sp = work + WSTACK;

    call sha256_init;
    k0 = data;
    k1 = len;
    call sha256_update;
    k0 = out;
    call sha256_final;
    return 0;
}

include "sha256_kernel.rxfs";
