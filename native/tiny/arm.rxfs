# The backend of aarch64: the code of native/compile.c, instruction by instruction.
#
# x0..x5 carry the arguments; x19 is the context, x20 the frame, x21 the output; x9, x10, x11 and x16
# are scratch (x11 holds the value that an `if` looks at). Every instruction is one little-endian
# word.

const X9 = 9;
const X10 = 10;
const X11 = 11;
const X16 = 16;
const X19 = 19;
const X20 = 20;
const X21 = 21;
const XZR = 31;

macro a_imm(reg_, value_) { g0 = reg_; g1 = value_; call a_imm; }
macro a_load(size_, reg_, base_, disp_) { g0 = size_; g1 = reg_; g2 = base_; g3 = disp_; call a_load; }
macro a_store(size_, reg_, base_, disp_) { g0 = size_; g1 = reg_; g2 = base_; g3 = disp_; call a_store; }
macro a_mov(dst_, src_) { bytes(0xAA0003E0 | ((src_) << 16) | (dst_), 4); }
macro a_add(dst_, base_, imm_) { bytes(0x91000000 | ((imm_) << 10) | ((base_) << 5) | (dst_), 4); }
macro a_copy(dbase_, dst_, sbase_, src_, count_) {
    g0 = dbase_; g1 = dst_; g2 = sbase_; g3 = src_; g4 = count_; call a_copy;
}
macro a_zero(base_, disp_, count_) { g0 = base_; g1 = disp_; g2 = count_; call a_zero; }
macro a_value(reg_, wide_) { g0 = reg_; g1 = wide_; call a_value; }

# the register g0 gets the value g1, in one to four pieces of sixteen bits
proc a_imm {
    m0 = g0;
    m1 = g1;
    bytes(0xD2800000 | ((m1 & 0xFFFF) << 5) | m0, 4);
    m2 = 1;
    while m2 < 4 {
        m3 = (m1 >> (m2 << 4)) & 0xFFFF;
        if m3 != 0 {
            bytes(0xF2800000 | (m2 << 21) | (m3 << 5) | m0, 4);
        }
        m2 = m2 + 1;
    }
}

# ldr of g0 bytes into the register g1 from [g2 + g3]
proc a_load {
    m0 = g0;
    m3 = g3;
    if m0 == 8 {
        m3 = 0xF9400000 | ((m3 >> 3) << 10);
    } else if m0 == 4 {
        m3 = 0xB9400000 | ((m3 >> 2) << 10);
    } else if m0 == 2 {
        m3 = 0x79400000 | ((m3 >> 1) << 10);
    } else {
        m3 = 0x39400000 | (m3 << 10);
    }
    bytes(m3 | (g2 << 5) | g1, 4);
}

proc a_store {
    m0 = g0;
    m3 = g3;
    if m0 == 8 {
        m3 = 0xF9000000 | ((m3 >> 3) << 10);
    } else if m0 == 4 {
        m3 = 0xB9000000 | ((m3 >> 2) << 10);
    } else if m0 == 2 {
        m3 = 0x79000000 | ((m3 >> 1) << 10);
    } else {
        m3 = 0x39000000 | (m3 << 10);
    }
    bytes(m3 | (g2 << 5) | g1, 4);
}

proc a_copy {
    n0 = g0;
    n1 = g1;
    n2 = g2;
    n3 = g3;
    n4 = g4;
    n5 = 0;
    while n5 < n4 {
        pick(n4 - n5, n1 + n5, n3 + n5);
        n6 = R;
        a_load(n6, X9, n2, n3 + n5);
        a_store(n6, X9, n0, n1 + n5);
        n5 = n5 + n6;
    }
}

proc a_zero {
    n0 = g0;
    n1 = g1;
    n2 = g2;
    n3 = 0;
    while n3 < n2 {
        pick(n2 - n3, n1 + n3, 0);
        n4 = R;
        a_store(n4, XZR, n0, n1 + n3);
        n3 = n3 + n4;
    }
}

# add sp, sp, alloc; ldr x21; ldp x19, x20; ldp x29, x30; ret
proc a_epilogue {
    bytes(0x910003FF | (alloc << 10), 4);
    bytes(0xF94013F5, 4);
    bytes(0xA94153F3, 4);
    bytes(0xA8C37BFD, 4);
    bytes(0xD65F03C0, 4);
}

# the value of the operand (ok, oa, ob) in the register g0, by address when it is wide and g1 is 1
proc a_value {
    n0 = g0;
    n1 = g1;
    if ok == LITERAL {
        a_imm(n0, oa);
    } else if ok == OBJECT {
        call object_address;
        a_imm(n0, R);
    } else if (n1 != 0) & (ob > 8) {
        a_add(n0, X20, oa);
    } else {
        n2 = ob;
        if ob >= 8 { n2 = 8; }
        a_load(n2, n0, X20, oa);
    }
}

proc a_begin {
    q0 = g0;
    alloc = FRAME_ALLOC;
    bytes(0xA9BD7BFD, 4);
    bytes(0xA90153F3, 4);
    bytes(0xF90013F5, 4);
    bytes(0xD10003FF | (alloc << 10), 4);
    a_add(X20, 31, 0);
    a_mov(X19, 0);
    a_mov(X21, 3);
    bytes(0xF100001F | (q0 << 10) | (2 << 5), 4);
    q1 = size;
    bytes(0x54000000, 4);
    bytes(0x528000C0, 4);
    call a_epilogue;
    if (q1 + 4) <= cap {
        g0 = q1;
        g1 = 0x54000000 | (((size - q1) >> 2) << 5);
        call patch32;
    }
    a_zero(X20, 0, frame);
}

proc a_param {
    q0 = g0;
    q1 = g1;
    q2 = g2;
    a_copy(X20, q0, 1, q2, q1);
}

proc a_move {
    q0 = g0;
    q1 = g1;
    q2 = g2;
    a_zero(X20, q0, q1);
    if ok == SLOT {
        a_copy(X20, q0, X20, oa, q2);
    } else if ok == OBJECT {
        call object_address;
        a_imm(X10, R);
        a_copy(X20, q0, X10, 0, q2);
    } else {
        q3 = 0;
        while q3 < q2 {
            pick(q2 - q3, q0 + q3, 0);
            q4 = R;
            q5 = oa >> (q3 << 3);
            if q4 == 8 {
                a_imm(X9, q5);
            } else {
                a_imm(X9, q5 & ((1 << (q4 << 3)) - 1));
            }
            a_store(q4, X9, X20, q0 + q3);
            q3 = q3 + q4;
        }
    }
}

# One argument of a call, in the register g0: `which` (g1) of the plan, of the letter g2.
proc a_argument {
    q5 = g0;
    q6 = g1;
    q7 = g2;
    if q6 == ARG_CONTEXT {
        a_mov(q5, X19);
    } else if q6 == ARG_OUT {
        a_add(q5, X20, cos);
    } else if q6 == ARG_STAGE {
        a_add(q5, X20, STAGE_AT);
    } else {
        soperand(q6);
        if (q7 == T_BYTE) & (ok == LITERAL) {
            a_imm(q5, oa & 255);
        } else {
            a_value(q5, 1);
        }
    }
}

# A handle goes by address of a copy that the callee may change: the copy is in the frame, the
# register g0, the number of the copy g1. The operand is at (ok, oa).
proc a_handle {
    q5 = g0;
    q6 = HANDLES_AT + (g1 << 4) + (g1 << 3);
    if ok == OBJECT {
        call object_address;
        a_imm(X10, R);
        a_copy(X20, q6, X10, 0, HANDLE_BYTES);
    } else {
        a_copy(X20, q6, X20, oa, HANDLE_BYTES);
    }
    a_add(q5, X20, q6);
}

proc a_call {
    q0 = 0;
    q1 = 0;
    while q1 < pn {
        q2 = load64(planarg + (q1 << 3));
        q3 = load8(plantype + q1);
        if q3 == T_HANDLE {
            soperand(q2);
            g0 = q1;
            g1 = q0;
            call a_handle;
            q0 = q0 + 1;
        } else {
            g0 = q1;
            g1 = q2;
            g2 = q3;
            call a_argument;
        }
        q1 = q1 + 1;
    }
    if hasout != 0 {
        a_zero(X20, cos, cow);
    }
    a_imm(X16, function);
    bytes(0xD63F0000 | (X16 << 5), 4);
    if css == UNCAUGHT {
        q5 = size;
        bytes(0xB4000000, 4);   # cbz x0, past the answer, the distance patched below
        call a_epilogue;
        g0 = q5;
        g1 = 0xB4000000 | ((((size - q5) >> 2) << 5));
        call patch32;
    } else if css != NONE {
        a_store(4, 0, X20, css);
    }
}

proc a_return {
    q0 = g0;
    if q0 > 8 {
        if ok == OBJECT {
            call object_address;
            a_imm(X10, R);
            a_copy(X21, 0, X10, 0, q0);
        } else {
            a_copy(X21, 0, X20, oa, q0);
        }
    } else {
        a_value(X9, 0);
        a_store(8, X9, X21, 0);
    }
    bytes(0x2A1F03E0, 4);
    call a_epilogue;
}

proc a_refuse {
    a_value(0, 0);
    call a_epilogue;
}

proc a_set_value {
    a_value(X11, 0);
}

# cbnz skips the code when the value is not zero, cbz when it is. R is the place to patch.
proc a_if_zero {
    q0 = g0;
    R = size;
    if q0 != 0 {
        bytes(0xB5000000 | X11, 4);
    } else {
        bytes(0xB4000000 | X11, 4);
    }
}

proc a_if_tag {
    q0 = g0;
    a_imm(X10, q0);
    bytes(0xEB0A017F, 4);
    R = size;
    bytes(0x54000001, 4);
}

# the branch at g0 skips to here: its word gets the number of words
proc a_if_end {
    q0 = g0;
    if write != 0 {
        if (q0 + 4) <= cap {
            q1 = load32(buf + q0);
            g0 = q0;
            g1 = q1 | (((size - q0) >> 2) << 5);
            call patch32;
        }
    }
}

# b to the start of instruction g0
proc a_jump {
    q0 = g0;
    bytes(0x14000000 | (((load32(offset + (q0 << 2)) - size) >> 2) & 0x03FFFFFF), 4);
}

# The safe point of an edge that goes back (native/safe.c).
proc a_safe_point {
    a_mov(0, X19);
    a_imm(1, area);
    a_imm(X16, safe);
    bytes(0xD63F0000 | (X16 << 5), 4);
    q0 = size;
    bytes(0x34000000, 4);
    call a_epilogue;
    g0 = q0;
    g1 = 0x34000000 | (((size - q0) >> 2) << 5);
    call patch32;
}

proc a_tail {
    bytes(0x528000C0, 4);
    call a_epilogue;
}

# the slot g0, g1 wide, zero
proc a_zero_slot {
    q0 = g0;
    q1 = g1;
    a_zero(X20, q0, q1);
}

# g2 bytes of the frame, from the slot g1 to the slot g0
proc a_slot_copy {
    q0 = g0;
    q1 = g1;
    q2 = g2;
    a_copy(X20, q0, X20, q1, q2);
}

# the value of the operand in x9 (g0 is 0) or x10
proc a_less_value {
    q0 = g0;
    if q0 == 0 { a_value(X9, 0); } else { a_value(X10, 0); }
}

# cmp x9, x10; cset w9, lo; into the byte g0
proc a_less_end {
    q0 = g0;
    bytes(0xEB0A013F, 4);
    bytes(0x1A9F27E9, 4);
    a_store(1, X9, X20, q0);
}

# the slot g0 of g1 bytes = the operand + 1
proc a_increment {
    q0 = g0;
    q1 = g1;
    a_value(X9, 0);
    a_add(X9, X9, 1);
    if q1 >= 8 { q1 = 8; }
    a_store(q1, X9, X20, q0);
}
