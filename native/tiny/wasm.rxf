# The backend of wasm32: the code of native/compile.c, instruction by instruction.
#
# The body of a function (i32 context, i32 args, i64 argc, i32 out) -> i32 with locals: 4 the frame,
# 5 a temporary, 6 the next instruction (i32), 7 the value an `if` looks at (i64). The frame is taken
# from global 0, the stack pointer of the module convention. The type of a call_indirect is the one
# of the leaf: its id less one. wasm32 has no jump: the code is a loop over a table jump (`br_table`)
# to the block of the next instruction.

const W_FRAME = 4;
const W_TEMP = 5;
const W_NEXT = 6;
const W_VALUE = 7;
const W_ABSOLUTE = 255;     # the base of a load from an address that is known: the instruction carries it

macro w_uleb(value_) { g0 = value_; call w_uleb; }
macro w_sleb(value_) { g0 = value_; call w_sleb; }
macro w_get(local_) { byte(0x20); w_uleb(local_); }
macro w_i32(value_) { g0 = value_; call w_i32; }
macro w_i64(value_) { g0 = value_; call w_i64; }
macro w_mem(opcode_, offset_) { byte(opcode_); byte(0); w_uleb(offset_); }
macro w_load(size_, wide_, base_, disp_) { g0 = size_; g1 = wide_; g2 = base_; g3 = disp_; call w_load; }
macro w_copy(dbase_, dst_, sbase_, src_, count_) {
    g0 = dbase_; g1 = dst_; g2 = sbase_; g3 = src_; g4 = count_; call w_copy;
}
macro w_zero(base_, disp_, count_) { g0 = base_; g1 = disp_; g2 = count_; call w_zero; }
macro w_value(wide_) { g0 = wide_; call w_value; }
# the store of 8, 4, 2 or 1 bytes
fn all_if(c) = (0 - (c));
fn w_store_op(size_) = ((all_if((size_) == 8) & 0x37) | (all_if((size_) == 4) & 0x36) | (all_if((size_) == 2) & 0x3B) | (all_if((size_) == 1) & 0x3A));
# the size of the next piece of a copy, by what is left
fn w_piece(left_) = ((all_if((left_) >= 8) & 8) | (all_if(((left_) >= 4) & ((left_) < 8)) & 4) | (all_if(((left_) >= 2) & ((left_) < 4)) & 2) | (all_if((left_) == 1) & 1));

proc w_uleb {
    u0 = g0;
    u1 = 1;
    while u1 != 0 {
        u1 = u0 & 127;
        u0 = u0 >> 7;
        if u0 != 0 { u1 = u1 | 128; }
        A = u1;
        call put;
        u1 = u0;
    }
}

# the value as a signed 64-bit number
proc w_sleb {
    u0 = g0;
    u1 = 1;
    while u1 != 0 {
        u1 = u0 & 127;
        # arithmetic shift: the sign is kept
        if (u0 >> 63) != 0 {
            u0 = (u0 >> 7) | 0xFE00000000000000;
        } else {
            u0 = u0 >> 7;
        }
        if ((u0 == 0) & ((u1 & 64) == 0)) | ((u0 == 0xFFFFFFFFFFFFFFFF) & ((u1 & 64) != 0)) {
            A = u1;
            call put;
            ret;
        }
        A = u1 | 128;
        call put;
        u1 = 1;
    }
}

# i32.const of the 32 bits of g0, as a signed number
proc w_i32 {
    m0 = g0 & 0xFFFFFFFF;
    if (m0 & 0x80000000) != 0 { m0 = m0 | 0xFFFFFFFF00000000; }
    byte(0x41);
    w_sleb(m0);
}

proc w_i64 {
    m0 = g0;
    byte(0x42);
    w_sleb(m0);
}

# load of g0 bytes, zero-extended to i32 (to i64 when g1) from [local g2 + g3]
proc w_load {
    m0 = g0;
    m1 = g1;
    m2 = g2;
    m3 = g3;
    if m2 == W_ABSOLUTE {
        # i32.const 0 (not w_i32: that keeps its own value in m0)
        byte(0x41);
        byte(0);
    } else {
        w_get(m2);
    }
    if m1 != 0 {
        if m0 == 8 {
            w_mem(0x29, m3);
        } else if m0 == 4 {
            w_mem(0x35, m3);
        } else if m0 == 2 {
            w_mem(0x33, m3);
        } else {
            w_mem(0x31, m3);
        }
    } else {
        if m0 == 4 {
            w_mem(0x28, m3);
        } else if m0 == 2 {
            w_mem(0x2F, m3);
        } else {
            w_mem(0x2D, m3);
        }
    }
}

proc w_copy {
    n0 = g0;
    n1 = g1;
    n2 = g2;
    n3 = g3;
    n4 = g4;
    n5 = 0;
    while n5 < n4 {
        n6 = w_piece(n4 - n5);
        w_get(n0);
        w_load(n6, n6 == 8, n2, n3 + n5);
        w_mem(w_store_op(n6), n1 + n5);
        n5 = n5 + n6;
    }
}

proc w_zero {
    n0 = g0;
    n1 = g1;
    n2 = g2;
    n3 = 0;
    while n3 < n2 {
        n4 = w_piece(n2 - n3);
        w_get(n0);
        if n4 == 8 { w_i64(0); } else { w_i32(0); }
        w_mem(w_store_op(n4), n1 + n3);
        n3 = n3 + n4;
    }
}

# restores the stack pointer; the stack of values is not touched
proc w_leave {
    w_get(W_FRAME);
    w_i32(alloc);
    byte(0x6A);
    byte(0x24);
    byte(0x00);
}

# the value of the operand (ok, oa, ob) as an i64 on the stack: by address when it is wide and g0 is 1
proc w_value {
    n0 = g0;
    if ok == LITERAL {
        w_i64(oa);
    } else if ok == OBJECT {
        call object_address;
        w_i64(R);
    } else if (n0 != 0) & (ob > 8) {
        w_get(W_FRAME);
        w_i32(oa);
        byte(0x6A);
        byte(0xAD);
    } else {
        n1 = ob;
        if ob >= 8 { n1 = 8; }
        w_load(n1, 1, W_FRAME, oa);
    }
}

proc w_begin {
    q0 = g0;
    alloc = FRAME_ALLOC;
    byte(2);
    byte(3);
    byte(0x7F);
    byte(1);
    byte(0x7E);
    byte(0x23);
    byte(0x00);
    w_i32(alloc);
    byte(0x6B);
    byte(0x22);
    w_uleb(W_FRAME);
    byte(0x24);
    byte(0x00);
    w_get(2);
    w_i64(q0);
    byte(0x52);
    byte(0x04);
    byte(0x40);
    w_i32(OUT_OF_RANGE);
    call w_leave;
    byte(0x0F);
    byte(0x0B);
    w_zero(W_FRAME, 0, frame);
}

proc w_param {
    q0 = g0;
    q1 = g1;
    q2 = g2;
    w_copy(W_FRAME, q0, 1, q2, q1);
}

proc w_move {
    q0 = g0;
    q1 = g1;
    q2 = g2;
    w_zero(W_FRAME, q0, q1);
    if ok == SLOT {
        w_copy(W_FRAME, q0, W_FRAME, oa, q2);
    } else if ok == OBJECT {
        call object_address;
        w_copy(W_FRAME, q0, W_ABSOLUTE, R, q2);
    } else {
        q3 = 0;
        while q3 < q2 {
            q4 = w_piece(q2 - q3);
            q5 = oa >> (q3 << 3);
            w_get(W_FRAME);
            if q4 == 8 {
                w_i64(q5);
            } else {
                w_i32(q5 & ((1 << (q4 << 3)) - 1));
            }
            w_mem(w_store_op(q4), q0 + q3);
            q3 = q3 + q4;
        }
    }
}

proc w_call {
    # a handle goes by address of a copy: the copies come first, in the frame
    q0 = 0;
    q1 = 0;
    while q1 < pn {
        if load8(plantype + q1) == T_HANDLE {
            operand(pc + 6 + triple(load64(planarg + (q1 << 3))));
            q2 = HANDLES_AT + (q0 << 4) + (q0 << 3);
            if ok == OBJECT {
                call object_address;
                w_copy(W_FRAME, q2, W_ABSOLUTE, R, HANDLE_BYTES);
            } else {
                w_copy(W_FRAME, q2, W_FRAME, oa, HANDLE_BYTES);
            }
            q0 = q0 + 1;
        }
        q1 = q1 + 1;
    }
    q0 = 0;
    q1 = 0;
    while q1 < pn {
        q2 = load64(planarg + (q1 << 3));
        q3 = load8(plantype + q1);
        if q3 == T_HANDLE {
            w_get(W_FRAME);
            w_i32(HANDLES_AT + (q0 << 4) + (q0 << 3));
            byte(0x6A);
            q0 = q0 + 1;
        } else if q2 == ARG_CONTEXT {
            w_get(0);
        } else if q2 == ARG_OUT {
            w_get(W_FRAME);
            w_i32(cos);
            byte(0x6A);
        } else {
            operand(pc + 6 + triple(q2));
            if (q3 == T_BYTE) & (ok == LITERAL) {
                w_i32(oa & 255);
            } else {
                w_value(1);
                if q3 != T_QUAD { byte(0xA7); }
            }
        }
        q1 = q1 + 1;
    }
    if hasout != 0 {
        w_zero(W_FRAME, cos, cow);
    }
    w_i32(function);
    byte(0x11);
    w_uleb(cl - 1);
    byte(0);
    if css != NONE {
        byte(0x21);
        w_uleb(W_TEMP);
        w_get(W_FRAME);
        w_get(W_TEMP);
        w_mem(0x36, css);
    } else {
        byte(0x1A);
    }
}

proc w_return {
    q0 = g0;
    if q0 > 8 {
        if ok == OBJECT {
            call object_address;
            w_copy(3, 0, W_ABSOLUTE, R, q0);
        } else {
            w_copy(3, 0, W_FRAME, oa, q0);
        }
    } else {
        w_get(3);
        w_value(0);
        w_mem(0x37, 0);
    }
    w_i32(0);
    call w_leave;
    byte(0x0F);
}

proc w_refuse {
    w_value(0);
    byte(0xA7);
    call w_leave;
    byte(0x0F);
}

# The value that the next `if` looks at.
proc w_set_value {
    w_value(0);
    byte(0x21);
    w_uleb(W_VALUE);
}

# The code up to the matching end runs only when the value is zero (g0 is 1) or not.
proc w_if_zero {
    q0 = g0;
    w_get(W_VALUE);
    byte(0x50);
    if q0 == 0 { byte(0x45); }
    byte(0x04);
    byte(0x40);
    nest = nest + 1;
    R = 0;
}

# ... only when the value is the tag g0
proc w_if_tag {
    q0 = g0;
    w_get(W_VALUE);
    w_i64(q0);
    byte(0x51);
    byte(0x04);
    byte(0x40);
    nest = nest + 1;
    R = 0;
}

proc w_if_else {
    byte(0x05);
}

proc w_if_end {
    byte(0x0B);
    nest = nest - 1;
}

proc w_if_else_end {
    byte(0x0B);
    nest = nest - 1;
}

# A loop around one block for each instruction; `br_table` on the next instruction goes to the end
# of its block, which is where its code is.
proc w_dispatch {
    byte(0x03);
    byte(0x40);
    q0 = 0;
    while q0 < ninstr {
        byte(0x02);
        byte(0x40);
        q0 = q0 + 1;
    }
    w_get(W_NEXT);
    byte(0x0E);
    w_uleb(ninstr);
    q0 = 0;
    while q0 < ninstr {
        w_uleb(q0);
        q0 = q0 + 1;
    }
    w_uleb(ninstr - 1);
}

# the end of the block of an instruction: its code follows
proc w_enter {
    byte(0x0B);
}

# the next instruction is g0: back to the loop
proc w_jump {
    q0 = g0;
    w_i32(q0);
    byte(0x21);
    w_uleb(W_NEXT);
    byte(0x0C);
    w_uleb(ninstr - 1 - current + nest);
}

# The safe point of an edge that goes back (native/safe.c).
proc w_safe_point {
    w_get(0);
    w_i32(area);
    w_i32(safe);
    byte(0x11);
    w_uleb(RXF_LEAF_SAFE_POINT - 1);
    byte(0);
    byte(0x21);
    w_uleb(W_TEMP);
    w_get(W_TEMP);
    byte(0x04);
    byte(0x40);
    w_get(W_TEMP);
    call w_leave;
    byte(0x0F);
    byte(0x0B);
}

# what is after the last instruction: the program ran off its end
proc w_tail {
    byte(0x0B);
    w_i32(OUT_OF_RANGE);
    call w_leave;
    byte(0x0F);
    byte(0x0B);
}

# the slot g0, g1 wide, zero
proc w_zero_slot {
    q0 = g0;
    q1 = g1;
    w_zero(W_FRAME, q0, q1);
}

# g2 bytes of the frame, from the slot g1 to the slot g0
proc w_slot_copy {
    q0 = g0;
    q1 = g1;
    q2 = g2;
    w_copy(W_FRAME, q0, W_FRAME, q1, q2);
}

# the address the byte is stored at, then the two values, then the comparison
proc w_less_begin {
    w_get(W_FRAME);
}

proc w_less_value {
    w_value(0);
}

# i64.lt_u, into the byte g0
proc w_less_end {
    q0 = g0;
    byte(0x54);
    w_mem(0x3A, q0);
}

# the slot g0 of g1 bytes = the operand + 1
proc w_increment {
    q0 = g0;
    q1 = g1;
    w_get(W_FRAME);
    w_value(0);
    w_i64(1);
    byte(0x7C);
    if q1 >= 8 {
        w_mem(0x37, q0);
    } else {
        byte(0xA7);
        w_mem(w_store_op(q1), q0);
    }
}
