# The compare words of the stdlib for the integer types: less/equal answer a u8 0/1,
# minimum/maximum answer the value itself. The operand specs carry each side's width and
# sign (a signed compare for the signed types); the float/double forms live in
# native/float/float.rxfs (the IEEE sign/mantissa logic they share is there).

fn less_int8_t(a, b) { return a < b; }
fn equal_int8_t(a, b) { return a == b; }
fn minimum_int8_t(a, b) { if (a < b) { return a; } return b; }
fn maximum_int8_t(a, b) { if (a > b) { return a; } return b; }
fn less_int16_t(a, b) { return a < b; }
fn equal_int16_t(a, b) { return a == b; }
fn minimum_int16_t(a, b) { if (a < b) { return a; } return b; }
fn maximum_int16_t(a, b) { if (a > b) { return a; } return b; }
