                        cs_generation = load64(ar_d + ar_opos + 24);
                        cs_index = load32(ar_d + ar_opos + 16);
                        cs_payload = load32(ar_d + ar_opos + 32);
                        cs_refs = load32(ar_d + ar_opos + 36);
                        callsub s_create();
