            callsub s_len(nm_r);
            cs_name_len = len_r;
            cs_flags = (load32(em_c + 40) & 0xFFFFC0FF) | (em_state << 8);
            cs_generation = load64(em_c + 24);
            cs_index = load32(em_c + 56);
