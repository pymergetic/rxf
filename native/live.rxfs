                                    callsub s_cell(rl_type);
                                    if (ce_r == 0) {
                                        rl_go = 0;
                                    }
                                }
                                if (rl_go == 1) {
                                    jb_reason = 12;
                                    callsub s_refs_of(rl_tix);
                                    if (ro_r == 0) {
                                        jb_reason = 12;
                                        rl_go = 0;
                                    }
                                }
                                if (rl_go == 1) {
                                    rl_prefix = load32(kpfx + 4 * rl_tix);
                                    if (rl_prefix > load32(rl_c + 20)) {
                                        jb_reason = 11;
                                        rl_go = 0;
                                    }
                                }
                                if (rl_go == 1) {
                                    jb_reason = 11;
                                    if (load8(rl_known + rl_tix) == 0) {
                                        callsub s_path_id(rl_type, rl_path);
                                        if (pi_r == 0) {                                            rl_go = 0;
                                        } else {
                                            store64(rl_type_ids + 8 * rl_tix, pi_id);
                                            store8(rl_known + rl_tix, 1);
                                        }
                                    }
                                }
                                if (rl_go == 1) {
                                    rl_named = 0;
                                    rl_id = 0;
                                    m_lit_semantic();
                                    callsub s_name_is(rl_type, 14);
                                    if (ni_r == 1) {
                                        m_lit_object_id();
                                        callsub s_child_named(rl_type, 9);
                                        rl_f = cn_r;
                                        if (rl_f != 0xFFFFFFFFFFFFFFFF) {
                                            callsub s_field_info(rl_f, flF);
                                            if (fif_r == 1) {
                                                if (load64(flF + 24) + 8 <= load32(rl_c + 20)) {
                                                    # the head of a module's value (link.py value()):
                                                    # the chain word sits before the type's fixed part
                                                    rl_f = 0;
                                                    if (rl_kind == 1) {
                                                        rl_f = 8;
                                                    }
                                                    rl_id = load64(rl_c + 24 + rl_f + load64(flF + 24));
                                                    rl_named = 1;
                                                }
                                            }
                                        }
                                    }
                                    if (rl_named == 0) {
                                        callsub s_path_id(hx_r, rl_path);
                                        if (pi_r == 0) {
                                            jb_reason = 11;
                                            rl_go = 0;
                                        } else {
                                            rl_id = pi_id;
                                        }
                                    }
                                }
                                if (rl_go == 1) {
                                    rl_f = 0;
                                    if (rl_kind == 1) {
                                        rl_f = 8;
                                    }
                                    store64(rl_rows + 32 * rl_count, rl_id);
                                    store64(rl_rows + 32 * rl_count + 8,
                                            load64(rl_type_ids + 8 * rl_type));
                                    store64(rl_rows + 32 * rl_count + 16,
                                            rl_c + 24 + rl_f + rl_prefix);
                                    store64(rl_rows + 32 * rl_count + 24,
                                            load32(rl_c + 20) - rl_prefix);
                                    rl_count = rl_count + 1;
                                }
                            }
                        }
                    }
                }
                rl_h = rl_h + 1;
            }
        }
    }
    if (rl_go == 1) {
        if (rl_count > 1) {
            rl_s = rl_count / 2;
            while (rl_s != 0) {
                rl_s = rl_s - 1;
                callsub s_sift_rows(rl_rows, rl_s, rl_count);
            }
            rl_e = rl_count - 1;
            while (rl_e != 0) {
                callsub s_cpy(srt, rl_rows, 32);
                callsub s_cpy(rl_rows, rl_rows + 32 * rl_e, 32);
                callsub s_cpy(rl_rows + 32 * rl_e, srt, 32);
                callsub s_sift_rows(rl_rows, 0, rl_e);
                rl_e = rl_e - 1;
            }
        }
    }
    if (rl_go == 1) {
        jb_reason = 11;
        rl_i = 0;
        while (rl_i < rl_count & rl_go == 1) {
            if (load64(rl_rows + 32 * rl_i) <= 8) {                rl_go = 0;
            } else {
                if (rl_i > 0) {
                    if (load64(rl_rows + 32 * rl_i) == load64(rl_rows + 32 * (rl_i - 1))) {                        rl_go = 0;
                    }
                }
            }
            rl_i = rl_i + 1;
        }
    }
    if (rl_go == 1) {
        if (8 + rl_count > load32(ar + 248)) {
            jb_reason = 11;
            rl_go = 0;
        }
    }
    if (rl_go == 1) {
        rl_fc = load64(ctx + 16);
        rl_ftable = load64(ctx + 24);
        callsub s_take(8 * (rl_fc + 1));
        rl_addrs = tk_r;
        if (rl_addrs == 0) {
            jb_reason = 8;
            rl_go = 0;
        } else {
            callsub s_zero(rl_addrs, 8 * (rl_fc + 1));
            rl_addressed = 1;
            if (load32(ar + 252) == 3) {
                rl_addressed = 0;
            }
            if (rl_addressed == 1) {
                rl_run = load32(ab + 24);
                m_lit_pymergetic();
                callsub s_child_named(rl_run, 10);
                rl_run = cn_r;
                m_lit_rxf();
                callsub s_child_named(rl_run, 3);
                rl_run = cn_r;
                m_lit_foundation();
                callsub s_child_named(rl_run, 10);
                rl_run = cn_r;
                m_lit_graph();
                callsub s_child_named(rl_run, 5);
                rl_run = cn_r;
                m_lit_run();
                callsub s_child_named(rl_run, 3);
                rl_run = cn_r;
                if (rl_run == 0xFFFFFFFFFFFFFFFF) {                    rl_go = 0;
                } else {
                    callsub s_cell(rl_run);
                    rl_rc = ce_r;
                    if (rl_rc == 0) {                        rl_go = 0;
                    } else {
                        callsub s_refs(rl_run);
                        rl_rp = rr_r;
                        rl_k = 0;
                        while (rl_k < load32(rl_rc + 44) & rl_go == 1) {
                            rl_role = load64(rl_rp + 24 * rl_k + 8);
                            if (rl_role != 0xFFFFFFFFFFFFFFFF) {
                                callsub s_cell(rl_role);
                                if (ce_r != 0) {
                                    m_lit_leaf();
                                    callsub s_name_is(rl_role, 4);
                                    if (ni_r == 1) {
                                        rl_lid = load32(rl_rp + 24 * rl_k + 20);
                                        if (rl_lid == 0 | rl_lid > rl_fc) {                                            rl_go = 0;
                                        } else {
                                            if (load64(rl_rp + 24 * rl_k) == 0xFFFFFFFFFFFFFFFF) {                                                rl_go = 0;
                                            } else {
                                                m_code_addr(load64(rl_rp + 24 * rl_k));
                                                if (ca_r == 0) {                                                    rl_go = 0;
                                                } else {
                                                    store64(rl_addrs + 8 * (rl_lid - 1), ca_at);
                                                    if (jguard == 1) {
                                                        if (load32(ar + 256) != 0 |
                                                            (rl_lid == 29 & load32(ar + 260) == 0)) {
                                                            jb_reason = 13;
                                                            rl_at = ca_rng0 - load64(ar + 8);
                                                            if (rl_at + ca_rng1 > jb_emitted) {
                                                                rl_go = 0;
                                                            } else {
                                                                callsub s_cmp(ca_rng0, jemit_base + rl_at,
                                                                      ca_rng1);
                                                                if (cmp_r != 0) {
                                                                    rl_go = 0;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            rl_k = rl_k + 1;
                        }
                    }
                }
                if (rl_go == 1) {
                    rl_k = 0;
                    while (rl_k < rl_fc & rl_go == 1) {
                        if (load64(rl_addrs + 8 * rl_k) == 0) {                            rl_go = 0;
                        } else {
                            if (load64(rl_ftable + 24 * rl_k) != rl_k + 1) {                                rl_go = 0;
                            }
                        }
                        rl_k = rl_k + 1;
                    }
                }
            }
        }
    }
    if (rl_go == 1) {
        rl_entries = 8 + rl_count;
        rl_slots = 0;
        if (rl_addressed == 1) {
            rl_slots = rl_fc;
        }
        if (jdry == 0) {
            rl_at = load64(ctx + 40) + 640;
            rl_i = 0;
            while (rl_i < rl_count) {
                store64(rl_at, load64(rl_rows + 32 * rl_i));
                store64(rl_at + 8, 1);
                store64(rl_at + 16, load64(rl_rows + 32 * rl_i + 8));
                store64(rl_at + 24, load64(rl_rows + 32 * rl_i + 16));
                store64(rl_at + 32, load64(rl_rows + 32 * rl_i + 24));
                store64(rl_at + 40, load64(rl_rows + 32 * rl_i + 24));
                store64(rl_at + 48, 1);
                store64(rl_at + 56, 0);
                store64(rl_at + 64, 0);
                store64(rl_at + 72, 0);
                rl_at = rl_at + 80;
                rl_i = rl_i + 1;
            }
            store64(ctx + 32, 8 + rl_count);
            if (rl_addressed == 1) {
                rl_k = 0;
                while (rl_k < rl_fc) {
                    store64(rl_ftable + 24 * rl_k + 16, load64(rl_addrs + 8 * rl_k));
                    rl_k = rl_k + 1;
                }
            }
        }
        jb_reason = 0;
        rl_r = 1;
    }
}

# ---- the arena of `Arena out` over the emit region: the session's arena state, pushed aside ------

# The lookups of the session (asyms, aspec, arel, raddr, acursor) are part of the
# arena state a window swaps: s_init builds the output arena's own tables and the
# pop has to put the session's back, or every read after a dump answers through
# the output's tables (docs/32 5.3 -- the views are the arena's own).
sub s_arena_push() {
    ap_ab = ab;
    ap_acomm = acomm;
    ap_alim = alim;
    ap_ah = ah;
    ap_aneed = aneed;
    ap_aj = aj;
    ap_alb = alog_base;
    ap_alc = alog_comm;
    ap_all = alog_lim;
    ap_amark = amark;
    ap_abitmap = abitmap;
    ap_aused = aused;
    ap_asyms = asyms;
    ap_aspec = aspec;
    ap_arel = arel;
    ap_raddr = raddr;
    ap_acursor = acursor;
}

sub s_arena_pop() {
    ab = ap_ab;
    acomm = ap_acomm;
    alim = ap_alim;
    ah = ap_ah;
    aneed = ap_aneed;
    aj = ap_aj;
    alog_base = ap_alb;
    alog_comm = ap_alc;
    alog_lim = ap_all;
    amark = ap_amark;
    abitmap = ap_abitmap;
    aused = ap_aused;
    asyms = ap_asyms;
    aspec = ap_aspec;
    arel = ap_arel;
    raddr = ap_raddr;
    acursor = ap_acursor;
}

# The output arena's own lookups (em_osyms/em_oaspec/em_ocursor, cached after its
# s_init and saved back at every window's end -- the syms table can move when the
# walk interns a name that grows it) are what a window loads beside the base
# words; the session's come back with s_arena_pop.
macro m_arena_load_out() {
    ab = jemit_base;
    acomm = jemit_cap;
    alim = jemit_cap;
    ah = jemit_base;
    aneed = 0;
    aj = 0;
    asyms = em_osyms;
    aspec = em_oaspec;
    arel = 0;
    raddr = 0;
    acursor = em_ocursor;
}

# ---- good_name (live.cpp:84): text without control characters, without '.', not '@', UTF-8 ------

macro m_good_name(Zp, Zn) {
    var gn_i;
    var gn_b;
    var gn_extra;
    var gn_low;
    var gn_code;
    var gn_k;
    var gn_bad;
    gn_r = 0;
    if (Zn != 0) {
        if (load8(Zp) != 64) {
            gn_bad = 0;
            gn_i = 0;
            while (gn_i < Zn) {
                if (load8(Zp + gn_i) == 46 | load8(Zp + gn_i) < 32 | load8(Zp + gn_i) == 127) {
                    gn_bad = 1;
                }
                gn_i = gn_i + 1;
            }
            gn_i = 0;
            while (gn_i < Zn & gn_bad == 0) {
                gn_b = load8(Zp + gn_i);
                if (gn_b < 128) {
                    gn_i = gn_i + 1;
                } else {
                    gn_extra = 0;
                    gn_low = 128;
                    gn_code = 0;
                    if (gn_b >= 194 & gn_b <= 223) {
                        gn_extra = 1;
                        gn_code = gn_b & 31;
                    } else {
                        if (gn_b >= 224 & gn_b <= 239) {
                            gn_extra = 2;
                            gn_code = gn_b & 15;
                            gn_low = 2048;
                        } else {
                            if (gn_b >= 240 & gn_b <= 244) {
                                gn_extra = 3;
                                gn_code = gn_b & 7;
                                gn_low = 65536;
                            } else {
                                gn_bad = 1;
                            }
                        }
                    }
                    if (gn_bad == 0) {
                        if (gn_i + gn_extra >= Zn) {
                            gn_bad = 1;
                        } else {
                            gn_k = 1;
                            while (gn_k <= gn_extra & gn_bad == 0) {
                                if ((load8(Zp + gn_i + gn_k) & 192) != 128) {
                                    gn_bad = 1;
                                } else {
                                    gn_code = (gn_code << 6) | (load8(Zp + gn_i + gn_k) & 63);
                                }
                                gn_k = gn_k + 1;
                            }
                            if (gn_bad == 0) {
                                if (gn_code < gn_low | gn_code > 1114111) {
                                    gn_bad = 1;
                                } else {
                                    if (gn_code >= 55296 & gn_code <= 57343) {
                                        gn_bad = 1;
                                    }
                                }
                            }
                            if (gn_bad == 0) {
                                gn_i = gn_i + gn_extra + 1;
                            }
                        }
                    }
                }
            }
            if (gn_bad == 0) {
                gn_r = 1;
            }
        }
    }
}

# ---- applying a delta (live.cpp:1514) ------------------------------------------------------------

# apply_prepare() -> ap_r (1/0): the format of every operation of the staged delta (live.cpp:1519).
macro m_apply_prepare() {
    var ap_len;
    var ap_d;
    var ap_strings_end;
    var ap_ops_start;
    var ap_fixups;
    var ap_pos;
    var ap_i;
    var ap_op;
    var ap_size;
    var ap_padded;
    var ap_tail;
    var ap_k;
    var ap_s;
    var ap_go;
    jb_at_op = 0;
    jb_reason = 1;
    ap_r = 0;
    ap_len = jb_len;
    ap_d = load64(ar + 40);
    if (ap_len >= 64) {
        callsub s_cpy(jdhead, ap_d, 64);
        if (load32(jdhead) == 0x44465852) {
            if (load32(jdhead + 4) == 1) {
                ap_strings_end = 64 + load32(jdhead + 12);
                ap_ops_start = (ap_strings_end + 7) & ~7;
                jops_start = ap_ops_start;
                if (ap_strings_end <= ap_len) {
                    if (ap_ops_start <= ap_len) {
                        jb_ssize = load32(jdhead + 12);
                        ap_go = 1;
                        if (jb_ssize != 0) {
                            if (load8(ap_d + 64 + jb_ssize - 1) != 0) {
                                ap_go = 0;
                            }
                        }
                        ap_fixups = 0;
                        ap_pos = ap_ops_start;
                        ap_i = 0;
                        while (ap_i < load32(jdhead + 8) & ap_go == 1) {
                            jb_at_op = ap_i;
                            if (ap_pos + 8 > ap_len) {
                                ap_go = 0;
                            } else {
                                ap_op = load32(ap_d + ap_pos);
                                if (ap_op == 1 | ap_op == 2) {
                                    if (ap_pos + 48 > ap_len) {
                                        ap_go = 0;
                                    } else {
                                        ap_padded = (load32(ap_d + ap_pos + 32) + 7) & ~7;
                                        ap_size = 48 + ap_padded +
                                                  8 * load32(ap_d + ap_pos + 40) +
                                                  16 * load32(ap_d + ap_pos + 36);
                                        if (ap_pos + ap_size > ap_len) {
                                            ap_go = 0;
                                        } else {
                                            callsub s_string_at(load32(ap_d + ap_pos + 4), ap_d + 64,
                                                        jb_ssize);
                                            if (sa_r == 0) {
                                                ap_go = 0;
                                            }
                                        }
                                        if (ap_go == 1) {
                                            if (load32(ap_d + ap_pos + 8) != 0xFFFFFFFF) {
                                                callsub s_string_at(load32(ap_d + ap_pos + 8), ap_d + 64,
                                                            jb_ssize);
                                                if (sa_r == 0) {
                                                    ap_go = 0;
                                                } else {
                                                    ap_fixups = ap_fixups + 1;
                                                }
                                            }
                                        }
                                        if (ap_go == 1) {
                                            ap_tail = ap_d + ap_pos + 48 + ap_padded;
                                            ap_k = 0;
                                            while (ap_k < load32(ap_d + ap_pos + 40) & ap_go == 1) {
                                                if (load32(ap_tail + 8 * ap_k) + 8 >
                                                    load32(ap_d + ap_pos + 32)) {
                                                    ap_go = 0;
                                                } else {
                                                    if (load32(ap_tail + 8 * ap_k + 4) !=
                                                        0xFFFFFFFF) {
                                                        callsub s_string_at(load32(ap_tail + 8 * ap_k + 4),
                                                                    ap_d + 64, jb_ssize);
                                                        if (sa_r == 0) {
                                                            ap_go = 0;
                                                        } else {
                                                            ap_fixups = ap_fixups + 1;
                                                        }
                                                    }
                                                }
                                                ap_k = ap_k + 1;
                                            }
                                        }
                                        if (ap_go == 1) {
                                            ap_tail = ap_tail + 8 * load32(ap_d + ap_pos + 40);
                                            ap_k = 0;
                                            while (ap_k < load32(ap_d + ap_pos + 36) & ap_go == 1) {
                                                if (load32(ap_tail + 16 * ap_k) != 0xFFFFFFFF) {
                                                    callsub s_string_at(load32(ap_tail + 16 * ap_k),
                                                                ap_d + 64, jb_ssize);
                                                    if (sa_r == 0) {
                                                        ap_go = 0;
                                                    } else {
                                                        ap_fixups = ap_fixups + 1;
                                                    }
                                                }
                                                if (ap_go == 1) {
                                                    if (load32(ap_tail + 16 * ap_k + 4) !=
                                                        0xFFFFFFFF) {
                                                        callsub s_string_at(load32(ap_tail + 16 * ap_k + 4),
                                                                    ap_d + 64, jb_ssize);
                                                        if (sa_r == 0) {
                                                            ap_go = 0;
                                                        } else {
                                                            ap_fixups = ap_fixups + 1;
                                                        }
                                                    }
                                                }
                                                ap_k = ap_k + 1;
                                            }
                                        }
                                        if (ap_go == 1) {
                                            ap_pos = ap_pos + ap_size;
                                        }
                                    }
                                } else {
                                    if (ap_op == 3 | ap_op == 4) {
                                        ap_s = load32(ap_d + ap_pos + 4);
                                        if (ap_op != 4 | ap_s != 0xFFFFFFFF) {
                                            callsub s_string_at(ap_s, ap_d + 64, jb_ssize);
                                            if (sa_r == 0) {
                                                ap_go = 0;
                                            }
                                        }
                                        if (ap_go == 1) {
                                            ap_pos = ap_pos + 8;
                                        }
                                    } else {
                                        ap_go = 0;
                                    }
                                }
                            }
                            ap_i = ap_i + 1;
                        }
                        if (ap_go == 1) {
                            if (ap_pos == ap_len) {
                                jb_fixups = ap_fixups;
                                jb_at_op = 0;
                                ap_r = 1;
                            }
                        }
                    }
                }
            }
        }
    }
}

# apply_replay() -> ar_r (1/0): the operations on the journal (live.cpp:1616). The journal stays
# open: whatever went wrong is the caller's to roll back.
macro m_apply_replay() {
    var ar_d;
    var ar_strings;
    var ar_pos;
    var ar_opos;
    var ar_pend;
    var ar_npend;
    var ar_i;
    var ar_op;
    var ar_p;
    var ar_n;
    var ar_padded;
    var ar_body;
    var ar_patches;
    var ar_rlist;
    var ar_h;
    var ar_cut;
    var ar_name;
    var ar_name_len;
    var ar_parent;
    var ar_old;
    var ar_to;
    var ar_nref;
    var ar_k;
    var ar_s;
    var ar_t;
    var ar_ok;
    var ar_go2;
    ar_r = 0;
    ar_ok = 1;
    ar_d = load64(ar + 40);
    ar_strings = ar_d + 64;
    callsub s_scratch_reset();
    jb_reason = 8;
    callsub s_take(20 * (jb_fixups + 1));
    ar_pend = tk_r;
    if (ar_pend == 0) {
        ar_ok = 0;
    }
    if (ar_ok == 1) {
        ar_npend = 0;
        jb_reason = 7;
        m_begin(load64(ar + 24), load64(ar + 32), load64(ar + 32));
        if (bg_r != 0) {
            ar_ok = 0;
        }
    }
    if (ar_ok == 1) {
        ar_pos = jops_start;
        ar_i = 0;
        while (ar_i < load32(jdhead + 8) & ar_ok == 1) {
            jb_at_op = ar_i;
            ar_opos = ar_pos;
            ar_op = load32(ar_d + ar_opos);
            if (ar_op == 1 | ar_op == 2) {
                ar_padded = (load32(ar_d + ar_opos + 32) + 7) & ~7;
                ar_body = ar_d + ar_opos + 48;
                ar_patches = ar_body + ar_padded;
                ar_rlist = ar_patches + 8 * load32(ar_d + ar_opos + 40);
                ar_pos = ar_opos + 48 + ar_padded + 8 * load32(ar_d + ar_opos + 40) +
                         16 * load32(ar_d + ar_opos + 36);
                callsub s_string_at(load32(ar_d + ar_opos + 4), ar_strings, jb_ssize);
                ar_p = sa_p;
                ar_n = sa_n;
                if (ar_op == 1) {
                    ar_cut = ar_n;
                    ar_go2 = 1;
                    while (ar_go2 == 1) {
                        if (ar_cut == 0) {
                            ar_go2 = 0;
                        } else {
                            if (load8(ar_p + ar_cut - 1) == 46) {
                                ar_go2 = 0;
                            } else {
                                ar_cut = ar_cut - 1;
                            }
                        }
                    }
                    ar_name = ar_p + ar_cut;
                    ar_name_len = ar_n - ar_cut;
                    ar_parent = load32(ab + 24);
                    if (ar_cut > 0) {
                        callsub s_resolve(ar_p, ar_cut - 1);
                        ar_parent = rv_r;
                    }
                    if (ar_n == 0 | ar_parent == 0xFFFFFFFFFFFFFFFF) {
                        jb_reason = 3;
                        ar_ok = 0;
                    } else {
                        m_good_name(ar_name, ar_name_len);
                        if (gn_r == 0) {
                            jb_reason = 5;
                            ar_ok = 0;
                        } else {
                            callsub s_find_child(ar_parent, ar_name, ar_name_len);
                            if (fc_r != 0xFFFFFFFFFFFFFFFF) {
                                jb_reason = 4;
                                ar_ok = 0;
                            }
                        }
                    }
                    if (ar_ok == 1) {
                        cs_type = 0xFFFFFFFFFFFFFFFF;
                        cs_parent = ar_parent;
