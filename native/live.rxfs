# child_named(parent, lit, n) -> cn_r (live.cpp:1257)
sub s_child_named(Zparent_child_named, Zn_child_named) {
    if (Zparent_child_named == 0xFFFFFFFFFFFFFFFF) {
        cn_r = 0xFFFFFFFFFFFFFFFF;
    } else {
        callsub s_find_child(Zparent_child_named, lit, Zn_child_named);
        cn_r = fc_r;
    }
}

# name_is(h, lit, n) -> ni_r (live.cpp:1265)
sub s_name_is(Zh_name_is, Zn_name_is) {
    var ni_i;
    var ni_bad;
    callsub s_name(Zh_name_is);
    ni_bad = 0;
    ni_i = 0;
    while (ni_i < Zn_name_is) {
        if (load8(nm_r + ni_i) != load8(lit + ni_i)) {
            ni_bad = 1;
        }
        ni_i = ni_i + 1;
    }
    ni_r = 0;
    if (ni_bad == 0) {
        if (load8(nm_r + Zn_name_is) == 0) {
            ni_r = 1;
        }
    }
}

# string_at(offset, strings, size) -> sa_r, sa_p, sa_n (live.cpp:1483)
sub s_string_at(Zoff_string_at, Zstrings_string_at, Zsize_string_at) {
    var sa_e;
    var sa_go;
    sa_r = 0;
    if (Zoff_string_at < Zsize_string_at) {
        sa_e = Zoff_string_at;
        sa_go = 1;
        while (sa_go == 1) {
            if (sa_e >= Zsize_string_at) {
                sa_go = 0;
            } else {
                if (load8(Zstrings_string_at + sa_e) == 0) {
                    sa_go = 0;
                } else {
                    sa_e = sa_e + 1;
                }
            }
        }
        if (sa_e < Zsize_string_at) {
            sa_p = Zstrings_string_at + Zoff_string_at;
            sa_n = sa_e - Zoff_string_at;
            sa_r = 1;
        }
    }
}

# reason_of(status) -> ro2_r (live.cpp:1498): the arena status becomes a refusal reason.
sub s_reason_of(Zs_reason_of) {
    ro2_r = 6;
    if (Zs_reason_of == 12) {
        ro2_r = 7;
    }
    if (Zs_reason_of == 7) {
        ro2_r = 4;
    }
    if (Zs_reason_of == 8) {
        ro2_r = 5;
    }
    if (Zs_reason_of == 6) {
        ro2_r = 10;
    }
    if (Zs_reason_of == 10) {
        ro2_r = 9;
    }
    if (Zs_reason_of == 11) {
        ro2_r = 3;
    }
    if (Zs_reason_of == 2) {
        ro2_r = 3;
    }
}

# path_id(h, buffer) -> pi_r (1/0), pi_id: the first 8 bytes (little-endian) of the SHA-256 of
# the path of the object (live.cpp:1273).
sub s_path_id(Zh_path_id, Zbuf_path_id) {
    var pi_n;
    callsub s_path_of(Zh_path_id, Zbuf_path_id, 1024);
    pi_r = 0;
    if (po_r == 1) {
        pi_n = po_n;
        callsub s_sha_init(shh);
        callsub s_sha_upd(shh, Zbuf_path_id, pi_n);
        callsub s_sha_finish(shh, shd);
        pi_id = load64(shd);
        pi_r = 1;
    }
}

# sift_rows(a, root, end): heap sort of the 32-byte Rows by their id (live.cpp:1284).
sub s_sift_rows(Za_sift_rows, Zroot_sift_rows, Zend_sift_rows) {
    var sr_root;
    var sr_child;
    var sr_go;
    sr_root = Zroot_sift_rows;
    sr_go = 1;
    while (sr_go == 1) {
        sr_child = 2 * sr_root + 1;
        if (sr_child >= Zend_sift_rows) {
            sr_go = 0;
        } else {
            if (sr_child + 1 < Zend_sift_rows) {
                if (load64(Za_sift_rows + 32 * sr_child) < load64(Za_sift_rows + 32 * (sr_child + 1))) {
                    sr_child = sr_child + 1;
                }
            }
            if (load64(Za_sift_rows + 32 * sr_root) >= load64(Za_sift_rows + 32 * sr_child)) {
                sr_go = 0;
            } else {
                callsub s_cpy(srt, Za_sift_rows + 32 * sr_root, 32);
                callsub s_cpy(Za_sift_rows + 32 * sr_root, Za_sift_rows + 32 * sr_child, 32);
                callsub s_cpy(Za_sift_rows + 32 * sr_child, srt, 32);
                sr_root = sr_child;
            }
        }
    }
}

# linkable() -> lk_r (live.cpp:1075): there is a context with entries the image may fill.
sub s_linkable() {
    lk_r = 0;
    if (ctx != 0) {
        if (load32(ar + 248) != 0) {
            lk_r = 1;
        }
    }
}

# code_address(function) -> ca_r (1/0), ca_at, ca_rng0/ca_rng1 (live.cpp:1303): the Code of a
# native Function for this machine, as an address and a byte range. The bytes live in the
# CodeBlob that the code's `body` names (Wave 4b step 1): the entry is an offset into that
# blob's value, not the (now fixed-size) code payload.
macro m_code_addr(Zfunction) {
    var ca_code;
    var ca_c;
    var ca_pay;
    var ca_entry;
    var ca_bytes;
    var ca_bf;
    var ca_body;
    var ca_b;
    var ca_btype;
    var ca_prefix;
    ca_r = 0;
    ca_code = 0xFFFFFFFFFFFFFFFF;
    if (load32(ar + 252) == 1) {
        m_lit_x8664();
        callsub s_child_named(Zfunction, 12);
        ca_code = cn_r;
    }
    if (load32(ar + 252) == 2) {
        m_lit_aarch64();
        callsub s_child_named(Zfunction, 13);
        ca_code = cn_r;
    }
    if (ca_code == 0xFFFFFFFFFFFFFFFF) {
        ca_r = 0;
    } else {
        callsub s_cell(ca_code);
        ca_c = ce_r;
        if (ca_c == 0) {
            ca_r = 0;
        } else {
            if (load64(ca_c + 16) < 48) {
                ca_r = 0;
            } else {
                ca_pay = ca_c + 64;
                ca_entry = load64(ca_pay + 40);
                m_lit_body();
                callsub s_child_named(load64(ca_c), 4);
                ca_bf = cn_r;
                if (ca_bf == 0xFFFFFFFFFFFFFFFF) {
                    ca_r = 0;
                } else {
                    callsub s_field_info(ca_bf, flF);
                    if (fif_r == 0) {
                        ca_r = 0;
                    } else {
                        if (load64(flF + 24) + 8 > load64(ca_c + 16)) {
                            ca_r = 0;
                        } else {
                            ca_body = load64(ca_pay + load64(flF + 24));
                            callsub s_cell(ca_body);
                            ca_b = ce_r;
                            if (ca_b == 0) {
                                ca_r = 0;
                            } else {
                                ca_btype = load64(ca_b);
                                if (ca_btype == 0xFFFFFFFFFFFFFFFF | ca_btype >= n_kids) {
                                    ca_r = 0;
                                } else {
                                    callsub s_refs_of(ca_btype);
                                    if (ro_r == 0) {
                                        ca_r = 0;
                                    } else {
                                        ca_prefix = load32(kpfx + 4 * ca_btype);
                                        if (ca_prefix > load64(ca_b + 16)) {
                                            ca_r = 0;
                                        } else {
                                            ca_bytes = load64(ca_b + 16) - ca_prefix;
                                            if (ca_entry >= ca_bytes + 1) {
                                                ca_r = 0;
                                            } else {
                                                ca_at = ca_b + 64 + ca_prefix + ca_entry;
                                                ca_rng0 = ca_b + 64 + ca_prefix;
                                                ca_rng1 = ca_bytes;
                                                ca_r = 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# compact_scan() -> cs2_r (live.cpp:1211): a pinned object forbids compaction.
macro m_compact_scan() {
    var cs2_n;
    var cs2_h;
    cs2_r = 1;
    cs2_n = load32(ab + 4120);
    cs2_h = 0;
    while (cs2_h < cs2_n) {
        if (cs2_r == 1) {
            m_pack_i(cs2_h);
            callsub s_cell(hx_r);
            if (ce_r != 0) {
                callsub s_mob_of(ce_r);
                if (mob_r == 1) {
                    jb_reason = 13;
                    cs2_r = 0;
                }
            }
        }
        cs2_h = cs2_h + 1;
    }
}

# compact_copy() -> cc_r (live.cpp:1224): the emitted bytes replace the arena's.
# The slide of docs/20 S8: the canonical image the walk rebuilt into the emit
# region is copied over the arena, in place; the vacated stream tail - the
# pages between the new committed and the old image's end - is zeroed (the
# copied marker's links are the fresh ring, the absorbed words beyond them are
# not records any more); the superblock's own words (root, entry, the reserved
# tail) are the canonical image's already - the copy is byte for byte, no word
# is patched on top. What re-attaches is the region: committed as the area says
# (arena_committed, 0: the whole region), the limit as the claim the image
# carries. The lookup table is re-derived (docs/32 1: never stored), the
# compactions and the epoch move, and the reclaimed bytes are the old image's
# size - the new one's.
macro m_compact_copy() {
    var cc_len;
    var cc_before;
    var cc_comm;
    var cc_base;
    cc_len = jb_emitted;
    cc_before = load64(ah + 8) + 24 + 16;
    cc_comm = load64(ar + 224);
    if (cc_comm == 0) {
        cc_comm = load64(ar + 16);
    }
    cc_base = load64(ar + 8);
    callsub s_cpy(cc_base, jemit_base, cc_len);
    if (cc_before > cc_len) {
        callsub s_zero(cc_base + cc_len, cc_before - cc_len);
    }
    ab = cc_base;
    acomm = cc_comm;
    alim = load64(ar + 16);
    ah = 0;
    callsub s_attach();
    cc_r = 0;
    if (at_r == 0) {
        store32(ar + 140, 0);
        store64(ar + 240, load64(ar + 240) + 1);
        jb_reclaimed = cc_before - cc_len;
        callsub s_linkable();
        cc_r = 1;
        if (lk_r == 1) {
            callsub s_build_table();
            if (bt_r == 1) {
                store32(ar + 140, 1);
            }
        }
    } else {
        jb_reason = 6;
    }
}

# ---- the canonical form (live.cpp:872) ------------------------------------------------------------

# emit() -> em_r (1/0), em_len, em_rsn: the compacted image to the emit region, its digest to the
# area. `Arena out` over the emit region is the arena state pushed aside and reloaded around each
# out call (m_arena_push/pop); the session reads of one iteration all happen before the swap.
# fixup_slot (object_arena.cpp): one u64 of the placed object's payload. The
# source's slot sits at head + em_off2 of its value (the module head included);
# the output's sits at em_dest + em_off2 (em_dest is the head minus the shift a
# demotion dropped), and the value it holds follows the remap: a handle that
# points at an object that is gone is unset in the canonical image (compaction
# does the same), the rest are the output's own handles.
macro m_fixup_slot() {
    em_v2 = load64(em_orec + 24 + em_dest + em_off2);
    if (em_v2 == 0xFFFFFFFFFFFFFFFF) {
        em_v2 = 0xFFFFFFFFFFFFFFFF;
    } else {
        if (em_v2 > 4294967295) {
            em_go = 0;
        } else {
            if ((em_v2 & 1048575) >= em_n) {
                em_go = 0;
            } else {
                em_w2 = load32(em_remap + 4 * (em_v2 & 1048575));
                if (em_w2 == 4294967295) {
                    em_w2 = 0xFFFFFFFFFFFFFFFF;
                }
                em_v2 = em_w2;
            }
        }
    }
    if (em_go == 1) {
        store64(em_orec + 24 + em_dest + em_off2, em_v2);
    }
}

# place_one (object_arena.cpp: the writer's create): the source object em_hnd
# placed into the output arena, its handle into em_remap. The name, the storage
# role and the payload room are the writer's; a module that lost its last child
# is a leaf (docs/32 1.2, the mirror of into_module) in the storage role of its
# world kind; the module head is the appends' own and the value follows it. The
# record's flags word is the source's (place_one's set_flags); the row is the
# create's own -- the walk's second pass owns its type.
macro m_emplace() {
    callsub s_rec(em_hnd);
    em_sr = ce_r;
    if (em_sr == 0) {
        em_go = 0;
    }
    if (em_go == 1) {
        em_skid = load16(em_sr);
        em_sflags = load16(em_sr + 4);
        em_sid = load16(em_sr + 6);
        em_spar = load32(em_sr + 8);
        em_spay = load32(em_sr + 20);
        callsub s_cell(em_hnd);
        em_c = ce_r;
        if (em_c == 0) {
            em_c = empty0;
        }
        em_rflags = load32(em_c + 40);
        # The parent follows the remap (place_one): a parent the walk has not
        # placed yet is not this walk's tree. The parent is a handle -- the
        # index is its low 20 bits.
        if (em_spar == 4294967295) {
            cs_parent = 4294967295;
        } else {
            if ((em_spar & 1048575) >= em_n) {
                em_go = 0;
            } else {
                cs_parent = load32(em_remap + 4 * (em_spar & 1048575));
                if (cs_parent == 4294967295) {
                    em_go = 0;
                }
            }
        }
    }
    if (em_go == 1) {
        # The room and the role (place_one): a module keeps its room, a module
        # the walk demotes answers the value's alone, a leaf its own.
        em_module = 0;
        em_kind2 = em_skid;
        em_room2 = em_spay;
        if (em_skid == 1) {
            em_module = 1;
            if (load32(em_sr + 24) == 4294967295) {
                em_node = em_rflags & 255;
                if (em_node != 0) {
                    # LEAF_KIND (arena_export.py): fn and code are FUNC, the
                    # typed layouts SPEC, the names SYM, the rest BLOB.
                    em_module = 0;
                    em_kind2 = 6;
                    if (em_node == 6 | em_node == 7) {
                        em_kind2 = 2;
                    }
                    if (em_node == 4 | em_node == 5 | em_node == 20) {
                        em_kind2 = 4;
                    }
                    if (em_node == 12 | em_node == 13 | em_node == 21) {
                        em_kind2 = 5;
                    }
                    em_room2 = 0;
                    if (em_spay > 8) {
                        em_room2 = em_spay - 8;
                    }
                }
            }
        }
        cs_kind = em_kind2;
        cs_payload = em_room2;
        cs_refc = 1;
        cs_refs = 0;
        cs_type = 4294967295;
        # The row's own words (the create writes them; the second pass owns the
        # type): the source row, as it stands.
        cs_flags = em_rflags;
        cs_generation = load64(em_c + 24);
        cs_index = load32(em_c + 56);
        cs_name = ab + 32;
        cs_name_len = 0;
        if (em_sid != 0) {
            if (em_sid < load32(src_syms)) {
                cs_name = src_syms + load32(src_syms + 8 + 4 * em_sid);
                nm_r = cs_name;
                callsub s_len(nm_r);
                cs_name_len = len_r;
            }
        }
        # The value's address is the source's own (docs/32 1.2): taken before the
        # arena is swapped for the output.
        em_src = 0;
        if (em_spay != 0) {
            em_src = em_sr + 24;
        }
        callsub s_arena_push();
        m_arena_load_out();
        callsub s_create();
        em_made = cr_h;
        if (cr_r != 0) {
            em_go = 0;
        }
        if (em_go == 1) {
            m_entry(em_made & 1048575);
            em_orec = ab + load64(sp_r + 8);
            # set_flags (place_one): the record's own word.
            store16(em_orec + 4, em_sflags);
            em_pk = load16(em_orec);
            # The value lands behind the head the appends own (place_one's skip
            # and dest): a module's first 8 bytes are its chain, the object's
            # own data follows; a demoted leaf has no head, its value at 0.
            em_dest = 0;
            if (em_pk == 1) {
                if (em_spay >= 8) {
                    em_dest = 8;
                }
            }
            em_skip = 0;
            if (em_skid == 1) {
                if (em_spay >= 8) {
                    em_skip = 8;
                }
            }
            if (em_spay != 0) {
                callsub s_cpy(em_orec + 24 + em_dest, em_src + em_skip, em_spay - em_skip);
            }
            em_osyms = asyms;
            em_oaspec = aspec;
            em_ocursor = acursor;
        }
        callsub s_arena_pop();
        if (em_go == 1) {
            store32(em_remap + 4 * (em_hnd & 1048575), em_made);
        }
    }
}

# emit() -> em_r (1/0), em_rsn, em_len (live.cpp dump + ObjectArena::rebuild, docs/32 5.4):
# the canonical bytes of the session's arena, rebuilt into the emit region -- the
# writer's whole sequence, replayed: the bootstrap first (the interning order --
# and with it every symbol id -- is part of the bytes), then the world in TREE
# order (children by name), the relation tables behind it, then the genesis tree;
# the handles the payloads, the rows and the relation rows carry follow the remap
# in the second pass. The region IS the output arena's memory, so the dump is no
# copy: the canonical bytes are the region's prefix, and their SHA-256 the digest.
macro m_emit() {
    var em_n;
    var em_h;
    var em_go;
    var em_c;
    var em_k;
    var em_t;
