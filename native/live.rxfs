                if (em_go == 1) {
                    if (cs_payload != 0) {
                        callsub s_payload(em_made);
                        em_payload = pa_r;
                        callsub s_cpy(em_payload, em_c + 64, cs_payload);
                        em_k = 0;
                        while (em_k < load32(em_words) & em_go == 1) {
