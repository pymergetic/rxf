                if (ar_ok == 1) {
                    if (load32(ar_d + ar_opos + 8) != 0xFFFFFFFF) {
                        store32(ar_pend + 20 * ar_npend, ar_h);
                        store32(ar_pend + 20 * ar_npend + 4, 0);
                        store32(ar_pend + 20 * ar_npend + 8, 0);
                        store32(ar_pend + 20 * ar_npend + 12, load32(ar_d + ar_opos + 8));
                        store32(ar_pend + 20 * ar_npend + 16, ar_i);
                        ar_npend = ar_npend + 1;
