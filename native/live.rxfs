# native/live.rxfs -- the live pump as a seed body (docs/30-NATIVE-PORT.md, section 12).
#
# A line-by-line port of the C++ of the live layer, compiled freestanding into one leaf that
# calls nothing:
#
#   fn live_pump(context, area)   leaf 29 (RXF_LEAF_LIVE_PUMP), `!pp`, status-only -- native/live.cpp
#                                 + src/pymergetic/rxftk/core/live/live.cpp
#                                 + src/pymergetic/rxftk/core/arena/arena.cpp
#                                 + core/arena/mem.hpp + core/hash/sha256_core.hpp
#   fn safe_point(context, area)  leaf 38 (RXF_LEAF_SAFE_POINT), `!pp`, status-only -- native/safe.c
#
# The C++ classes are flattened by hand: `Session` and `Arena` members are the `var` words of the
# fn below, every member function is a macro family (each macro header names the C++ it mirrors),
# and the C++ `return` of a helper is `h_ok = 0/1` plus a guarded block -- a macro expands where
# it stands, so a `return` inside one would leave the whole fn. RAII (`Arena out;` in emit) is an
# explicit init over the emit region; `load<T>/store<T>` are the width intrinsics; `literal<N>`
# is byte stores; `[[clang::musttail]]` is `tailcall_pp` (seed extension, see the docs).
#
# Memory model (the C++ atomics, spelled out): the ring words are volatile u32s paired
# acquire/release in the C++; the seed models them as plain load32/store32. The assumption: one
# producer, one consumer per ring, and the u32 accesses are atomic on x86_64/aarch64/wasm32; the
# release stores publish the ring bytes before the counters on both ISAs. The differential seats
# are single-threaded, so plain accesses see the same interleaving there.
#
# publish_code (aarch64 `dc cvau`/`ic ivau` over the self-copy) is not expressible in the dialect
# and is dropped: a no-op on x86_64 and on the emulator seats. The aarch64 hardware gap is named
# in the wire-in notes of the docs.

# ---- byte memory (core/arena/mem.hpp): the loops, in their order --------------------------------

sub s_cpy(Zd_cpy, Zs_cpy, Zn_cpy) {
    var cpy_i;
    cpy_i = 0;
    # A null end is a caller that has nothing to copy into or out of; it must not
    # turn into a read or a write at address 0.
    if (Zd_cpy != 0 & Zs_cpy != 0) {
        while (cpy_i < Zn_cpy) {
            store8(Zd_cpy + cpy_i, load8(Zs_cpy + cpy_i));
            cpy_i = cpy_i + 1;
        }
    }
}

macro m_mv(Zd, Zs, Zn) {
    var mv_i;
    if (Zd <= Zs) {
        mv_i = 0;
        while (mv_i < Zn) {
            store8(Zd + mv_i, load8(Zs + mv_i));
            mv_i = mv_i + 1;
        }
    } else {
        mv_i = Zn;
        while (mv_i != 0) {
            mv_i = mv_i - 1;
            store8(Zd + mv_i, load8(Zs + mv_i));
        }
    }
}

sub s_zero(Zd_zero, Zn_zero) {
    var zero_i;
    zero_i = 0;
    if (Zd_zero != 0) {
        while (zero_i < Zn_zero) {
            store8(Zd_zero + zero_i, 0);
            zero_i = zero_i + 1;
        }
    }
}

# mem::compare -> `cmp_r`: 0 when the ranges are equal, 1 otherwise (the callers only test != 0).
sub s_cmp(Za_cmp, Zb_cmp, Zn_cmp) {
    var cmp_i;
    cmp_r = 0;
    cmp_i = 0;
    while (cmp_i < Zn_cmp & cmp_r == 0) {
        if (load8(Za_cmp + cmp_i) != load8(Zb_cmp + cmp_i)) {
            cmp_r = 1;
        }
        cmp_i = cmp_i + 1;
    }
}

# mem::length -> `len_r`: the bytes up to the NUL.
sub s_len(Zp_len) {
    len_r = 0;
    if (Zp_len != 0) {
        # Bounded: a name is interned with its terminator, and a pointer that
        # carries none would otherwise walk the whole address space.
        while (len_r < 65536 & load8(Zp_len + len_r) != 0) {
            len_r = len_r + 1;
        }
    }
}

# take(bytes) -> tk_r: 16-aligned bytes of the work region, or 0.
sub s_take(Zbytes_take) {
    var tk_n;
    tk_n = (Zbytes_take + 15) & ~15;
    if (send - sat < tk_n) {
        tk_r = 0;
    } else {
        tk_r = sat;
        sat = sat + tk_n;
    }
}

# ---- CRC-32 (IEEE, reflected, polynomial 0xEDB88320) --------------------------------------------

# crc_update(crc, p, n) -> crc_r
macro m_crc(Zc, Zp, Zn) {
    var crc_i;
    var crc_k;
    crc_r = Zc;
    crc_i = 0;
    while (crc_i < Zn) {
        crc_r = crc_r ^ load8(Zp + crc_i);
        crc_k = 0;
        while (crc_k < 8) {
            crc_r = ((crc_r >> 1) ^ (0xEDB88320 & (0 - (crc_r & 1)))) & 0xFFFFFFFF;
            crc_k = crc_k + 1;
        }
        crc_i = crc_i + 1;
    }
}

# crc32(p, n) -> crc_r
sub s_crc32(Zp_crc32, Zn_crc32) {
    m_crc(0xFFFFFFFF, Zp_crc32, Zn_crc32);
    crc_r = (~crc_r) & 0xFFFFFFFF;
}

# ---- SHA-256 (core/hash/sha256_core.hpp): state words, no tables --------------------------------
# sh[0..31] h[0..7] (u32), sh[32..95] the 64-byte block buffer, sh[96..103] the byte count (u64),
# sh[104..107] the bytes in the buffer. shw[0..255] is the 64-word message schedule.

macro m_sha_k(Zk) {
    store32(Zk, 0x428A2F98); store32(Zk + 4, 0x71374491); store32(Zk + 8, 0xB5C0FBCF);
    store32(Zk + 12, 0xE9B5DBA5); store32(Zk + 16, 0x3956C25B); store32(Zk + 20, 0x59F111F1);
    store32(Zk + 24, 0x923F82A4); store32(Zk + 28, 0xAB1C5ED5);
    store32(Zk + 32, 0xD807AA98); store32(Zk + 36, 0x12835B01); store32(Zk + 40, 0x243185BE);
    store32(Zk + 44, 0x550C7DC3); store32(Zk + 48, 0x72BE5D74); store32(Zk + 52, 0x80DEB1FE);
    store32(Zk + 56, 0x9BDC06A7); store32(Zk + 60, 0xC19BF174);
    store32(Zk + 64, 0xE49B69C1); store32(Zk + 68, 0xEFBE4786); store32(Zk + 72, 0x0FC19DC6);
    store32(Zk + 76, 0x240CA1CC); store32(Zk + 80, 0x2DE92C6F); store32(Zk + 84, 0x4A7484AA);
    store32(Zk + 88, 0x5CB0A9DC); store32(Zk + 92, 0x76F988DA);
    store32(Zk + 96, 0x983E5152); store32(Zk + 100, 0xA831C66D); store32(Zk + 104, 0xB00327C8);
    store32(Zk + 108, 0xBF597FC7); store32(Zk + 112, 0xC6E00BF3); store32(Zk + 116, 0xD5A79147);
    store32(Zk + 120, 0x06CA6351); store32(Zk + 124, 0x14292967);
    store32(Zk + 128, 0x27B70A85); store32(Zk + 132, 0x2E1B2138); store32(Zk + 136, 0x4D2C6DFC);
    store32(Zk + 140, 0x53380D13); store32(Zk + 144, 0x650A7354); store32(Zk + 148, 0x766A0ABB);
    store32(Zk + 152, 0x81C2C92E); store32(Zk + 156, 0x92722C85);
    store32(Zk + 160, 0xA2BFE8A1); store32(Zk + 164, 0xA81A664B); store32(Zk + 168, 0xC24B8B70);
    store32(Zk + 172, 0xC76C51A3); store32(Zk + 176, 0xD192E819); store32(Zk + 180, 0xD6990624);
    store32(Zk + 184, 0xF40E3585); store32(Zk + 188, 0x106AA070);
    store32(Zk + 192, 0x19A4C116); store32(Zk + 196, 0x1E376C08); store32(Zk + 200, 0x2748774C);
    store32(Zk + 204, 0x34B0BCB5); store32(Zk + 208, 0x391C0CB3); store32(Zk + 212, 0x4ED8AA4A);
    store32(Zk + 216, 0x5B9CCA4F); store32(Zk + 220, 0x682E6FF3);
    store32(Zk + 224, 0x748F82EE); store32(Zk + 228, 0x78A5636F); store32(Zk + 232, 0x84C87814);
    store32(Zk + 236, 0x8CC70208); store32(Zk + 240, 0x90BEFFFA); store32(Zk + 244, 0xA4506CEB);
    store32(Zk + 248, 0xBEF9A3F7); store32(Zk + 252, 0xC67178F2);
}

sub s_sha_init(Zs_sha_init) {
    m_sha_k(shk);
    store32(Zs_sha_init, 0x6A09E667); store32(Zs_sha_init + 4, 0xBB67AE85); store32(Zs_sha_init + 8, 0x3C6EF372);
    store32(Zs_sha_init + 12, 0xA54FF53A); store32(Zs_sha_init + 16, 0x510E527F); store32(Zs_sha_init + 20, 0x9B05688C);
    store32(Zs_sha_init + 24, 0x1F83D9AB); store32(Zs_sha_init + 28, 0x5BE0CD19);
    store64(Zs_sha_init + 96, 0);
    store32(Zs_sha_init + 104, 0);
}

# sha_block(Zs, Zp): the 64 bytes at Zp -> the state words.
sub s_sha_block(Zs_sha_block, Zp_sha_block) {
    var sb_t;
    var sb_x;
    var sb_y;
    var sb_s0;
    var sb_s1;
    var sb_a;
    var sb_b;
    var sb_c;
    var sb_d;
    var sb_e;
    var sb_f;
    var sb_g;
    var sb_h;
    var sb_ch;
    var sb_t1;
    var sb_t2;
    var sb_maj;
    sb_t = 0;
    while (sb_t < 16) {
        store32(shw + 4 * sb_t,
                ((load8(Zp_sha_block + 4 * sb_t) << 24) | (load8(Zp_sha_block + 4 * sb_t + 1) << 16)) |
                    ((load8(Zp_sha_block + 4 * sb_t + 2) << 8) | load8(Zp_sha_block + 4 * sb_t + 3)));
        sb_t = sb_t + 1;
    }
    sb_t = 16;
    while (sb_t < 64) {
        sb_x = load32(shw + 4 * (sb_t - 15));
        sb_y = load32(shw + 4 * (sb_t - 2));
        sb_s0 = (((sb_x >> 7) | (sb_x << 25)) ^ ((sb_x >> 18) | (sb_x << 14))) ^ (sb_x >> 3);
        sb_s1 = (((sb_y >> 17) | (sb_y << 15)) ^ ((sb_y >> 19) | (sb_y << 13))) ^ (sb_y >> 10);
        store32(shw + 4 * sb_t,
                (load32(shw + 4 * (sb_t - 16)) + sb_s0) & 0xFFFFFFFF);
        store32(shw + 4 * sb_t,
                (load32(shw + 4 * sb_t) + ((load32(shw + 4 * (sb_t - 7)) + sb_s1) & 0xFFFFFFFF)) &
                    0xFFFFFFFF);
        sb_t = sb_t + 1;
    }
    sb_a = load32(Zs_sha_block); sb_b = load32(Zs_sha_block + 4); sb_c = load32(Zs_sha_block + 8); sb_d = load32(Zs_sha_block + 12);
    sb_e = load32(Zs_sha_block + 16); sb_f = load32(Zs_sha_block + 20); sb_g = load32(Zs_sha_block + 24); sb_h = load32(Zs_sha_block + 28);
    sb_t = 0;
    while (sb_t < 64) {
        sb_s1 = (((sb_e >> 6) | (sb_e << 26)) ^ ((sb_e >> 11) | (sb_e << 21))) ^
                ((sb_e >> 25) | (sb_e << 7));
        sb_ch = (sb_e & sb_f) ^ ((~sb_e) & sb_g);
        sb_t1 = (sb_h + sb_s1) & 0xFFFFFFFF;
        sb_t1 = (sb_t1 + sb_ch) & 0xFFFFFFFF;
        sb_t1 = (sb_t1 + load32(shk + 4 * sb_t)) & 0xFFFFFFFF;
        sb_t1 = (sb_t1 + load32(shw + 4 * sb_t)) & 0xFFFFFFFF;
        sb_s0 = (((sb_a >> 2) | (sb_a << 30)) ^ ((sb_a >> 13) | (sb_a << 19))) ^
                ((sb_a >> 22) | (sb_a << 10));
        sb_maj = (sb_a & sb_b) ^ ((sb_a & sb_c) ^ (sb_b & sb_c));
        sb_t2 = (sb_s0 + sb_maj) & 0xFFFFFFFF;
        sb_h = sb_g; sb_g = sb_f; sb_f = sb_e;
        sb_e = (sb_d + sb_t1) & 0xFFFFFFFF;
        sb_d = sb_c; sb_c = sb_b; sb_b = sb_a;
        sb_a = (sb_t1 + sb_t2) & 0xFFFFFFFF;
        sb_t = sb_t + 1;
    }
    store32(Zs_sha_block, (load32(Zs_sha_block) + sb_a) & 0xFFFFFFFF);
    store32(Zs_sha_block + 4, (load32(Zs_sha_block + 4) + sb_b) & 0xFFFFFFFF);
    store32(Zs_sha_block + 8, (load32(Zs_sha_block + 8) + sb_c) & 0xFFFFFFFF);
    store32(Zs_sha_block + 12, (load32(Zs_sha_block + 12) + sb_d) & 0xFFFFFFFF);
    store32(Zs_sha_block + 16, (load32(Zs_sha_block + 16) + sb_e) & 0xFFFFFFFF);
    store32(Zs_sha_block + 20, (load32(Zs_sha_block + 20) + sb_f) & 0xFFFFFFFF);
    store32(Zs_sha_block + 24, (load32(Zs_sha_block + 24) + sb_g) & 0xFFFFFFFF);
    store32(Zs_sha_block + 28, (load32(Zs_sha_block + 28) + sb_h) & 0xFFFFFFFF);
}

# sha_update(Zs, Zp, Zn): the bytes accumulate one at a time, as in the C++.
sub s_sha_upd(Zs_sha_upd, Zp_sha_upd, Zn_sha_upd) {
    var su_i;
    su_i = 0;
    while (su_i < Zn_sha_upd) {
        store8(Zs_sha_upd + 32 + load32(Zs_sha_upd + 104), load8(Zp_sha_upd + su_i));
        store32(Zs_sha_upd + 104, load32(Zs_sha_upd + 104) + 1);
        if (load32(Zs_sha_upd + 104) == 64) {
            callsub s_sha_block(Zs_sha_upd, Zs_sha_upd + 32);
            store64(Zs_sha_upd + 96, load64(Zs_sha_upd + 96) + 64);
            store32(Zs_sha_upd + 104, 0);
        }
        su_i = su_i + 1;
    }
}

# sha_finish(Zs, Zout): padding, then the state words big-endian.
sub s_sha_finish(Zs_sha_finish, Zout_sha_finish) {
    var sf_i;
    var sf_bits;
    sf_bits = (load64(Zs_sha_finish + 96) + load32(Zs_sha_finish + 104)) << 3;
    # the padding is the C++ update(&pad, 1) / update(&zero, 1): every byte through the
    # 64-byte buffer, and a buffer that fills mid-padding is compressed before the rest
    # lands in a fresh block (sha256_core.hpp finish).
    store8(Zs_sha_finish + 32 + load32(Zs_sha_finish + 104), 0x80);
    store32(Zs_sha_finish + 104, load32(Zs_sha_finish + 104) + 1);
    if (load32(Zs_sha_finish + 104) == 64) {
        callsub s_sha_block(Zs_sha_finish, Zs_sha_finish + 32);
        store64(Zs_sha_finish + 96, load64(Zs_sha_finish + 96) + 64);
        store32(Zs_sha_finish + 104, 0);
    }
    while (load32(Zs_sha_finish + 104) != 56) {
        store8(Zs_sha_finish + 32 + load32(Zs_sha_finish + 104), 0);
        store32(Zs_sha_finish + 104, load32(Zs_sha_finish + 104) + 1);
        if (load32(Zs_sha_finish + 104) == 64) {
            callsub s_sha_block(Zs_sha_finish, Zs_sha_finish + 32);
            store64(Zs_sha_finish + 96, load64(Zs_sha_finish + 96) + 64);
            store32(Zs_sha_finish + 104, 0);
        }
    }
    sf_i = 0;
    while (sf_i < 8) {
        store8(Zs_sha_finish + 32 + 56 + sf_i, (sf_bits >> (56 - 8 * sf_i)) & 0xFF);
        sf_i = sf_i + 1;
    }
    callsub s_sha_block(Zs_sha_finish, Zs_sha_finish + 32);
    sf_i = 0;
    while (sf_i < 8) {
        store8(Zout_sha_finish + 4 * sf_i, (load32(Zs_sha_finish + 4 * sf_i) >> 24) & 0xFF);
        store8(Zout_sha_finish + 4 * sf_i + 1, (load32(Zs_sha_finish + 4 * sf_i) >> 16) & 0xFF);
        store8(Zout_sha_finish + 4 * sf_i + 2, (load32(Zs_sha_finish + 4 * sf_i) >> 8) & 0xFF);
        store8(Zout_sha_finish + 4 * sf_i + 3, load32(Zs_sha_finish + 4 * sf_i) & 0xFF);
        sf_i = sf_i + 1;
    }
}

# ---- the arena (core/arena/object_arena.cpp): allocator, index and records over one region ------
# The session arena's state is the `var` words of the fn: ab = memory base, acomm = committed
# bytes of the region, alim = limit, ah = the superblock at ab, aj = journaling, amark/aused/
# abitmap = the undo log, aneed = the end the last allocation asked for, saved = the superblock
# at begin(). Status words are the arena::Status numbers: Ok 0, OutOfMemory 1, BadHandle 2,
# BadImage 3, IndexFull 4, TooLarge 5, Protected 6, NameTaken 7, BadName 8, HasChildren 9,
# Dangling 10, BadPath 11, JournalFull 12, NoJournal 13.
#
# The model is the v7 one arena (docs/32 1). The superblock is 4096 bytes at the arena start:
# "RXFA", version 1, committed u64 @8 (the first free offset), limit u64 @16, root u32 @24,
# entry u32 @28. The object index is the first object at offset 4096 - its 24-byte record -
# then the slot head (count u32 @4120, capacity u32 @4124) and the 16-byte entries
# {kind u16, gen u16, reserved u32, slot u64} at 4128. A handle32 packs the index (20 bits)
# and the generation (12 bits). A record is 24 bytes - kind u16, gen u16, flags u16, name u16,
# parent u32, link u32, refs u32, payload u32 - and its payload follows inline in 8-byte
# slots. Names live in sys/syms, the semantic face is one row of sys/specs per index
# (docs/32 5), and the refs of an object are the rows of sys/relations/<path> (docs/32 5.2).
#
# What the rest of the pump calls "a cell" is the world cell: the record and its spec row
# together, materialized into one of the three 64-byte views cva/cvb/cvc (docs/32 5.3). A view
# holds until the next call of the accessor that filled it, so a call that keeps two cells
# takes the second accessor. A payload or a reference row is never copied: those stay real
# pointers into the arena.
#
# The FREE ring (docs/32 3): a free span is a record with kind OBJ_FREE and 16 link bytes
# behind its header (prev at +24, next at +32). The end marker sits at the committed boundary
# and covers the tail; it is the ring anchor and is never taken whole.

# entry(index) -> sp_r: the address of the slot entry of this index.
macro m_entry(Zi) {
    sp_r = ab + 4128 + 16 * (Zi & 1048575);
}

# slot(handle) -> sp_r: the index entry this handle names.
macro m_slot(Zh) {
    m_entry(Zh & 1048575);
}

# pack_i(index) -> hx_r: the handle32 this index carries now, 0 when the slot is
# dead. A walk over the object index addresses objects by handle (docs/32 1.2),
# never by bare index - the generation is what makes a stale handle fail.
macro m_pack_i(Zi) {
    var hx_off;
    m_entry(Zi);
    hx_off = load64(sp_r + 8);
    if (hx_off == 0) {
        hx_r = 0;
    } else {
        hx_r = ((load16(sp_r + 2) & 4095) << 20) | (Zi & 1048575);
    }
}

# live(handle) -> lv_r (1/0)
macro m_live(Zh) {
    var lv_ix, lv_gn, lv_off, lv_gen;
    lv_r = 0;
    lv_ix = Zh & 1048575;
    lv_gn = (Zh >> 20) & 4095;
    if (lv_ix < load32(ab + 4120)) {
        m_entry(lv_ix);
        lv_off = load64(sp_r + 8);
        lv_gen = load16(sp_r + 2);
        if (lv_off != 0) {
            if (lv_gen == lv_gn) {
                if (load16(ab + lv_off + 2) == lv_gen) {
                    if (load16(ab + lv_off) == load16(sp_r)) {
                        lv_r = 1;
                    }
                }
            }
        }
    }
}

# ensure(end) -> en_r: a region committed whole (PYMERGETIC_RXF_FIXED_REGION): no callback.
macro m_ensure(Zend) {
    if (Zend <= acomm) {
        en_r = 0;
    } else {
        aneed = Zend;
        en_r = 1;
    }
}

# record(handle) -> ce_r: the 24-byte record of this handle, or 0.
sub s_rec(Zh_rec) {
    m_live(Zh_rec);
    if (lv_r == 0) {
        ce_r = 0;
    } else {
        m_entry(Zh_rec & 1048575);
        ce_r = ab + load64(sp_r + 8);
    }
}

# sym_addr(id) -> sa_r: the string of a symbol id, or 0 for the anonymous id 0.
sub s_sym_addr(Zid_sym) {
    var sa_head;
    sa_head = asyms;
    if (Zid_sym == 0) {
        sa_r = 0;
    } else {
        if (sa_head == 0) {
            sa_r = 0;
        } else {
            if (Zid_sym >= load32(sa_head)) {
                sa_r = 0;
            } else {
                sa_r = sa_head + load32(sa_head + 8 + 4 * Zid_sym);
            }
        }
    }
}

# sym_id(text, n) -> smr_r: the id of an interned name, or 0 when it is not
# there (ObjectArena::symbol_id: a lookup, never an intern -- the walk sorts
# around names the source already holds). A macro, not a sub: the module's sub
# count is at the seed's own limit.
macro m_sym_id(Zp_sym, Zn_sym) {
    var sm_head;
    var sm_i;
    var sm_off;
    smr_r = 0;
    sm_head = asyms;
    if (sm_head != 0) {
        sm_i = 1;
        while (sm_i < load32(sm_head) & smr_r == 0) {
            sm_off = load32(sm_head + 8 + 4 * sm_i);
            if (load8(sm_head + sm_off + Zn_sym) == 0) {
                callsub s_cmp(sm_head + sm_off, Zp_sym, Zn_sym);
                if (cmp_r == 0) {
                    smr_r = sm_i;
                }
            }
            sm_i = sm_i + 1;
        }
    }
}

# spec_row(index) -> sr_at: the semantic row of this index (docs/32 5).
macro m_spec_row(Zindex) {
    sr_at = aspec + 24 * (Zindex & 1048575);
}

# row_count(handle) -> rc_r, rel_at(handle) -> rt_at: the reference rows of an object.
# The lookup is one word of the derived index (docs/32 5.2): the live layer builds
# object -> relation table once, the way it builds its name table. A table is named
# by the object's path, so matching that per call would walk every table for every
# object; the index makes it one word.
sub s_rel_rows(Zh_rr) {
    var rr_tbl;
    var rr_rec;
    var rr_n;
    var rr_at;
    var rr_keep;
    var rr_done;
    rt_at = 0;
    rc_r = 0;
    if (raddr != 0) {
        callsub s_rec(Zh_rr);
        if (ce_r != 0) {
            rr_tbl = load32(raddr + 4 * (Zh_rr & 1048575));
            if (rr_tbl != 0) {
                callsub s_rec(rr_tbl);
                rr_rec = ce_r;
                if (rr_rec != 0) {
                    rt_at = rr_rec + 24;
                    rr_n = load32(rr_rec + 20) / 24;
                    # The room of a table is a whole number of rows and may carry the
                    # zero padding of an 8-byte slot. A real row names a target and a
                    # live handle32 is never 0, so an all-zero row is padding.
                    rr_keep = 0;
                    rr_done = 0;
                    while (rr_keep < rr_n & rr_done == 0) {
                        rr_at = rt_at + 24 * rr_keep;
                        if (load64(rr_at) == 0) {
                            if (load64(rr_at + 8) == 0) {
                                if (load32(rr_at + 20) == 0) {
                                    rr_done = 1;
                                }
                            }
                        }
                        if (rr_done == 0) {
                            rr_keep = rr_keep + 1;
                        }
                    }
                    rc_r = rr_keep;
                }
            }
        }
    }
}

# path_write(handle, buf, cap) -> pw2_r (the length, 0 when it does not fit): the
# dotted path of an object, written into a buffer the caller owns. Written
# backwards from the end so the segments land in tree order (the same walk
# ObjectArena::path_of does).
macro m_path_write(Zh_pw, Zb_pw, Zc_pw) {
    var pw_w;
    var pw_rec;
    var pw_at;
    var pw_len;
    pw2_r = 0;
    callsub s_rec(Zh_pw);
    pw_rec = ce_r;
    if (pw_rec != 0) {
        pw_at = Zc_pw;
        pw_len = 0;
        while (pw_rec != 0) {
            if (load32(pw_rec + 8) == 4294967295) {
                pw_rec = 0;
            } else {
                callsub s_sym_addr(load16(pw_rec + 6));
                if (sa_r == 0) {
                    pw_rec = 0;
                } else {
                    callsub s_len(sa_r);
                    if (pw_at < len_r + 1) {
                        pw_rec = 0;
                        pw_len = 0;
                    } else {
                        pw_at = pw_at - len_r;
                        callsub s_cpy(Zb_pw + pw_at, sa_r, len_r);
                        pw_len = pw_len + len_r;
                        pw_rec = load32(pw_rec + 8);
                        callsub s_rec(pw_rec);
                        pw_w = ce_r;
                        if (load32(pw_w + 8) == 4294967295) {
                            pw_rec = 0;
                        } else {
                            pw_at = pw_at - 1;
                            store8(Zb_pw + pw_at, 46);
                            pw_len = pw_len + 1;
                            pw_rec = pw_w;
                        }
                    }
                }
            }
        }
        if (pw_len != 0) {
            callsub s_cpy(Zb_pw, Zb_pw + pw_at, pw_len);
            store8(Zb_pw + pw_len, 0);
            pw2_r = pw_len;
        }
    }
}

# resolve_path(p, n) -> rp_r: the handle32 a dotted path names, 0 when it names none.
macro m_resolve_path(Zp_rp, Zn_rp) {
    var rp_at;
    var rp_seg;
    var rp_h;
    var rp_ok;
    var rp_dot;
    rp_r = 0;
    rp_at = 0;
    rp_h = load32(ab + 24);
    rp_ok = 1;
    while (rp_at < Zn_rp & rp_ok == 1) {
        # The segment is [rp_at, rp_seg): rp_seg stops on the dot, or on the end.
        rp_seg = rp_at;
        rp_dot = 0;
        while (rp_seg < Zn_rp & rp_dot == 0) {
            if (load8(Zp_rp + rp_seg) == 46) {
                rp_dot = 1;
            } else {
                rp_seg = rp_seg + 1;
            }
        }
        if (rp_seg == rp_at) {
            rp_ok = 0;
        } else {
            callsub s_find_child(rp_h, Zp_rp + rp_at, rp_seg - rp_at);
            if (fc_r == 0xFFFFFFFFFFFFFFFF) {
                rp_ok = 0;
            } else {
                rp_h = fc_r;
                rp_at = rp_seg + 1;
            }
        }
    }
    if (rp_ok == 1) {
        if (rp_h != load32(ab + 24)) {
            rp_r = rp_h;
        }
    }
}

# build_rels(): the derived index of docs/32 5.2 - one word per object index holding
# the relation table that carries its refs. Built after the name table, because a
# table's name is a path and a path resolves through the names.
macro m_build_rels() {
    var br_mod;
    var br_walk;
    var br_rec;
    var br_name;
    var br_len;
    callsub s_zero(raddr, 4 * slts);
    if (arel != 0) {
        callsub s_rec(arel);
        br_mod = ce_r;
        if (br_mod != 0) {
            br_walk = load32(br_mod + 24);
            while (br_walk != 4294967295) {
                callsub s_rec(br_walk);
                br_rec = ce_r;
                if (br_rec == 0) {
                    br_walk = 4294967295;
                } else {
                    callsub s_sym_addr(load16(br_rec + 6));
                    br_name = sa_r;
                    br_len = 0;
                    if (br_name != 0) {
                        callsub s_len(br_name);
                        br_len = len_r;
                        m_resolve_path(br_name, br_len);
                        if (rp_r != 0) {
                            if ((rp_r & 1048575) < slts) {
                                store32(raddr + 4 * (rp_r & 1048575), br_walk);
                            }
                        }
                    }
                    br_walk = load32(br_rec + 12);
                }
            }
        }
    }
}

# fill(handle, view) -> fv_r: the world cell of an object in 64 bytes (docs/32 5.3).
sub s_fill(Zh_fill, Zw_fill) {
    var f_rec;
    var f_spc;
    var f_name;
    var f_rows;
    var f_type;
    var f_par;
    callsub s_rec(Zh_fill);
    f_rec = ce_r;
    fv_r = 0;
    if (f_rec != 0 & aspec != 0) {
        m_spec_row(Zh_fill & 1048575);
        f_spc = sr_at;
        callsub s_rel_rows(Zh_fill);
        f_rows = rc_r;
        callsub s_sym_addr(load16(f_rec + 6));
        f_name = sa_r;
        if (f_name == 0) {
            f_name = ab + 32;
        }
        # An absent handle is the 64-bit all-ones the rest of the pump compares
        # against, not the 32-bit HANDLE32_NONE of the record.
        f_type = load32(f_spc + 0);
        f_par = load32(f_rec + 8);
        if (f_type == 4294967295) {
            f_type = 0xFFFFFFFFFFFFFFFF;
        }
        if (f_par == 4294967295) {
            f_par = 0xFFFFFFFFFFFFFFFF;
        }
        store64(Zw_fill + 0, f_type);
        store64(Zw_fill + 8, f_par);
        store64(Zw_fill + 16, load32(f_rec + 20));
        store64(Zw_fill + 24, load64(f_spc + 16));
        store64(Zw_fill + 32, f_name - ab);
        store32(Zw_fill + 40, load32(f_spc + 4));
        store32(Zw_fill + 44, f_rows);
        store64(Zw_fill + 48, 0);
        store32(Zw_fill + 56, load32(f_spc + 8));
        store32(Zw_fill + 60, 0);
        fv_r = Zw_fill;
    }
}

# cell(handle) -> ce_r: the world cell, view A (good until the next s_cell).
sub s_cell(Zh_cell) {
    callsub s_fill(Zh_cell, cva);
    ce_r = fv_r;
}

# cell_b / cell_c: the same in the second and third view.
macro m_cell_b(Zh) {
    callsub s_fill(Zh, cvb);
    ce_r = fv_r;
}

macro m_cell_c(Zh) {
    callsub s_fill(Zh, cvc);
    ce_r = fv_r;
}

# cb(payload, refs) -> cb_r: the room an object of this payload takes, record included.
# A reference row is never inline (docs/32 5.2): the third argument is kept for the
# callers that carry it and does not add room.
macro m_cb(Zp) {
    cb_r = 24 + ((Zp + 7) & ~7);
}

# kind_of(cell) -> kd_r: the node kind of the world's flags word.
sub s_kd(Zc_kd) {
    kd_r = 0;
    if (Zc_kd != 0) {
        kd_r = load32(Zc_kd + 40) & 0xFF;
    }
}

# payload(handle) -> pa_r: the value bytes of an object, inline behind the record.
sub s_payload(Zh_payload) {
    callsub s_rec(Zh_payload);
    if (ce_r == 0) {
        pa_r = 0;
    } else {
        pa_r = ce_r + 24;
    }
}

# refs(handle) -> rr_r: the reference rows of an object, or 0.
sub s_refs(Zh_refs) {
    callsub s_rel_rows(Zh_refs);
    rr_r = rt_at;
}

# name(handle) -> nm_r: the name string, or the empty string of an anonymous object.
sub s_name(Zh_name) {
    callsub s_rec(Zh_name);
    if (ce_r == 0) {
        nm_r = ab + 32;
    } else {
        callsub s_sym_addr(load16(ce_r + 6));
        if (sa_r == 0) {
            nm_r = ab + 32;
        } else {
            nm_r = sa_r;
        }
    }
}

# write_slot(handle, value) -> ws_r: the record offset of a handle.
sub s_write_slot(Zh_write_slot, Zv_write_slot) {
    m_entry(Zh_write_slot & 1048575);
    callsub s_before_write(sp_r - ab + 8, 8);
    ws_r = bw_r;
    if (bw_r == 0) {
        store64(sp_r + 8, Zv_write_slot);
    }
}

# ---- the semantic face of an object (docs/32 5): what a delta writes ---------------------

# set_field(handle, word, value) -> sf_r: one word of the semantic row.
# word 0 = type, 4 = flags, 8 = index, 16 = generation (docs/32 5).
sub s_set_field(Zh_sf, Zw_sf, Zv_sf) {
    var sf_len;
    sf_len = 4;
    if (Zw_sf == 16) {
        sf_len = 8;
    }
    m_spec_row(Zh_sf & 1048575);
    callsub s_before_write(sr_at - ab + Zw_sf, sf_len);
    sf_r = bw_r;
    if (bw_r == 0) {
        if (sf_len == 8) {
            store64(sr_at + Zw_sf, Zv_sf);
        } else {
            store32(sr_at + Zw_sf, Zv_sf);
        }
    }
}



# ---- the allocator (docs/32 3): best fit over the FREE ring --------------------------------

# span_of(offset) -> sn2_r: 24 bytes of header plus the payload in 8-byte slots.
macro m_span_of(Zoff) {
    sn2_r = 24 + ((load32(ab + Zoff + 20) + 7) & ~7);
}

# link_at(offset) -> la_r: the 16 link bytes behind a free span's header.
macro m_link_at(Zoff) {
    la_r = ab + Zoff + 24;
}

# ring_unlink(offset) -> ru_r
sub s_ring_unlink(Zoff_ru) {
    var ru_prev;
    var ru_next;
    m_link_at(Zoff_ru);
    ru_prev = load64(la_r);
    ru_next = load64(la_r + 8);
    m_link_at(ru_prev);
    callsub s_before_write(la_r - ab + 8, 8);
    ru_r = bw_r;
    if (bw_r == 0) {
        store64(la_r + 8, ru_next);
        m_link_at(ru_next);
        callsub s_before_write(la_r - ab, 8);
        ru_r = bw_r;
        if (bw_r == 0) {
            store64(la_r, ru_prev);
        }
    }
}

# ring_insert_after(anchor, offset) -> ri_r
sub s_ring_insert_after(Zanchor_ri, Zoff_ri) {
    var ri_next;
    m_link_at(Zanchor_ri);
    ri_next = load64(la_r + 8);
    m_link_at(Zoff_ri);
    callsub s_before_write(la_r - ab, 16);
    ri_r = bw_r;
    if (bw_r == 0) {
        store64(la_r, Zanchor_ri);
        store64(la_r + 8, ri_next);
        m_link_at(ri_next);
        callsub s_before_write(la_r - ab, 8);
        ri_r = bw_r;
        if (bw_r == 0) {
            store64(la_r, Zoff_ri);
            m_link_at(Zanchor_ri);
            callsub s_before_write(la_r - ab + 8, 8);
            ri_r = bw_r;
            if (bw_r == 0) {
                store64(la_r + 8, Zoff_ri);
            }
        }
    }
}

# allocate(room) -> al_r (status), al_at (offset)
sub s_allocate(Zbytes_allocate) {
    var al_room;
    var al_total;
    var al_anchor;
    var al_walk;
    var al_guard;
    var al_span;
    var al_best;
    var al_best_span;
    var al_best_mark;
    var al_found;
    var al_mark;
    var al_next;
    var al_split;
    var al_gen;
    var al_rest;
    var al_prev;
    var al_keep;
    var al_ph;
    var al_nh;
    al_r = 5;
    al_at = 0;
    if (Zbytes_allocate <= 281474976710655) {
        al_room = (Zbytes_allocate + 7) & ~7;
        al_total = 24 + al_room;
        al_anchor = load64(ab + 8);
        al_best = 0;
        al_best_span = 0;
        al_best_mark = 0;
        al_found = 0;
        al_walk = al_anchor;
        al_guard = (load64(ab + 16) / 40) + 2;
        while (al_guard > 0) {
            al_guard = al_guard - 1;
            m_span_of(al_walk);
            al_span = sn2_r;
            al_mark = 0;
            if (al_walk == al_anchor) {
                al_mark = 1;
            }
            if (al_span >= al_total) {
                if (al_mark == 0 | al_span >= al_total + 40) {
                    if (al_found == 0 | al_span < al_best_span) {
                        al_best = al_walk;
                        al_best_span = al_span;
                        al_best_mark = al_mark;
                        al_found = 1;
                    }
                }
            }
            m_link_at(al_walk);
            al_next = load64(la_r + 8);
            if (al_next == al_anchor) {
                al_guard = 0;
            } else {
                al_walk = al_next;
            }
        }
        if (al_found == 0) {
            aneed = al_anchor + al_total;
            al_r = 1;
        } else {
            al_split = 0;
            if (al_best_span - al_total >= 40) {
                al_split = 1;
            }
            al_keep = al_total;
            if (al_split == 1) {
                al_keep = al_total + 40;
            }
            m_ensure(al_best + al_keep);
            al_r = en_r;
            if (en_r == 0) {
                if (al_split == 1) {
                    al_rest = al_best + al_total;
                    m_link_at(al_best);
                    al_prev = load64(la_r);
                    al_next = load64(la_r + 8);
                    # A span that links to itself (the ring anchor, or a lone free
                    # span) has to point at the remainder instead: the taken span
                    # stops being a ring member, and copying the old links would
                    # leave the ring walking into the object that replaced it.
                    al_ph = al_prev;
                    al_nh = al_next;
                    if (al_prev == al_best) {
                        al_ph = al_rest;
                    }
                    if (al_next == al_best) {
                        al_nh = al_rest;
                    }
                    callsub s_before_write(al_rest - ab, 40);
                    al_r = bw_r;
                    if (bw_r == 0) {
                        callsub s_zero(ab + al_rest, 40);
                        store16(ab + al_rest, 65535);
                        store32(ab + al_rest + 20, al_best_span - al_total - 24);
                        m_link_at(al_rest);
                        store64(la_r, al_ph);
                        store64(la_r + 8, al_nh);
                        if (al_ph != al_rest) {
                            m_link_at(al_prev);
                            callsub s_before_write(la_r - ab + 8, 8);
                            al_r = bw_r;
                            if (bw_r == 0) {
                                store64(la_r + 8, al_rest);
                            }
                        }
                        if (al_nh != al_rest & al_r == 0) {
                            m_link_at(al_nh);
                            callsub s_before_write(la_r - ab, 8);
                            al_r = bw_r;
                            if (bw_r == 0) {
                                store64(la_r, al_rest);
                            }
                        }
                        if (al_best_mark == 1 & al_r == 0) {
                            callsub s_before_write(8, 8);
                            al_r = bw_r;
                            if (bw_r == 0) {
                                store64(ab + 8, al_rest);
                            }
                        }
                    }
                } else {
                    if (al_best_mark == 1) {
                        al_r = 3;
                    } else {
                        callsub s_ring_unlink(al_best);
                        al_r = ru_r;
                        al_room = al_best_span - 24;
                    }
                }
                if (al_r == 0) {
                    # The generation of a reused span is its previous occupant's
                    # plus one (ObjectArena::s_allocate's next_gen, docs/32 1.2):
                    # the span's gen word is read before the record is zeroed, and
                    # 0 -- the fresh tail -- answers 1.
                    al_gen = (load16(ab + al_best + 2) + 1) & 4095;
                    if (al_gen == 0) {
                        al_gen = 1;
                    }
                    callsub s_before_write(al_best - ab, 24);
                    al_r = bw_r;
                    if (bw_r == 0) {
                        callsub s_zero(ab + al_best, 24);
                        callsub s_zero(ab + al_best + 24, al_room);
                        store32(ab + al_best + 20, al_room);
                        al_at = al_best;
                    }
                }
            }
        }
    }
}

# release(offset) -> rl2_r: the span returns to the FREE ring.
sub s_release(Zoff_rel) {
    var rel_span;
    var rel_gen;
    var rel_marker;
    var rel_mspan;
    var rel_prev;
    var rel_next;
    var rel_room;
    rl2_r = 3;
    if (Zoff_rel >= 4096) {
        if (Zoff_rel < load64(ab + 8)) {
            if ((Zoff_rel & 7) == 0) {
                m_span_of(Zoff_rel);
                rel_span = sn2_r;
                if (load16(ab + Zoff_rel) != 65535) {
                    if (Zoff_rel + rel_span <= load64(ab + 8)) {
                        rel_gen = load16(ab + Zoff_rel + 2);
                        rl2_r = 0;
                        if (Zoff_rel + rel_span == load64(ab + 8)) {
                            rel_marker = load64(ab + 8);
                            m_span_of(rel_marker);
                            rel_mspan = sn2_r;
                            m_link_at(rel_marker);
                            rel_prev = load64(la_r);
                            rel_next = load64(la_r + 8);
                            callsub s_before_write(8, 8);
                            rl2_r = bw_r;
                            if (bw_r == 0) {
                                store64(ab + 8, Zoff_rel);
                                callsub s_before_write(Zoff_rel, 40);
                                rl2_r = bw_r;
                                if (bw_r == 0) {
                                    callsub s_zero(ab + Zoff_rel, 40);
                                    store16(ab + Zoff_rel, 65535);
                                    store16(ab + Zoff_rel + 2, rel_gen);
                                    store32(ab + Zoff_rel + 20, rel_span + rel_mspan - 24);
                                    m_link_at(Zoff_rel);
                                    if (rel_prev == rel_marker) {
                                        store64(la_r, Zoff_rel);
                                        store64(la_r + 8, Zoff_rel);
                                    } else {
                                        store64(la_r, rel_prev);
                                        store64(la_r + 8, rel_next);
                                        m_link_at(rel_prev);
                                        callsub s_before_write(la_r - ab + 8, 8);
                                        rl2_r = bw_r;
                                        if (bw_r == 0) {
                                            store64(la_r + 8, Zoff_rel);
                                            m_link_at(rel_next);
                                            callsub s_before_write(la_r - ab, 8);
                                            rl2_r = bw_r;
                                            if (bw_r == 0) {
                                                store64(la_r, Zoff_rel);
                                            }
                                        }
                                    }
                                }
                            }
                        } else {
                            rel_room = rel_span - 24;
                            callsub s_before_write(Zoff_rel + 24, 16);
                            rl2_r = bw_r;
                            if (bw_r == 0) {
                                callsub s_zero(ab + Zoff_rel + 24, 16);
                                callsub s_before_write(Zoff_rel, 4);
                                rl2_r = bw_r;
                                if (bw_r == 0) {
                                    store16(ab + Zoff_rel, 65535);
                                    store16(ab + Zoff_rel + 2, rel_gen);
                                    if (rel_span >= 40) {
                                        callsub s_ring_insert_after(load64(ab + 8), Zoff_rel);
                                        rl2_r = ri_r;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# ---- the skeleton: a fresh arena, a cold attach ------------------------------------------


# attach() -> at_r: the arena that is in the region already (docs/32 5.3: the gate).
sub s_attach() {
    var at_slots;
    at_r = 3;
    if (ab != 0) {
        if (acomm >= 4096) {
            if (load8(ab) == 82 & load8(ab + 1) == 88 & load8(ab + 2) == 70 & load8(ab + 3) == 65) {
                if (load32(ab + 4) == 1) {
                    if (load64(ab + 8) <= load64(ab + 16)) {
                        if (load64(ab + 8) + 40 <= acomm) {
                            ah = ab;
                            m_entry(0);
                            at_slots = load32(ab + 4124);
                            if (load32(ab + 4120) > 0) {
                                if (load32(ab + 4120) <= at_slots) {
                                    if (load64(sp_r + 8) == 4096) {
                                        if (load16(ab + 4096) == load16(sp_r)) {
                                            m_entry(1);
                                            asyms = ab + load64(sp_r + 8) + 24;
                                            src_syms = asyms;
                                            aspec = 0;
                                            at_r = 0;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if (at_r == 0) {
        arel = 0;
        aspec = 0;
        m_lit_sys();
        callsub s_named_child(load32(ab + 24), lit, 3);
        at_sys = cn_at;
        if (at_sys != 4294967295) {
            m_lit_specs();
            callsub s_named_child(at_sys, lit, 5);
            if (cn_at != 4294967295) {
                callsub s_rec(cn_at);
                if (ce_r != 0) {
                    aspec = ce_r + 24;
                }
            }
            m_lit_relations();
            callsub s_named_child(at_sys, lit, 9);
            arel = cn_at;
        }
    }
}

# named_child(parent, text, len) -> cn_at: the handle32 of that child, or 0xFFFFFFFF.
sub s_named_child(Zparent_cn, Zp_cn, Zn_cn) {
    var cn_mod;
    var cn_walk;
    var cn_rec;
    var cn_name;
    var cn_i;
    var cn_ok;
    cn_at = 4294967295;
    callsub s_rec(Zparent_cn);
    cn_mod = ce_r;
    if (cn_mod != 0) {
        if (load16(cn_mod) == 1) {
            cn_walk = load32(cn_mod + 24);
            while (cn_walk != 4294967295 & cn_at == 4294967295) {
                callsub s_rec(cn_walk);
                cn_rec = ce_r;
                if (cn_rec == 0) {
                    cn_walk = 4294967295;
                } else {
                    callsub s_sym_addr(load16(cn_rec + 6));
                    cn_name = sa_r;
                    cn_ok = 0;
                    if (cn_name != 0) {
                        cn_ok = 1;
                        cn_i = 0;
                        while (cn_i < Zn_cn & cn_ok == 1) {
                            if (load8(cn_name + cn_i) != load8(Zp_cn + cn_i)) {
                                cn_ok = 0;
                            }
                            cn_i = cn_i + 1;
                        }
                        if (load8(cn_name + Zn_cn) != 0) {
                            cn_ok = 0;
                        }
                    }
                    if (cn_ok == 1) {
                        cn_at = cn_walk;
                    } else {
                        cn_walk = load32(cn_rec + 12);
                    }
                }
            }
        }
    }
}

# The names this model looks up by (docs/32 2): the system namespace and its relation tables.
macro m_lit_sys() {
    store8(lit, 115); store8(lit + 1, 121); store8(lit + 2, 115);
}

# The names the bootstrap lays down, in the order it interns them (docs/32 5.4):
# the symbol ids are part of the bytes, so this order is not free.
macro m_lit_objects() {
    store8(lit, 111); store8(lit + 1, 98); store8(lit + 2, 106); store8(lit + 3, 101);
    store8(lit + 4, 99); store8(lit + 5, 116); store8(lit + 6, 115);
}

macro m_lit_functions() {
    store8(lit, 102); store8(lit + 1, 117); store8(lit + 2, 110); store8(lit + 3, 99);
    store8(lit + 4, 116); store8(lit + 5, 105); store8(lit + 6, 111); store8(lit + 7, 110);
    store8(lit + 8, 115);
}

macro m_lit_journal() {
    store8(lit, 106); store8(lit + 1, 111); store8(lit + 2, 117); store8(lit + 3, 114);
    store8(lit + 4, 110); store8(lit + 5, 97); store8(lit + 6, 108);
}

macro m_lit_caps() {
    store8(lit, 99); store8(lit + 1, 97); store8(lit + 2, 112); store8(lit + 3, 115);
}

macro m_lit_free() {
    store8(lit, 102); store8(lit + 1, 114); store8(lit + 2, 101); store8(lit + 3, 101);
}

macro m_lit_syms() {
    store8(lit, 115); store8(lit + 1, 121); store8(lit + 2, 109); store8(lit + 3, 115);
}

macro m_lit_specs() {
    store8(lit, 115); store8(lit + 1, 112); store8(lit + 2, 101); store8(lit + 3, 99);
    store8(lit + 4, 115);
}

macro m_lit_relations() {
    store8(lit, 114); store8(lit + 1, 101); store8(lit + 2, 108); store8(lit + 3, 97);
    store8(lit + 4, 116); store8(lit + 5, 105); store8(lit + 6, 111); store8(lit + 7, 110);
    store8(lit + 8, 115);
}

# ---- the symbol table (sys/syms, docs/32 2) ---------------------------------------------

# intern(text, n) -> it_r (status), it_id (the symbol id)
sub s_intern(Ztext, Zn) {
    var it_head;
    var it_count;
    var it_need;
    var it_used;
    var it_off;
    var it_i;
    it_r = 0;
    it_id = 0;
    if (Zn != 0) {
        it_head = asyms;
        it_count = load32(it_head);
        it_i = 1;
        while (it_i < it_count & it_id == 0) {
            it_off = load32(it_head + 8 + 4 * it_i);
            if (load8(it_head + it_off + Zn) == 0) {
                callsub s_cmp(it_head + it_off, Ztext, Zn);
                if (cmp_r == 0) {
                    it_id = it_i;
                }
            }
            it_i = it_i + 1;
        }
        if (it_id == 0) {
            it_need = Zn + 1;
            # Where the strings begin - and, once there are any, just past the last
            # one. Id 0 is anonymous and stores nothing, so the first name starts at
            # the end of the offset table (docs/32 2) and not at whatever offsets[0]
            # happens to hold.
            it_used = 8 + 4 * load32(it_head + 4);
            if (it_count > 1) {
                it_off = load32(it_head + 8 + 4 * (it_count - 1));
                it_i = 0;
                while (it_i < 65536 & load8(it_head + it_off + it_i) != 0) {
                    it_i = it_i + 1;
                }
                it_used = it_off + it_i + 1;
            }
            # Out of ids or out of room: the table moves to a bigger object and
            # the append continues there (docs/32 2).
            if (it_count >= load32(it_head + 4)) {
                callsub s_syms_grow();
                it_r = sg_r;
            } else {
                if (it_used + it_need > load32(asyms - 24 + 20)) {
                    callsub s_syms_grow();
                    it_r = sg_r;
                }
            }
            if (it_r == 0) {
                it_head = asyms;
                it_count = load32(it_head);
                it_used = 8 + 4 * load32(it_head + 4);
                if (it_count > 1) {
                    it_off = load32(it_head + 8 + 4 * (it_count - 1));
                    it_i = 0;
                    while (it_i < 65536 & load8(it_head + it_off + it_i) != 0) {
                        it_i = it_i + 1;
                    }
                    it_used = it_off + it_i + 1;
                }
                # The name that triggered the growth still has to fit: the check
                # above ran against the OLD table's room.
                if (it_used + it_need > load32(asyms - 24 + 20)) {
                    it_r = 3;
                }
                callsub s_before_write(it_head + it_used - ab, it_need);
                it_r = bw_r;
                if (bw_r == 0) {
                    callsub s_cpy(it_head + it_used, Ztext, Zn);
                    store8(it_head + it_used + Zn, 0);
                    callsub s_before_write(it_head + 8 + 4 * it_count - ab, 4);
                    it_r = bw_r;
                    if (bw_r == 0) {
                        store32(it_head + 8 + 4 * it_count, it_used);
                        callsub s_before_write(it_head - ab, 4);
                        it_r = bw_r;
                        if (bw_r == 0) {
                            store32(it_head, it_count + 1);
                            it_id = it_count;
                        }
                    }
                }
            }
        }
    }
}

# rel_table_make(handle, rows) -> rm_r (status), rm_h (the table): the relation
# table of an object, created when a delta names refs an object did not have. The
# table is named by the object's path (docs/32 5.2), which is why the path writer
# runs first; the derived index gets the word so the next lookup is one read.
sub s_rel_table_make(Zh_rm, Zrows_rm) {
    var rm_buf;
    var rm_len;
    var rm_at;
    var rm_ix;
    var rm_gen;
    rm_r = 0;
    rm_h = 0;
    if (arel != 0) {
        callsub s_take(512);
        rm_buf = tk_r;
        if (rm_buf != 0) {
            m_path_write(Zh_rm, rm_buf, 512);
            rm_len = pw2_r;
            if (rm_len != 0) {
                callsub s_named_child(arel, rm_buf, rm_len);
                if (cn_at != 4294967295) {
                    rm_h = cn_at;
                } else {
                    rm_ix = load32(ab + 4120);
                    if (rm_ix >= load32(ab + 4124)) {
                        rm_r = 4;
                    } else {
                        callsub s_allocate(24 * Zrows_rm);
                        rm_r = al_r;
                        if (al_r == 0) {
                            rm_at = al_at;
                            rm_gen = 1;
                            callsub s_before_write(rm_at - ab, 24);
                            rm_r = bw_r;
                            if (bw_r == 0) {
                                callsub s_zero(ab + rm_at, 24);
                                callsub s_intern(rm_buf, rm_len);
                                rm_r = it_r;
                                store16(ab + rm_at, 4);
                                store16(ab + rm_at + 2, rm_gen);
                                store16(ab + rm_at + 6, it_id);
                                store32(ab + rm_at + 8, arel);
                                store32(ab + rm_at + 12, 4294967295);
                                store32(ab + rm_at + 20, 24 * Zrows_rm);
                                m_entry(rm_ix);
                                callsub s_before_write(sp_r - ab, 16);
                                rm_r = bw_r;
                                if (bw_r == 0) {
                                    store16(sp_r, 4);
                                    store16(sp_r + 2, rm_gen);
                                    store32(sp_r + 4, 0);
                                    store64(sp_r + 8, rm_at);
                                    callsub s_before_write(4120, 4);
                                    rm_r = bw_r;
                                    if (bw_r == 0) {
                                        store32(ab + 4120, rm_ix + 1);
                                        rm_h = ((rm_gen & 4095) << 20) | (rm_ix & 1048575);
                                        if (rm_ix < slts) {
                                            store32(raddr + 4 * rm_ix, rm_h);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# syms_grow() -> sg_r (status): move sys/syms to a bigger object (docs/32 2).
# The growth is the policy of ObjectArena::intern, and it has to be: the layout of
# an image records the sequence of its allocations, so a dump that grew by another
# rule would answer other bytes.
sub s_syms_grow() {
    var sg_head;
    var sg_old;
    var sg_cap;
    var sg_newcap;
    var sg_room;
    var sg_used;
    var sg_n;
    var sg_i;
    var sg_off;
    var sg_at;
    var sg_new;
    sg_r = 0;
    sg_head = asyms;
    sg_old = sg_head - 24;
    sg_n = load32(sg_head);
    sg_cap = load32(sg_head + 4);
    sg_used = 8 + 4 * sg_cap;
    if (sg_n > 1) {
        sg_off = load32(sg_head + 8 + 4 * (sg_n - 1));
        sg_i = 0;
        while (sg_i < 65536 & load8(sg_head + sg_off + sg_i) != 0) {
            sg_i = sg_i + 1;
        }
        sg_used = sg_off + sg_i + 1;
    }
    # The capacity doubles (ObjectArena::intern: head->capacity * 2, and at
    # least count + 1): a growth is a load factor on the room the table was
    # given, not on the names it happens to hold. Doubling the count instead
    # grows a half-full table not at all and a full one past twice, and the
    # layout of a dump that grew by another rule is another layout: the arena
    # would answer other bytes than the writer's.
    sg_newcap = 2 * sg_cap;
    if (sg_n + 1 > sg_newcap) {
        sg_newcap = sg_n + 1;
    }
    # The room is the engine's own formula (ObjectArena::intern: used + need,
    # floored at twice the old payload): the new offset table's growth is covered
    # by the doubling floor, not added here -- a span sized by any other rule is
    # a different span, and every later allocation lands somewhere else.
    sg_room = sg_used + it_need;
    if (sg_room < 2 * load32(sg_old + 20)) {
        sg_room = 2 * load32(sg_old + 20);
    }
    callsub s_allocate(sg_room);
    sg_r = al_r;
    if (al_r == 0) {
        sg_at = al_at;
        sg_new = sg_at + 24;
        callsub s_before_write(sg_at - ab, sg_room + 24);
        sg_r = bw_r;
        if (bw_r == 0) {
            callsub s_zero(ab + sg_at, sg_room + 24);
            store32(ab + sg_new, sg_n);
            store32(ab + sg_new + 4, sg_newcap);
            # the strings move up by the growth of the offset table
            sg_i = 1;
            while (sg_i < sg_n & sg_r == 0) {
                sg_off = load32(sg_head + 8 + 4 * sg_i);
                # An offset below the string area names the table's own header,
                # not a name. Copying through it runs past the span and corrupts
                # whatever the arena put beside it, so a table that cannot be
                # read is refused instead of rebuilt into a broken one.
                if (sg_off < 8 + 4 * sg_cap) {
                    sg_r = 3;
                }
                if (sg_r == 0) {
                    callsub s_len(sg_head + sg_off);
                    callsub s_cpy(ab + sg_new + 8 + 4 * sg_newcap + (sg_off - (8 + 4 * sg_cap)),
                                  sg_head + sg_off, len_r + 1);
                    store32(ab + sg_new + 8 + 4 * sg_i,
                            8 + 4 * sg_newcap + (sg_off - (8 + 4 * sg_cap)));
                }
                sg_i = sg_i + 1;
            }
            m_entry(1);
            # The identity moves to the new span whole (ObjectArena::syms_relocate):
            # the handle stands -- callers hold handles, nothing outside the arena
            # knows addresses (docs/32) -- so the record's own words and the index
            # entry's kind and generation come with it. The generation is the one
            # the handle already speaks (the engine keeps the old record's gen, so
            # the handle that named the table names it still); a span whose header
            # the zeroing left reads kind 0 is a broken one -- every later lookup
            # of a name dies on the kind the slot says against the record's own.
            callsub s_before_write(sg_at - ab, 24);
            if (bw_r == 0) {
                store16(ab + sg_at, 5);
                store16(ab + sg_at + 2, load16(sg_old + 2));
                store16(ab + sg_at + 4, load16(sg_old + 4));
                store16(ab + sg_at + 6, load16(sg_old + 6));
                store32(ab + sg_at + 8, load32(sg_old + 8));
                store32(ab + sg_at + 12, load32(sg_old + 12));
                store32(ab + sg_at + 16, load32(sg_old + 16));
                store32(ab + sg_at + 20, al_room);
            }
            callsub s_before_write(sp_r - ab, 16);
            sg_r = bw_r;
            if (bw_r == 0) {
                store16(sp_r, 5);
                store16(sp_r + 2, load16(sg_old + 2));
                store64(sp_r + 8, sg_at);
                asyms = ab + sg_new;
                callsub s_release(sg_old - ab);
                sg_r = 0;
            }
        }
    }
}

# ---- the object life cycle: create, destroy, resize --------------------------------------

# create() from the cs_* words -> cr_r (status), cr_h (handle32)
sub s_create() {
    var cr_at;
    var cr_ix;
    var cr_gen;
    var cr_free;
    var cr_spc;
    cr_r = 5;
    cr_h = 4294967295;
    if (cs_payload <= 281474976710655) {
        cr_ix = load32(ab + 4120);
        # Walk from the cursor, not from the first slot: a create is then O(1)
        # over a run of them, and a release lowers the cursor again so the slot
        # is found by the next create.
        cr_free = 0;
        cr_at = acursor;
        if (cr_at > cr_ix) {
            cr_at = cr_ix;
        }
        while (cr_at < cr_ix & cr_free == 0) {
            m_entry(cr_at);
            if (load64(sp_r + 8) == 0) {
                cr_free = 1;
            } else {
                cr_at = cr_at + 1;
            }
        }
        if (cr_free == 1 | cr_ix < load32(ab + 4124)) {
            callsub s_intern(cs_name, cs_name_len);
            cr_r = it_r;
            if (it_r == 0) {
                # The room is the payload's alone (ObjectArena::create:
                # s_allocate adds the 24 of the record header), rounded to the
                # 8 of a slot - a caller that adds another 24 here takes 24
                # waste per object, and a dump that laid its objects out with
                # room the writer never gave answers other bytes than the
                # export's.
                callsub s_allocate((cs_payload + 7) & ~7);
                cr_r = al_r;
                if (al_r == 0) {
                    # The generation is the span's (ObjectArena::create reads it off
                    # the record s_allocate made): a create that reuses a freed
                    # span answers its previous occupant's gen + 1, and the handles
                    # the record and the index entry share stay stale-proof.
                    cr_gen = al_gen;
                    callsub s_before_write(al_at - ab, 24);
                    cr_r = bw_r;
                    if (bw_r == 0) {
                        callsub s_zero(ab + al_at, 24);
                        store16(ab + al_at, cs_kind);
                        store16(ab + al_at + 2, cr_gen);
                        store16(ab + al_at + 6, it_id);
                        store32(ab + al_at + 8, cs_parent);
                        store32(ab + al_at + 12, 4294967295);
                        store32(ab + al_at + 16, cs_refc);
                        store32(ab + al_at + 20, cs_payload);
                        if (cr_free == 1) {
                            cr_ix = cr_at;
                        }
                        m_entry(cr_ix);
                        callsub s_before_write(sp_r - ab, 16);
                        cr_r = bw_r;
                        if (bw_r == 0) {
                            # The slot publishes the record's own kind and
                            # generation (ObjectArena::create): the handle's
                            # two faces agree, and a reader that checks one
                            # against the other finds the same object.
                            store16(sp_r, cs_kind);
                            store16(sp_r + 2, cr_gen);
                            store32(sp_r + 4, 0);
                            store64(sp_r + 8, al_at);
                            if (cr_free == 0) {
                                callsub s_before_write(ab + 4120 - ab, 4);
                                cr_r = bw_r;
                                if (bw_r == 0) {
                                    store32(ab + 4120, cr_ix + 1);
                                }
                            }
                            cr_h = ((cr_gen & 4095) << 20) | (cr_ix & 1048575);
                            if (cs_kind == 1) {
                                # A module's chain head is the empty chain
                                # (HANDLE32_NONE), not a zeroed payload: 0 is the
                                # handle of the object at index 0 and would put the
                                # first child behind that.
                                callsub s_before_write(al_at + 24 - ab, 8);
                                if (bw_r == 0) {
                                    store32(ab + al_at + 24, 4294967295);
                                    store32(ab + al_at + 28, 0);
                                }
                            }
                            # The child goes at the end of its parent's chain
                            # (docs/32 1.2): that chain is what find and children
                            # walk, and a child that is not on it does not exist to
                            # them. Modules only - a leaf has no chain head.
                            if (cs_parent != 4294967295) {
                                callsub s_rec(cs_parent);
                                cl_mod = ce_r;
                                if (cl_mod != 0) {
                                    if (load16(cl_mod) == 1) {
                                        cl_head = cl_mod + 24;
                                        cl_walk = load32(cl_head);
                                        if (cl_walk == 4294967295) {
                                            callsub s_before_write(cl_head - ab, 8);
                                            if (bw_r == 0) {
                                                store32(cl_head, cr_h);
                                                store32(cl_head + 4, load32(cl_head + 4) + 1);
                                            }
                                        } else {
                                            cl_stop = 0;
                                            while (cl_stop == 0) {
                                                callsub s_rec(cl_walk);
                                                cl_next = ce_r;
                                                if (cl_next == 0) {
                                                    cl_stop = 1;
                                                } else {
                                                    if (load32(cl_next + 12) == 4294967295) {
                                                        callsub s_before_write(cl_next + 12 - ab, 8);
                                                        if (bw_r == 0) {
                                                            store32(cl_next + 12, cr_h);
                                                            store32(cl_head + 4, load32(cl_head + 4) + 1);
                                                        }
                                                        cl_stop = 1;
                                                    } else {
                                                        cl_walk = load32(cl_next + 12);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            # A semantic row can only be written where sys/specs is;
                            # the bootstrap makes objects before that table exists
                            # (docs/32 5.4) and fills their rows afterwards.
                            # A semantic row only exists where sys/specs does; the
                            # bootstrap makes objects before that table and a later
                            # pass fills their rows (docs/32 5.4).
                            if ((cr_r == 0) & (aspec != 0)) {
                                cr_spc = aspec + 24 * cr_ix;
                                callsub s_before_write(cr_spc - ab, 24);
                                cr_r = bw_r;
                                if (bw_r == 0) {
                                    store32(cr_spc, 4294967295);
                                    store32(cr_spc + 4, cs_flags);
                                    store32(cr_spc + 8, cs_index);
                                    store32(cr_spc + 12, 0);
                                    store64(cr_spc + 16, cs_generation);
                                }
                            }
                            if (cr_free == 1) {
                                if (cr_at < acursor) {
                                    acursor = cr_at;
                                }
                            } else {
                                acursor = cr_ix + 1;
                            }
                            if ((cr_r == 0) & (cs_refs != 0)) {
                                # The refs of an object live in a table named after
                                # its path (docs/32 5.2); an object a delta makes
                                # with refs needs that table made with it.
                                callsub s_rel_table_make(cr_h, cs_refs);
                                cr_r = rm_r;
                            }
                        }
                    }
                }
            }
        }
    }
}

# destroy(handle) -> de_r: the span frees, the index entry dies, the spec row resets.
macro m_destroy(Zh) {
    var de_off;
    var de_ix;
    var de_spc;
    callsub s_rec(Zh);
    de_r = 2;
    if (ce_r != 0) {
        de_off = ce_r - ab;
        de_ix = Zh & 1048575;
        m_entry(de_ix);
        callsub s_before_write(sp_r - ab, 16);
        de_r = bw_r;
        if (bw_r == 0) {
            store16(sp_r, 0);
            store16(sp_r + 2, 0);
            store64(sp_r + 8, 0);
            de_spc = aspec + 24 * de_ix;
            callsub s_before_write(de_spc - ab, 24);
            de_r = bw_r;
            if (bw_r == 0) {
                store32(de_spc, 4294967295);
                store32(de_spc + 4, 0);
                store32(de_spc + 8, 0);
                store32(de_spc + 12, 0);
                store64(de_spc + 16, 0);
                callsub s_release(de_off);
                de_r = rl2_r;
            }
        }
    }
}

# resize(handle, payload, refs) -> rz_r: the value grows or shrinks, the refs follow the
# relation tables (docs/32 5.2) and this only re-rooms the payload.
sub s_resize(Zh_resize, Zp_resize, Zr_resize) {
    var rz_off;
    var rz_keep;
    var rz_new;
    var rz_gen;
    callsub s_rec(Zh_resize);
    rz_r = 2;
    if (ce_r != 0) {
        rz_r = 5;
        if (Zp_resize <= 281474976710655) {
            rz_off = ce_r - ab;
            rz_keep = load32(ce_r + 20);
            rz_gen = load16(ce_r + 2);
            # The room is the payload's (the header is s_allocate's): the same
            # formula the create answers, or a re-grown record lands 24 past
            # the room the writer would have given it.
            callsub s_allocate((Zp_resize + 7) & ~7);
            rz_r = al_r;
            if (al_r == 0) {
                rz_new = al_at;
                callsub s_before_write(rz_new - ab, 24);
                rz_r = bw_r;
                if (bw_r == 0) {
                    callsub s_cpy(ab + rz_new, ab + rz_off, 24);
                    store32(ab + rz_new + 20, Zp_resize);
                    if (rz_keep > Zp_resize) {
                        rz_keep = Zp_resize;
                    }
                    callsub s_before_write(rz_new + 24 - ab, rz_keep);
                    rz_r = bw_r;
                    if (bw_r == 0) {
                        callsub s_cpy(ab + rz_new + 24, ab + rz_off + 24, rz_keep);
                        callsub s_write_slot(Zh_resize, rz_new);
                        rz_r = ws_r;
                        if (ws_r == 0) {
                            callsub s_release(rz_off);
                            rz_r = rl2_r;
                        }
                    }
                }
            }
        }
    }
}

# ---- the undo log (docs/19): 64-byte granules, one record of 72 bytes each ----------------------

# ensure_log(end) -> el_r: a log region committed whole.
sub s_ensure_log(Zend_ensure_log) {
    if (Zend_ensure_log <= alog_comm) {
        el_r = 0;
    } else {
        el_r = 12;
    }
}

# begin(log_base, log_comm, log_lim) -> bg_r
macro m_begin(Zlb, Zlc, Zll) {
    bg_r = 13;
    if (aj == 0) {
        bg_r = 3;
        if (ah != 0 & Zlb != 0) {
            alog_base = Zlb;
            alog_comm = Zlc;
            alog_lim = Zll;
            amark = alim;
            abitmap = ((amark / 512 + 1) + 7) & ~7;
            callsub s_ensure_log(abitmap);
            bg_r = el_r;
            if (el_r == 0) {
                callsub s_zero(alog_base, abitmap);
                aused = abitmap;
                callsub s_cpy(saved, ah, 192);
                aj = 1;
            }
        }
    }
}

# before_write(offset, length) -> bw_r
sub s_before_write(Zoff_before_write, Zlen_before_write) {
    var bw_end;
    var bw_off;
    var bw_g;
    var bw_stop;
    var bw_bits;
    var bw_bit;
    var bw_from;
    var bw_size;
    bw_r = 0;
    if (aj != 0) {
        if (Zlen_before_write != 0) {
            bw_end = Zoff_before_write + Zlen_before_write;
            if (bw_end > amark) {
                bw_end = amark;
            }
            bw_off = Zoff_before_write;
            if (bw_off < 32) {
                bw_off = 32;
            }
            if (bw_end > bw_off) {
                bw_g = bw_off / 64;
                bw_stop = 0;
                bw_r = 0;
                while (bw_g * 64 < bw_end & bw_stop == 0) {
                    bw_bits = load8(alog_base + bw_g / 8);
                    bw_bit = 1 << (bw_g % 8);
                    if ((bw_bits & bw_bit) != 0) {
                        bw_g = bw_g + 1;
                    } else {
                        callsub s_ensure_log(aused + 72);
                        if (el_r != 0) {
                            bw_r = 12;
                            bw_stop = 1;
                        } else {
                            bw_from = bw_g * 64;
                            bw_size = 64;
                            if (bw_from + 64 > amark) {
                                bw_size = amark - bw_from;
                            }
                            store64(alog_base + aused, bw_g);
                            callsub s_cpy(alog_base + aused + 8, ab + bw_from, bw_size);
                            aused = aused + 72;
                            store8(alog_base + bw_g / 8, bw_bits | bw_bit);
                            bw_g = bw_g + 1;
                        }
                    }
                }
            }
        }
    }
}

macro m_commit() {
    cm_r = 13;
    if (aj != 0) {
        aj = 0;
        cm_r = 0;
    }
}

macro m_rollback() {
    var rb_at;
    var rb_g;
    var rb_from;
    var rb_size;
    var rb_lim;
    rb_r = 13;
    if (aj != 0) {
        rb_at = abitmap;
        while (rb_at < aused) {
            rb_g = load64(alog_base + rb_at);
            rb_from = rb_g * 64;
            rb_size = 64;
            if (rb_from + 64 > amark) {
                rb_size = amark - rb_from;
            }
            callsub s_cpy(ab + rb_from, alog_base + rb_at + 8, rb_size);
            rb_at = rb_at + 72;
        }
        # The limit is the seat's region and is not undoable arena state; the
        # committed boundary is, and comes back with the saved superblock.
        rb_lim = load64(ah + 16);
        callsub s_cpy(ah, saved, 192);
        store64(ah + 16, rb_lim);
        aj = 0;
        rb_r = 0;
    }
}

# payload_w / refs_w: the writable value and reference rows; 0 when the log says
# no. The record itself is never written through these - its fields have their own
# setters, because what a reader calls the cell is the record and a spec row
# (docs/32 5.3) and only the value bytes and the rows live in one place.
sub s_payload_w(Zh_payload_w) {
    var pw_rec;
    callsub s_rec(Zh_payload_w);
    pw_r = 0;
    if (ce_r != 0) {
        pw_rec = ce_r;
        callsub s_before_write(pw_rec + 24 - ab, load32(pw_rec + 20));
        if (bw_r == 0) {
            pw_r = pw_rec + 24;
        }
    }
}

sub s_refs_w(Zh_refs_w) {
    var rw_rec;
    var rw_room;
    callsub s_rel_rows(Zh_refs_w);
    rw_r = 0;
    if (rt_at != 0) {
        rw_rec = rt_at - 24;
        rw_room = load32(rw_rec + 20) / 24;
        callsub s_before_write(rt_at - ab, 24 * rw_room);
        if (bw_r == 0) {
            rw_r = rt_at;
        }
    }
}

# init(base, committed, limit, capacity, name, name_len) -> in_r: a fresh arena.
# This is ObjectArena::bootstrap replayed whole (docs/32 5.4): the object index at
# byte 4096, sys/syms, the root image, sys and its leaves in their order. The
# symbol ids are part of the bytes, so the interning order is not free - the index
# object is named `objects` third and `syms` is named last - and s_create interns
# a name as it makes the object, which is what puts the order back.
sub s_init(Zbase, Zcomm, Zlim, Zcap, Zname, Znlen) {
    var in_slots;
    var in_syms_at;
    var in_at;
    var in_need;
    var in_root;
    var in_sys;
    var in_i;
    ab = Zbase;
    acomm = Zcomm;
    alim = Zlim;
    ah = Zbase;
    aneed = 0;
    # The new arena is being built, not journaled: the undo log of the source it
    # is being built from must not cover these writes, and s_before_write would
    # otherwise record them there and refuse once it is full.
    aj = 0;
    asyms = 0;
    aspec = 0;
    arel = 0;
    raddr = 0;
    acursor = 0;
    in_r = 5;
    in_slots = Zcap;
    if (in_slots < 4) {
        in_slots = 4;
    }
    if (in_slots <= 1048576) {
        in_need = 4096 + 24 + 8 + 16 * in_slots + 24 + 8 + 4 * 32 + 256 + 40;
        m_ensure(in_need);
        in_r = en_r;
        if (en_r == 0) {
            callsub s_zero(ab, in_need);
            store8(ab, 82); store8(ab + 1, 88); store8(ab + 2, 70); store8(ab + 3, 65);
            store32(ab + 4, 1);
            store64(ab + 8, 4096);
            store64(ab + 16, alim);
            store32(ab + 24, 4294967295);
            store32(ab + 28, 4294967295);

            # The end marker: the FREE ring anchor that covers the tail.
            in_at = 4096;
            store16(ab + in_at, 65535);
            store32(ab + in_at + 20, alim - in_at - 24);
            store64(ab + in_at + 24, in_at);
            store64(ab + in_at + 32, in_at);

            # The object index: the first object of the arena, at its own entry.
            callsub s_allocate(8 + 16 * in_slots);
            in_r = al_r;
            if (al_r == 0) {
                if (al_at != 4096) {
                    in_r = 3;
                }
            }
            if (in_r == 0) {
                callsub s_before_write(al_at - ab, 24);
                in_r = bw_r;
                if (bw_r == 0) {
                    store16(ab + al_at, 1);
                    store16(ab + al_at + 2, 1);
                    store32(ab + al_at + 8, 4294967295);
                    store32(ab + al_at + 12, 4294967295);
                    store32(ab + al_at + 16, 1);
                    store32(ab + al_at + 20, 8 + 16 * in_slots);
                    store32(ab + al_at + 24, 1);
                    store32(ab + al_at + 28, in_slots);
                    store16(ab + 4128, 1);
                    store16(ab + 4130, 1);
                    store64(ab + 4136, 4096);
                    store32(ab + 4120, 1);
                }
            }

            # sys/syms: the names the tree is walked by. Entry 1.
            if (in_r == 0) {
                callsub s_allocate(8 + 4 * 32 + 256);
                in_r = al_r;
                if (al_r == 0) {
                    in_syms_at = al_at;
                    callsub s_before_write(in_syms_at - ab, 24);
                    in_r = bw_r;
                    if (bw_r == 0) {
                        store16(ab + in_syms_at, 5);
                        store16(ab + in_syms_at + 2, 1);
                        store32(ab + in_syms_at + 8, 4294967295);
                        store32(ab + in_syms_at + 12, 4294967295);
                        store32(ab + in_syms_at + 16, 1);
                        store32(ab + in_syms_at + 20, 8 + 4 * 32 + 256);
                        store32(ab + in_syms_at + 24, 1);
                        store32(ab + in_syms_at + 28, 32);
                        store16(ab + 4128 + 16, 5);
                        store16(ab + 4128 + 18, 1);
                        store64(ab + 4128 + 24, in_syms_at);
                        store32(ab + 4120, 2);
                        asyms = ab + in_syms_at + 24;
                    }
                }
            }

            # The tree: the root image first (its name is the image's), then sys.
            if (in_r == 0) {
                cs_parent = 4294967295;
                cs_name = Zname;
                cs_name_len = Znlen;
                cs_kind = 1;
                cs_payload = 8;
                cs_refs = 0;
                cs_type = 4294967295;
                cs_flags = 0;
                cs_index = 0;
                cs_refc = 1;
            cs_generation = 0;
                callsub s_create();
                in_r = cr_r;
                if (cr_r == 0) {
                    in_root = cr_h;
                    store32(ab + 24, cr_h);
                    callsub s_rec(cr_h);
                    callsub s_before_write(ce_r - ab + 4, 2);
                    if (bw_r == 0) {
                        store16(ce_r + 4, 2);
                    }
                }
            }
            if (in_r == 0) {
                m_lit_sys();
                cs_parent = in_root;
                cs_name = lit;
                cs_name_len = 3;
                callsub s_create();
                in_r = cr_r;
                if (cr_r == 0) {
                    in_sys = cr_h;
                }
            }

            # The index object is the first child of sys: the writer puts it on the
            # chain as `objects` before anything else (docs/32 2).
            if (in_r == 0) {
                callsub s_rec(in_sys);
                cl_head = ce_r + 24;
                m_pack_i(0);
                callsub s_rec(hx_r);
                if (ce_r != 0) {
                    callsub s_before_write(ce_r + 8 - ab, 4);
                    if (bw_r == 0) {
                        store32(ce_r + 8, in_sys);
                    }
                }
                callsub s_before_write(cl_head - ab, 8);
                in_r = bw_r;
                if (bw_r == 0) {
                    store32(cl_head, hx_r);
                    store32(cl_head + 4, 1);
                }
            }

            # `objects` is the name of the index object, interned third.
            if (in_r == 0) {
                m_lit_objects();
                callsub s_intern(lit, 7);
                in_r = it_r;
                if (it_r == 0) {
                    m_entry(0);
                    in_at = load64(sp_r + 8);
                    callsub s_before_write(in_at - ab + 6, 2);
                    in_r = bw_r;
                    if (bw_r == 0) {
                        store16(ab + in_at + 6, it_id);
                    }
                }
            }

            # The leaves of sys, in the order bootstrap makes them.
            if (in_r == 0) {
                m_lit_functions();
                cs_parent = in_sys;
                cs_name = lit;
                cs_name_len = 9;
                callsub s_create();
                in_r = cr_r;
            }
            if (in_r == 0) {
                m_lit_specs();
                cs_parent = in_sys;
                cs_kind = 4;
                cs_payload = 24 * in_slots;
                cs_name = lit;
                cs_name_len = 5;
                callsub s_create();
                in_r = cr_r;
                if (cr_r == 0) {
                    m_entry(cr_h & 1048575);
                    aspec = ab + load64(sp_r + 8) + 24;
                    # Every row starts untyped (ObjectArena::bootstrap's fill):
                    # the payload a fresh allocation answers is zeroed, and a row
                    # the fill never touched would read type 0 -- the handle of the
                    # index object, not "untyped". The bytes carry the difference.
                    in_i = 0;
                    while (in_i < in_slots) {
                        store32(aspec + 24 * in_i, 4294967295);
                        in_i = in_i + 1;
                    }
                }
            }
            if (in_r == 0) {
                m_lit_journal();
                cs_parent = in_sys;
                cs_kind = 8;
                cs_payload = 24 + 256 * 16;
                cs_name = lit;
                cs_name_len = 7;
                callsub s_create();
                in_r = cr_r;
                if (cr_r == 0) {
                    # The ring's head words are boot ground (ObjectArena::
                    # bootstrap: count 0, capacity 256, the 8-byte granule,
                    # base 0): the payload a fresh allocation answers is
                    # zeroed, and the words the reader recovers the ring from
                    # are part of the bytes.
                    m_entry(cr_h & 1048575);
                    in_at = load64(sp_r + 8);
                    store32(ab + in_at + 24, 0);
                    store32(ab + in_at + 28, 256);
                    store32(ab + in_at + 32, 8);
                    store32(ab + in_at + 36, 0);
                    store64(ab + in_at + 40, 0);
                }
            }
            if (in_r == 0) {
                m_lit_caps();
                cs_parent = in_sys;
                cs_kind = 1;
                cs_payload = 8;
                cs_name = lit;
                cs_name_len = 4;
                callsub s_create();
                in_r = cr_r;
            }
            if (in_r == 0) {
                m_lit_free();
                cs_parent = in_sys;
                cs_kind = 6;
                cs_payload = 8;
                cs_name = lit;
                cs_name_len = 4;
                callsub s_create();
                in_r = cr_r;
            }

            # `syms` is the name of the symbol table, interned last. The table
            # is a child of sys like every leaf of it (ObjectArena::bootstrap:
            # parent, append_child, then the name) -- a syms that is not on the
            # chain is invisible to find and children, and the count the head
            # carries would disagree with the chain it describes.
            if (in_r == 0) {
                m_lit_syms();
                callsub s_intern(lit, 4);
                in_r = it_r;
                if (it_r == 0) {
                    m_entry(1);
                    in_at = load64(sp_r + 8);
                    callsub s_before_write(in_at - ab + 10, 2);
                    if (bw_r == 0) {
                        store32(ab + in_at + 8, in_sys);
                    }
                    callsub s_before_write(in_at - ab + 6, 2);
                    in_r = bw_r;
                    if (bw_r == 0) {
                        store16(ab + in_at + 6, it_id);
                    }
                    # append_child(sys, syms): the chain's tail is free, the
                    # count one more.
                    if (in_r == 0) {
                        callsub s_rec(in_sys);
                        cl_mod = ce_r;
                        if (cl_mod != 0) {
                            if (load16(cl_mod) == 1) {
                                cl_head = cl_mod + 24;
                                cl_walk = load32(cl_head);
                                if (cl_walk == 4294967295) {
                                    callsub s_before_write(cl_head - ab, 8);
                                    if (bw_r == 0) {
                                        m_pack_i(1);
                                        store32(cl_head, hx_r);
                                        store32(cl_head + 4, 1);
                                    }
                                } else {
                                    cl_stop = 0;
                                    while (cl_stop == 0) {
                                        callsub s_rec(cl_walk);
                                        cl_next = ce_r;
                                        if (cl_next == 0) {
                                            cl_stop = 1;
                                        } else {
                                            if (load32(cl_next + 12) == 4294967295) {
                                                callsub s_before_write(cl_next + 12 - ab, 8);
                                                if (bw_r == 0) {
                                                    m_pack_i(1);
                                                    store32(cl_next + 12, hx_r);
                                                    store32(cl_head + 4, load32(cl_head + 4) + 1);
                                                }
                                                cl_stop = 1;
                                            } else {
                                                cl_walk = load32(cl_next + 12);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# ---- verify(): every invariant of the v7 layout, walking the whole arena (docs/32 1) ----------
# The superblock, the object stream, the end marker and the FREE ring. A check that
# fails names nothing here - the answer is one word, `vf_r` - so a caller that wants
# to know which invariant broke looks at the same places this does.

macro m_verify() {
    var v_at;
    var v_end;
    var v_span;
    var v_free;
    var v_ring;
    var v_guard;
    var v_prev;
    var v_next;
    var v_seen;
    var v_off;
    var v_ok;
    vf_r = 0;
    v_ok = 1;
    if (load8(ab) != 82) {
        v_ok = 0;
    }
    if (load8(ab + 1) != 88) {
        v_ok = 0;
    }
    if (load8(ab + 2) != 70) {
        v_ok = 0;
    }
    if (load8(ab + 3) != 65) {
        v_ok = 0;
    }
    if (load32(ab + 4) != 1) {
        v_ok = 0;
    }
    if (load64(ab + 8) < 4096) {
        v_ok = 0;
    }
    if (load64(ab + 8) > load64(ab + 16)) {
        v_ok = 0;
    }
    if (load64(ab + 16) > alim) {
        v_ok = 0;
    }
    if ((load64(ab + 8) & 7) != 0) {
        v_ok = 0;
    }
    v_off = 32;
    while (v_off < 4096) {
        if (load8(ab + v_off) != 0) {
            v_ok = 0;
        }
        v_off = v_off + 1;
    }

    # The stream packs back to back and ends exactly at the marker. A free span with
    # room for its links is a ring member; one without is a linkless gap.
    v_end = load64(ab + 8);
    v_free = 0;
    v_at = 4096;
    while (v_at < v_end & v_ok == 1) {
        m_span_of(v_at);
        v_span = sn2_r;
        if ((load32(ab + v_at + 20) & 7) != 0) {
            v_ok = 0;
        }
        if (v_span < 24) {
            v_ok = 0;
        }
        if (v_span > v_end - v_at) {
            v_ok = 0;
        }
        if (v_ok == 1) {
            if (load16(ab + v_at) == 65535) {
                if (v_span >= 40) {
                    v_free = v_free + 1;
                }
            }
            v_at = v_at + v_span;
        }
    }
    if (v_at != v_end) {
        v_ok = 0;
    }

    # The end marker: the ring anchor that covers the tail.
    m_span_of(v_end);
    if (load16(ab + v_end) != 65535) {
        v_ok = 0;
    }
    if (sn2_r != load64(ab + 16) - v_end) {
        v_ok = 0;
    }
    if (sn2_r < 40) {
        v_ok = 0;
    }

    # The ring is circular, consistent, and holds every linkable free span.
    v_seen = 0;
    v_ring = v_end;
    v_guard = v_free + 2;
    while (v_guard > 0 & v_ok == 1) {
        v_guard = v_guard - 1;
        m_span_of(v_ring);
        if (load16(ab + v_ring) != 65535) {
            v_ok = 0;
        }
        if (sn2_r < 40) {
            v_ok = 0;
        }
        if (v_ring < 4096) {
            v_ok = 0;
        }
        if (v_ring > v_end) {
            v_ok = 0;
        }
        if ((v_ring & 7) != 0) {
            v_ok = 0;
        }
        m_link_at(v_ring);
        v_prev = load64(la_r);
        v_next = load64(la_r + 8);
        if (v_prev < 4096) {
            v_ok = 0;
        }
        if (v_prev >= load64(ab + 16)) {
            v_ok = 0;
        }
        if (v_next < 4096) {
            v_ok = 0;
        }
        if (v_next >= load64(ab + 16)) {
            v_ok = 0;
        }
        if (v_ok == 1) {
            m_link_at(v_next);
            if (load64(la_r) != v_ring) {
                v_ok = 0;
            }
            m_link_at(v_prev);
            if (load64(la_r + 8) != v_ring) {
                v_ok = 0;
            }
        }
        if (v_ok == 1) {
            v_seen = v_seen + 1;
            v_ring = v_next;
            if (v_ring == v_end) {
                v_guard = 0;
                if (v_seen != v_free + 1) {
                    v_ok = 0;
                }
            }
        }
    }
    if (v_ok == 1) {
        if (v_ring == v_end) {
            vf_r = 1;
        }
    }
}

# ---- the session: scratch, the lookup table, the names (core/live/live.cpp) ----------------------

sub s_scratch_reset() {
    sat = sbase;
}


# name_hash(parent, p, n) -> nh_r (wrapping 64-bit arithmetic, as in the C++)

sub s_name_hash(Zparent_name_hash, Zp_name_hash, Zn_name_hash) {
    var nh_i;
    var nh_h;
    nh_h = 1469598103934665603 ^ (Zparent_name_hash * 0x9E3779B97F4A7C15);
    nh_i = 0;
    while (nh_i < Zn_name_hash) {
        nh_h = nh_h ^ load8(Zp_name_hash + nh_i);
        nh_h = nh_h * 1099511628211;
        nh_i = nh_i + 1;
    }
    nh_r = (nh_h ^ (nh_h >> 32)) & 0xFFFFFFFF;
}

# name_equals(h, p, n) -> ne_r (1/0)
macro m_name_eq(Zh, Zp, Zn) {
    var ne_i;
    callsub s_name(Zh);
    ne_r = 1;
    ne_i = 0;
    while (ne_i < Zn & ne_r == 1) {
        if (load8(nm_r + ne_i) != load8(Zp + ne_i)) {
            ne_r = 0;
        }
        ne_i = ne_i + 1;
    }
    if (load8(nm_r + Zn) != 0) {
        ne_r = 0;
    }
}

# home_of(h) -> hm_r
sub s_home(Zh_home) {
    var hm_c;
    callsub s_cell(Zh_home);
    hm_c = ce_r;
    hm_r = 0;
    if (hm_c != 0) {
        callsub s_name(Zh_home);
        callsub s_len(nm_r);
        callsub s_name_hash(load64(hm_c + 8), nm_r, len_r);
        hm_r = nh_r;
    }
}

# find_child(parent, p, n) -> fc_r (handle or kNone)
sub s_find_child(Zparent_find_child, Zp_find_child, Zn_find_child) {
    var fc_mask;
    var fc_i;
    var fc_e;
    var fc_done;
    fc_mask = slts - 1;
    callsub s_name_hash(Zparent_find_child, Zp_find_child, Zn_find_child);
    fc_i = nh_r & fc_mask;
    fc_r = 0xFFFFFFFFFFFFFFFF;
    fc_done = 0;
    while (fc_done == 0) {
        fc_e = load32(taddr + 4 * fc_i);
        if (fc_e == 0) {
            fc_done = 1;
        } else {
            callsub s_cell(fc_e - 1);
            if (ce_r != 0) {
                if (load64(ce_r + 8) == Zparent_find_child) {
                    m_name_eq(fc_e - 1, Zp_find_child, Zn_find_child);
                    if (ne_r == 1) {
                        fc_r = fc_e - 1;
                        fc_done = 1;
                    }
                }
            }
            if (fc_done == 0) {
                fc_i = (fc_i + 1) & fc_mask;
            }
        }
    }
}

# table_insert(h) -> tin_r (1 ok, 0 the name is taken or the table is full)
sub s_table_ins(Zh_table_ins) {
    var tin_c;
    var tin_mask;
    var tin_i;
    var tin_n;
    var tin_par;
    callsub s_cell(Zh_table_ins);
    tin_c = ce_r;
    tin_r = 0;
    if (tin_c != 0) {
        # No cell, no name to insert: a dead slot is not a lookup entry.
        callsub s_name(Zh_table_ins);
        callsub s_len(nm_r);
        tin_n = len_r;
        # The parent is read out of the view now: a view is good until the next
        # call that fills it (docs/32 5.3) and s_find_child fills view A.
        tin_par = load64(tin_c + 8);
        tin_r = 1;
        if (Zh_table_ins >= 0xFFFFFFF0) {
            tin_r = 0;
        }
        if (load32(ab + 4120) * 2 > slts) {
            tin_r = 0;
        }
        if (tin_r == 1) {
            callsub s_find_child(tin_par, nm_r, tin_n);
            if (fc_r != 0xFFFFFFFFFFFFFFFF) {
                tin_r = 0;
            }
        }
        if (tin_r == 1) {
            tin_mask = slts - 1;
            callsub s_name_hash(tin_par, nm_r, tin_n);
            tin_i = nh_r & tin_mask;
            while (load32(taddr + 4 * tin_i) != 0) {
                tin_i = (tin_i + 1) & tin_mask;
            }
            store32(taddr + 4 * tin_i, Zh_table_ins + 1);
        }
    }
}

# table_remove(h): backward-shift deletion (Knuth), as in the C++
macro m_table_del(Zh) {
    var tdl_mask;
    var tdl_i;
    var tdl_j;
    var tdl_k;
    var tdl_between;
    var tdl_done;
    var tdl_inner;
    tdl_mask = slts - 1;
    callsub s_home(Zh);
    tdl_i = hm_r & tdl_mask;
    while (load32(taddr + 4 * tdl_i) != 0 & load32(taddr + 4 * tdl_i) != Zh + 1) {
        tdl_i = (tdl_i + 1) & tdl_mask;
    }
    if (load32(taddr + 4 * tdl_i) != 0) {
        tdl_done = 0;
        while (tdl_done == 0) {
            tdl_j = tdl_i;
            tdl_inner = 0;
            while (tdl_inner == 0) {
                tdl_j = (tdl_j + 1) & tdl_mask;
                if (load32(taddr + 4 * tdl_j) == 0) {
                    store32(taddr + 4 * tdl_i, 0);
                    tdl_done = 1;
                    tdl_inner = 1;
                } else {
                    callsub s_home(load32(taddr + 4 * tdl_j) - 1);
                    tdl_k = hm_r & tdl_mask;
                    tdl_between = 0;
                    if (tdl_i <= tdl_j) {
                        if (tdl_i < tdl_k & tdl_k <= tdl_j) {
                            tdl_between = 1;
                        }
                    } else {
                        if (tdl_i < tdl_k | tdl_k <= tdl_j) {
                            tdl_between = 1;
                        }
                    }
                    if (tdl_between == 0) {
                        tdl_inner = 1;
                    }
                }
            }
            if (tdl_done == 0) {
                store32(taddr + 4 * tdl_i, load32(taddr + 4 * tdl_j));
                tdl_i = tdl_j;
            }
        }
    }
}

# build_table() -> bt_r (1/0): the (parent, name) -> handle index, open addressing.
sub s_build_table() {
    var bt_h;
    var bt_n;
    callsub s_zero(taddr, 4 * slts);
    bt_r = 1;
    bt_n = load32(ab + 4120);
    bt_h = 0;
    while (bt_h < bt_n & bt_r == 1) {
        m_pack_i(bt_h);
        callsub s_cell(hx_r);
        if (ce_r != 0) {
            if (load64(ce_r + 8) != 0xFFFFFFFFFFFFFFFF) {
                callsub s_table_ins(hx_r);
                bt_r = tin_r;
            }
        }
        bt_h = bt_h + 1;
    }
}

# resolve(p, n) -> rv_r (handle)
sub s_resolve(Zp_resolve, Zn_resolve) {
    var rv_start;
    var rv_end;
    var rv_go;
    rv_r = load32(ab + 24);
    if (rv_r != 0xFFFFFFFFFFFFFFFF) {
        if (Zn_resolve != 0) {
            rv_start = 0;
            rv_end = 0;
            rv_go = 1;
            while (rv_go == 1) {
                rv_end = rv_start;
                while (rv_end < Zn_resolve & load8(Zp_resolve + rv_end) != 46) {
                    rv_end = rv_end + 1;
                }
                callsub s_find_child(rv_r, Zp_resolve + rv_start, rv_end - rv_start);
                rv_r = fc_r;
                if (rv_r == 0xFFFFFFFFFFFFFFFF) {
                    rv_go = 0;
                } else {
                    if (rv_end >= Zn_resolve) {
                        rv_go = 0;
                    } else {
                        rv_start = rv_end + 1;
                    }
                }
            }
        }
    }
}

# path_of(h, out, capacity) -> po_r (1/0), po_n (the length written)
sub s_path_of(Zh_path_of, Zout_path_of, Zcap_path_of) {
    var po_total;
    var po_depth;
    var po_pos;
    var po_leaf;
    var po_at;
    var po_go;
    po_n = 0;
    po_total = 0;
    po_depth = 0;
    po_at = Zh_path_of;
    po_r = 1;
    po_go = 1;
    while (po_go == 1) {
        if (po_at == 0xFFFFFFFFFFFFFFFF) {
            po_go = 0;
        } else {
            callsub s_cell(po_at);
            if (ce_r == 0) {
                po_r = 0;
                po_go = 0;
            } else {
                if (load64(ce_r + 8) == 0xFFFFFFFFFFFFFFFF) {
                    po_go = 0;
                } else {
                    callsub s_name(po_at);
                    callsub s_len(nm_r);
                    po_total = po_total + len_r;
                    if (po_depth != 0) {
                        po_total = po_total + 1;
                    }
                    po_depth = po_depth + 1;
                    if (po_depth > 512 | po_total > Zcap_path_of) {
                        po_r = 0;
                        po_go = 0;
                    } else {
                        po_at = load64(ce_r + 8);
                    }
                }
            }
        }
    }
    if (po_r == 1) {
        po_pos = po_total;
        po_leaf = 1;
        po_at = Zh_path_of;
        po_go = 1;
        while (po_go == 1) {
            if (po_at == 0xFFFFFFFFFFFFFFFF) {
                po_go = 0;
            } else {
                callsub s_cell(po_at);
                if (load64(ce_r + 8) == 0xFFFFFFFFFFFFFFFF) {
                    po_go = 0;
                } else {
                    callsub s_name(po_at);
                    callsub s_len(nm_r);
                    po_n = len_r;
                    if (po_leaf == 1) {
                        po_pos = po_pos - po_n;
                        callsub s_cpy(Zout_path_of + po_pos, nm_r, po_n);
                    } else {
                        po_pos = po_pos - po_n - 1;
                        callsub s_cpy(Zout_path_of + po_pos, nm_r, po_n);
                        store8(Zout_path_of + po_pos + po_n, 46);
                    }
                    po_leaf = 0;
                    po_at = load64(ce_r + 8);
                }
            }
        }
        po_n = po_total;
    }
}

# less(a, b) -> lss_r (1 when a's name sorts before b's). The klist holds slot
# indices; a name is read through a handle (index, gen -- docs/32 1.2), so the
# indices are packed before the records resolve. A bare index is not a handle:
# its generation word is 0 and no live slot carries that.
sub s_less(Za_less, Zb_less) {
    var lss_i;
    var lss_x;
    var lss_y;
    var lss_go;
    m_pack_i(Za_less);
    callsub s_name(hx_r);
    lss_x = nm_r;
    m_pack_i(Zb_less);
    callsub s_name(hx_r);
    lss_y = nm_r;
    lss_i = 0;
    lss_r = 0;
    lss_go = 1;
    while (lss_go == 1) {
        if (load8(lss_x + lss_i) != load8(lss_y + lss_i)) {
            lss_r = 0;
            if (load8(lss_x + lss_i) < load8(lss_y + lss_i)) {
                lss_r = 1;
            }
            lss_go = 0;
        } else {
            if (load8(lss_x + lss_i) == 0) {
                lss_r = 0;
                lss_go = 0;
            } else {
                lss_i = lss_i + 1;
            }
        }
    }
}

# ---- children, types, payload references (core/live/live.cpp) -----------------------------------
# The per-request structure of the session: n_kids (handle count), kstart/klist (the children
# lists, sorted by name where asked), kmemo/kpool/kpfx (the reference layout per Type) live in the
# scratch region; empty0 holds the one word `0` a type without references points at.

# sift(a, root, end): heap sift of the u32 handles at Za, ascending by name.
sub s_sift(Za_sift, Zroot_sift, Zend_sift) {
    var hs_root;
    var hs_child;
    var hs_t;
    var hs_go;
    hs_root = Zroot_sift;
    hs_go = 1;
    while (hs_go == 1) {
        hs_child = 2 * hs_root + 1;
        if (hs_child >= Zend_sift) {
            hs_go = 0;
        } else {
            if (hs_child + 1 < Zend_sift) {
                callsub s_less(load32(Za_sift + 4 * hs_child), load32(Za_sift + 4 * (hs_child + 1)));
                if (lss_r == 1) {
                    hs_child = hs_child + 1;
                }
            }
            callsub s_less(load32(Za_sift + 4 * hs_root), load32(Za_sift + 4 * hs_child));
            if (lss_r == 0) {
                hs_go = 0;
            } else {
                hs_t = load32(Za_sift + 4 * hs_root);
                store32(Za_sift + 4 * hs_root, load32(Za_sift + 4 * hs_child));
                store32(Za_sift + 4 * hs_child, hs_t);
                hs_root = hs_child;
            }
        }
    }
}

# build_kids(sorted) -> bk_r (1/0): every object's children as a list in `list`, delimited by
# `start`, each sorted by name when asked.
sub s_build_kids(Zsorted_build_kids) {
    var bk_cursor;
    var bk_h;
    var bk_i;
    var bk_p;
    var bk_a;
    var bk_count;
    var bk_s;
    var bk_e;
    var bk_t;
    n_kids = load32(ab + 4120);
    bk_r = 1;
    callsub s_take(4 * (n_kids + 1));
    kstart = tk_r;
    callsub s_take(4 * (n_kids + 1));
    bk_cursor = tk_r;
    if (kstart == 0 | bk_cursor == 0) {
        bk_r = 0;
    } else {
        callsub s_zero(kstart, 4 * (n_kids + 1));
        bk_h = 0;
        while (bk_h < n_kids) {
            m_pack_i(bk_h);
            callsub s_cell(hx_r);
            if (ce_r != 0) {
                bk_par = load64(ce_r + 8) & 1048575;
                if (bk_par < n_kids) {
                    store32(kstart + 4 * (bk_par + 1),
                            load32(kstart + 4 * (bk_par + 1)) + 1);
                }
            }
            bk_h = bk_h + 1;
        }
        bk_i = 0;
        while (bk_i < n_kids) {
            store32(kstart + 4 * (bk_i + 1),
                    load32(kstart + 4 * (bk_i + 1)) + load32(kstart + 4 * bk_i));
            bk_i = bk_i + 1;
        }
        callsub s_take(4 * (load32(kstart + 4 * n_kids) + 1));
        klist = tk_r;
        if (klist == 0) {
            bk_r = 0;
        } else {
            callsub s_cpy(bk_cursor, kstart, 4 * (n_kids + 1));
            bk_h = 0;
            while (bk_h < n_kids) {
                m_pack_i(bk_h);
                callsub s_cell(hx_r);
                if (ce_r != 0) {
                    bk_par = load64(ce_r + 8) & 1048575;
                    if (bk_par < n_kids) {
                        store32(klist + 4 * load32(bk_cursor + 4 * bk_par), bk_h);
                        store32(bk_cursor + 4 * bk_par,
                                load32(bk_cursor + 4 * bk_par) + 1);
                    }
                }
                bk_h = bk_h + 1;
            }
            if (Zsorted_build_kids != 0) {
                bk_p = 0;
                while (bk_p < n_kids) {
                    bk_a = klist + 4 * load32(kstart + 4 * bk_p);
                    bk_count = load32(kstart + 4 * (bk_p + 1)) - load32(kstart + 4 * bk_p);
                    if (bk_count >= 2) {
                        bk_s = bk_count / 2;
                        while (bk_s != 0) {
                            bk_s = bk_s - 1;
                            callsub s_sift(bk_a, bk_s, bk_count);
                        }
                        bk_e = bk_count - 1;
                        while (bk_e != 0) {
                            bk_t = load32(bk_a);
                            store32(bk_a, load32(bk_a + 4 * bk_e));
                            store32(bk_a + 4 * bk_e, bk_t);
                            callsub s_sift(bk_a, 0, bk_e);
                            bk_e = bk_e - 1;
                        }
                    }
                    bk_p = bk_p + 1;
                }
            }
        }
    }
}

# type_info(t, buf) -> tif_r (1/0): the 48-byte Type payload, and its descriptor tag.
sub s_type_info(Zt_type_info, Zbuf_type_info) {
    callsub s_cell(Zt_type_info);
    tif_r = 0;
    if (ce_r != 0) {
        if (load64(ce_r) == 1) {
            if (load64(ce_r + 16) == 48) {
                callsub s_cpy(Zbuf_type_info, ce_r + 64, 48);
                if (load32(Zbuf_type_info) == 0x54595045) {
                    tif_r = 1;
                }
            }
        }
    }
}

# field_info(f, buf) -> fif_r (1/0): the 48-byte Field payload, not CHILDREN/INVERSE.
sub s_field_info(Zf_field_info, Zbuf_field_info) {
    callsub s_cell(Zf_field_info);
    fif_r = 0;
    if (ce_r != 0) {
        if (load64(ce_r) == 2) {
            if (load64(ce_r + 16) == 48) {
                callsub s_cpy(Zbuf_field_info, ce_r + 64, 48);
                if (load32(Zbuf_field_info) == 0x464C4420) {
                    if ((load32(Zbuf_field_info + 4) & 0x30) == 0) {
                        fif_r = 1;
                    }
                }
            }
        }
    }
}

# has_fields(t) -> hf_r (1/0): a readable Field among the children of the type.
sub s_has_fields(Zt_has_fields) {
    var hf_k;
    hf_r = 0;
    if (Zt_has_fields < n_kids) {
        hf_k = load32(kstart + 4 * Zt_has_fields);
        while (hf_k < load32(kstart + 4 * (Zt_has_fields + 1)) & hf_r == 0) {
            callsub s_field_info(load32(klist + 4 * hf_k), flH);
            if (fif_r == 1) {
                hf_r = 1;
            }
            hf_k = hf_k + 1;
        }
    }
}

# refs_of(type) -> ro_r (1/0), ro_words (the u32 words: count, then the payload offsets; bit 31:
# the reference may be unset). The frames of the depth-first walk are the 72-byte records of the
# `rframes` region: type 0, pos 8, end 12, base 16, vtype 24, voff 32, vsize 40, vcount 48,
# i 56, active 64.
sub s_refs_of(Ztype_refs_of) {
    var ro_nrefs;
    var ro_leaves;
    var ro_none;
    var ro_sp;
    var ro_f;
    var ro_g;
    var ro_at;
    var ro_fh;
    var ro_end;
    var ro_x;
    var ro_y;
    var ro_k;
    var ro_skip;
    var ro_go_extent;
    ro_r = 1;
    store32(empty0, 0);
    if (Ztype_refs_of == 0xFFFFFFFFFFFFFFFF | Ztype_refs_of >= n_kids) {
        ro_words = empty0;
    } else {
        if (load32(kmemo + 4 * Ztype_refs_of) != 0) {
            if (load32(kmemo + 4 * Ztype_refs_of) == 1) {
                ro_words = empty0;
            } else {
                ro_words = kpool + 4 * (load32(kmemo + 4 * Ztype_refs_of) - 2);
            }
        } else {
            ro_nrefs = 0;
            ro_leaves = 0;
            ro_none = 0;
            callsub s_type_info(Ztype_refs_of, tyT);
            if (tif_r == 0) {
                ro_none = 1;
            } else {
                if (load32(tyT + 4) == 8) {
                    ro_none = 1;
                } else {
                    callsub s_has_fields(Ztype_refs_of);
                    if (hf_r == 0) {
                        ro_none = 1;
                    }
                }
            }
            if (ro_none == 0) {
                store64(rframes, Ztype_refs_of);
                store32(rframes + 8, load32(kstart + 4 * Ztype_refs_of));
                store32(rframes + 12, load32(kstart + 4 * (Ztype_refs_of + 1)));
                store64(rframes + 16, 0);
                store8(rframes + 64, 0);
                ro_sp = 1;
                while (ro_sp > 0 & ro_none == 0 & ro_r == 1) {
                    ro_f = rframes + 72 * (ro_sp - 1);
                    ro_skip = 0;
                    ro_go_extent = 0;
                    if (load8(ro_f + 64) != 0) {
                        if (load64(ro_f + 56) < load64(ro_f + 48)) {
                            ro_at = load64(ro_f + 16) + load64(ro_f + 32) +
                                    load64(ro_f + 56) * load64(ro_f + 40);
                            store64(ro_f + 56, load64(ro_f + 56) + 1);
                            ro_g = rframes + 72 * ro_sp;
                            store64(ro_g, load64(ro_f + 24));
                            store32(ro_g + 8, load32(kstart + 4 * (load64(ro_f + 24) & 1048575)));
                            store32(ro_g + 12, load32(kstart + 4 * (load64(ro_f + 24) + 1)));
                            store64(ro_g + 16, ro_at);
                            store8(ro_g + 64, 0);
                            ro_sp = ro_sp + 1;
                            ro_skip = 1;
                        } else {
                            store8(ro_f + 64, 0);
                        }
                    }
                    if (ro_skip == 0) {
                        if (load32(ro_f + 8) == load32(ro_f + 12)) {
                            ro_sp = ro_sp - 1;
                            ro_skip = 1;
                        }
                    }
                    if (ro_skip == 0) {
                        ro_fh = load32(klist + 4 * load32(ro_f + 8));
                        store32(ro_f + 8, load32(ro_f + 8) + 1);
                        callsub s_field_info(ro_fh, flF);
                        if (fif_r == 0) {
                            ro_skip = 1;
                        }
                    }
                    if (ro_skip == 0) {
                        callsub s_type_info(load64(flF + 16), tyV);
                        if (tif_r == 0) {
                            ro_none = 1;
                        }
                        if (load64(flF + 32) == 0 | load64(flF + 32) > 2147483648) {
                            ro_none = 1;
                        }
                        if (load64(flF + 24) > 2147483648 | load64(tyV + 8) > 2147483648) {
                            ro_none = 1;
                        }
                        if (ro_none == 0) {
                            if ((load32(flF + 4) & 8) != 0) {
                                if (ro_nrefs >= 128 | ro_leaves >= 256) {
                                    ro_r = 0;
                                } else {
                                    if (load32(tyV + 4) != 3 | load64(tyV + 8) != 8) {
                                        ro_none = 1;
                                    } else {
                                        if (load64(flF + 32) != 1) {
                                            ro_none = 1;
                                        } else {
                                            if (load64(ro_f + 16) + load64(flF + 24) >= 1073741824) {
                                                ro_none = 1;
                                            } else {
                                                ro_end = load64(ro_f + 16) + load64(flF + 24);
                                                store32(roffsets + 4 * ro_nrefs, ro_end);
                                                if ((load32(flF + 4) & 2) != 0) {
                                                    store32(roffsets + 4 * ro_nrefs,
                                                            load32(roffsets + 4 * ro_nrefs) | 0x80000000);
                                                }
                                                ro_nrefs = ro_nrefs + 1;
                                                store64(rext_off + 8 * ro_leaves, ro_end);
                                                store64(rext_end + 8 * ro_leaves, ro_end + 8);
                                                ro_leaves = ro_leaves + 1;
                                            }
                                        }
                                    }
                                }
                            } else {
                                if (load32(tyV + 4) == 7) {
                                    callsub s_has_fields(load64(flF + 16));
                                    if (hf_r == 1) {
                                        if (ro_sp - 1 >= 6) {
                                            ro_none = 1;
                                        } else {
                                            store64(ro_f + 24, load64(flF + 16));
                                            store64(ro_f + 32, load64(flF + 24));
                                            store64(ro_f + 40, load64(tyV + 8));
                                            store64(ro_f + 48, load64(flF + 32));
                                            store64(ro_f + 56, 0);
                                            store8(ro_f + 64, 1);
                                        }
                                    } else {
                                        ro_go_extent = 1;
                                    }
                                } else {
                                    ro_go_extent = 1;
                                }
                                if (ro_go_extent == 1) {
                                    if (ro_leaves >= 256) {
                                        ro_r = 0;
                                    } else {
                                        if (load64(tyV + 8) == 0) {
                                            ro_none = 1;
                                        } else {
                                            store64(rext_off + 8 * ro_leaves,
                                                    load64(ro_f + 16) + load64(flF + 24));
                                            store64(rext_end + 8 * ro_leaves,
                                                    load64(ro_f + 16) + load64(flF + 24) +
                                                        load64(tyV + 8) * load64(flF + 32));
                                            ro_leaves = ro_leaves + 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if (ro_r == 1) {
                # fields that overlap are a union in disguise: raw bytes, no references
                if (ro_none == 0) {
                    ro_x = 0;
                    while (ro_x < ro_leaves & ro_none == 0) {
                        ro_y = ro_x + 1;
                        while (ro_y < ro_leaves & ro_none == 0) {
                            if (load64(rext_off + 8 * ro_x) < load64(rext_end + 8 * ro_y)) {
                                if (load64(rext_off + 8 * ro_y) < load64(rext_end + 8 * ro_x)) {
                                    ro_none = 1;
                                }
                            }
                            ro_y = ro_y + 1;
                        }
                        ro_x = ro_x + 1;
                    }
                }
                if (ro_none == 0) {
                    if (load64(tyT + 8) != 0) {
                        if ((load32(tyT + 36) & 1) == 0) {
                            ro_end = 0;
                            ro_x = 0;
                            while (ro_x < ro_leaves) {
                                if (load64(rext_end + 8 * ro_x) > ro_end) {
                                    ro_end = load64(rext_end + 8 * ro_x);
                                }
                                ro_x = ro_x + 1;
                            }
                            if (ro_end > load64(tyT + 8)) {
                                ro_none = 1;
                            }
                        }
                    }
                }
                if (ro_none == 0) {
                    if ((load32(tyT + 36) & 1) != 0) {
                        # the fixed part of a variable type ends where its last field ends
                        ro_end = 0;
                        ro_x = 0;
                        while (ro_x < ro_leaves) {
                            if (load64(rext_end + 8 * ro_x) > ro_end) {
                                ro_end = load64(rext_end + 8 * ro_x);
                            }
                            ro_x = ro_x + 1;
                        }
                        if (ro_end > 0xFFFFFFFF) {
                            store32(kpfx + 4 * Ztype_refs_of, 0xFFFFFFFF);
                        } else {
                            store32(kpfx + 4 * Ztype_refs_of, ro_end);
                        }
                    }
                }
                if (ro_none == 1 | ro_nrefs == 0) {
                    store32(kmemo + 4 * Ztype_refs_of, 1);
                    ro_words = empty0;
                } else {
                    if (pool_len + 1 + ro_nrefs > 16384) {
                        ro_r = 0;
                    } else {
                        store32(kmemo + 4 * Ztype_refs_of, pool_len + 2);
                        store32(kpool + 4 * pool_len, ro_nrefs);
                        ro_k = 0;
                        while (ro_k < ro_nrefs) {
                            store32(kpool + 4 * (pool_len + 1 + ro_k),
                                    load32(roffsets + 4 * ro_k));
                            ro_k = ro_k + 1;
                        }
                        ro_words = kpool + 4 * pool_len;
                        pool_len = pool_len + 1 + ro_nrefs;
                    }
                }
            }
        }
    }
}

# prepare_types() -> pt_r (1/0): the memo, the pool of reference layouts, the prefixes.
sub s_prep_types() {
    callsub s_take(4 * (n_kids + 1));
    kmemo = tk_r;
    callsub s_take(4 * 16384);
    kpool = tk_r;
    pt_r = 1;
    if (kmemo == 0 | kpool == 0) {
        pt_r = 0;
    } else {
        callsub s_take(4 * (n_kids + 1));
        kpfx = tk_r;
        if (kpfx == 0) {
            pt_r = 0;
        } else {
            callsub s_zero(kmemo, 4 * (n_kids + 1));
            callsub s_zero(kpfx, 4 * (n_kids + 1));
            pool_len = 0;
            store32(empty0, 0);
        }
    }
}

# ---- state words of a cell (live.cpp:46) and the literals the linker names ---------------------

sub s_state_of(Zc_state_of) {
    so_r = 0;
    if (Zc_state_of != 0) {
        so_r = (load32(Zc_state_of + 40) >> 8) & 63;
    }
}

macro m_disp_of(Zc) {
    callsub s_state_of(Zc);
    disp_r = (so_r >> 1) & 3;
}

sub s_mob_of(Zc_mob_of) {
    callsub s_state_of(Zc_mob_of);
    mob_r = (so_r >> 4) & 3;
}

