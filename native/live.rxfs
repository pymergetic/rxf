                        if (cr_r != 0) {
                            callsub s_reason_of(cr_r);
                            jb_reason = ro2_r;
                            ar_ok = 0;
                        } else {
                            callsub s_table_ins(ar_h);
                            if (tin_r == 0) {
                                jb_reason = 4;
                                ar_ok = 0;
                            }
