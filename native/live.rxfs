                } else {
                    callsub s_resolve(ar_p, ar_n);
                    ar_h = rv_r;
                    if (ar_h == 0xFFFFFFFFFFFFFFFF) {
                        jb_reason = 3;
                        ar_ok = 0;
                    }
                    if (ar_ok == 1) {
                        callsub s_cell(ar_h);
                        ar_old = ce_r;
                        if (load64(ar_old + 16) != load32(ar_d + ar_opos + 32)) {
                            callsub s_resize(ar_h, load32(ar_d + ar_opos + 32),
                                     load32(ar_d + ar_opos + 36));
                            if (rz_r != 0) {
                                callsub s_reason_of(rz_r);
                                jb_reason = ro2_r;
                                ar_ok = 0;
                            }
                        } else {
                            if (load32(ar_old + 44) != load32(ar_d + ar_opos + 36)) {
                                callsub s_resize(ar_h, load32(ar_d + ar_opos + 32),
                                         load32(ar_d + ar_opos + 36));
                                if (rz_r != 0) {
                                    callsub s_reason_of(rz_r);
                                    jb_reason = ro2_r;
                                    ar_ok = 0;
                                }
                            }
                        }
                    }
                    if (ar_ok == 1) {
                        # The semantic face of the object (docs/32 5): the flags,
                        # the sibling index and the generation of a delta are the
                        # words of its row in sys/specs, not of the record.
                        callsub s_set_field(ar_h, 4, load32(ar_d + ar_opos + 12));
                        if (sf_r == 0) {
                            callsub s_set_field(ar_h, 8, load32(ar_d + ar_opos + 16));
                        }
                        if (sf_r == 0) {
                            callsub s_set_field(ar_h, 16, load64(ar_d + ar_opos + 24));
                        }
                        if (sf_r != 0) {
                            jb_reason = 7;
                            ar_ok = 0;
                        }
