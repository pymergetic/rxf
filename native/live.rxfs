        }
    }
    if (ar_ok == 1) {
        jb_reason = 11;
        m_check_all();
        if (ck_r == 1) {
            m_verify();
            if (vf_r == 0) {
                ar_r = 1;
            }
        }
    }
}

# check_all() -> ck_r (live.cpp:1864): every handle something holds points at an object that is
# there.
macro m_check_all() {
    var ck_n;
    var ck_h;
    var ck_c;
    var ck_rp;
    var ck_k;
    var ck_words;
    var ck_off;
    var ck_val;
    callsub s_scratch_reset();
    ck_n = load32(ab + 4120);
    jb_reason = 8;
    ck_r = 0;
    callsub s_build_kids(0);
    if (bk_r == 1) {
        callsub s_prep_types();
        if (pt_r == 1) {
            jb_reason = 9;
            ck_r = 1;
            if (load32(ab + 28) != 4294967295) {
                callsub s_cell(load32(ab + 28));
                if (ce_r == 0) {
                    ck_r = 0;
                }
            }
            ck_h = 0;
            while (ck_h < ck_n & ck_r == 1) {
                m_pack_i(ck_h);
                callsub s_cell(hx_r);
                ck_c = ce_r;
                if (ck_c != 0) {
                    if (load64(ck_c + 8) != 0xFFFFFFFFFFFFFFFF) {
                        callsub s_cell(load64(ck_c + 8));
                        if (ce_r == 0) {
                            ck_r = 0;
                        }
                    }
                    if (ck_r == 1) {
                        if (load64(ck_c) != 0xFFFFFFFFFFFFFFFF) {
                            callsub s_cell(load64(ck_c));
                            if (ce_r == 0) {
                                ck_r = 0;
                            }
                        }
                    }
                    if (ck_r == 1) {
                        callsub s_refs(hx_r);
                        ck_rp = rr_r;
                        ck_k = 0;
                        while (ck_k < load32(ck_c + 44) & ck_r == 1) {
                            if (load64(ck_rp + 24 * ck_k) != 0xFFFFFFFFFFFFFFFF) {
                                callsub s_cell(load64(ck_rp + 24 * ck_k));
                                if (ce_r == 0) {
                                    ck_r = 0;
                                }
                            }
                            if (ck_r == 1) {
                                if (load64(ck_rp + 24 * ck_k + 8) != 0xFFFFFFFFFFFFFFFF) {
                                    callsub s_cell(load64(ck_rp + 24 * ck_k + 8));
                                    if (ce_r == 0) {
                                        ck_r = 0;
                                    }
                                }
                            }
                            ck_k = ck_k + 1;
                        }
                    }
                    if (ck_r == 1) {
                        if (load64(ck_c + 16) != 0) {
                            if (load64(ck_c) != 0xFFFFFFFFFFFFFFFF) {
                                callsub s_refs_of(load64(ck_c));
                                if (ro_r == 0) {
                                    jb_reason = 12;
                                    ck_r = 0;
                                } else {
                                    ck_words = ro_words;
                                    ck_k = 0;
                                    while (ck_k < load32(ck_words)) {
                                        ck_off = load32(ck_words + 4 + 4 * ck_k) & 0x7FFFFFFF;
                                        if (ck_off + 8 <= load64(ck_c + 16)) {
                                            ck_val = load64(ck_c + 64 + ck_off);
                                            if (ck_val != 0xFFFFFFFFFFFFFFFF) {
                                                callsub s_cell(ck_val);
                                                if (ce_r == 0) {
                                                    ck_r = 0;
                                                }
                                            }
                                        }
                                        ck_k = ck_k + 1;
                                    }
                                }
                            }
                        }
                    }
                }
                ck_h = ck_h + 1;
            }
        }
    }
}

# ---- the job machine (live.cpp:1054) and serve (live.cpp:180) ------------------------------------

# run_job(job): kJobEmit 1, kJobRelink 2, kJobCompact 3, kJobApply 4 (live.cpp:1079).
macro m_run_job(Zjob) {
    var rj_ph;
    var rj_loop;
    jb_at_op = 0;
    jb_reason = 0;
    jok = 0;
    jb_reclaimed = 0;
    jb_emitted = 0;
    jb_le = 0;
    jb_ls = 0;
    jb_override = 0;
    jguard = 0;
    rj_ph = 2;
    if (Zjob == 1) {
        # Job 1 is the dump: phase 0 runs m_emit -- the canonical bytes, the
        # claim, the marker's span and the digest included (live.cpp dump +
        # ObjectArena::rebuild, docs/32 5.4) -- and carries them (em_r, em_len)
        # on to jemit_next.
        jemit_next = 11;
        rj_ph = 0;
    } else {
        if (Zjob == 2) {
            jrelink_next = 11;
            jdry = 0;
            rj_ph = 1;
            callsub s_linkable();
            if (lk_r == 0) {
                jb_reason = 15;
                rj_ph = 12;
            }
        } else {
            if (Zjob == 3) {
                rj_ph = 7;
            }
        }
    }
    rj_loop = 1;
    while (rj_loop == 1) {
        if (rj_ph == 0) {
            # The dump every job shares (live.cpp dump, docs/32 5.4): one
            # expansion of the walk serves the DIGEST/EMIT answer, the apply's
            # base check, the post-apply digest and the compaction's slide
            # alike. The reason a dump that does not answer carries is the
            # caller's own (jb_override): the apply's and the compaction's
            # refusals are the arena's (live.cpp REASON_ARENA), a plain dump's
            # is the walk's (em_rsn).
            m_emit();
            if (em_r == 1) {
                jb_emitted = em_len;
                rj_ph = jemit_next;
            } else {
                if (jb_override != 0) {
                    jb_reason = jb_override;
                } else {
                    jb_reason = em_rsn;
                }
                rj_ph = 12;
            }
            jb_override = 0;
        } else {
            if (rj_ph == 1) {
                m_relink();
                if (rl_r == 1) {
                    jb_le = rl_entries;
                    jb_ls = rl_slots;
                    rj_ph = jrelink_next;
                } else {
                    rj_ph = 12;
                }
            } else {
                if (rj_ph == 2) {
                    m_apply_prepare();
                    if (ap_r == 0) {
                        rj_ph = 12;
                    } else {
                        if ((load32(jdhead + 16) & 1) != 0) {
                            # The base is the digest of the image the delta was
                            # compiled against (docs/32 5.4): the dump answers it
                            # into ar+192 before the compare, the same two faces
                            # as the engine (live.cpp). A dump that does not
                            # answer refuses the apply as the arena's (live.h).
                            jb_override = 6;
                            jemit_next = 3;
                            rj_ph = 0;
                        } else {
                            rj_ph = 4;
                        }
                    }
                } else {
                    if (rj_ph == 3) {
                        callsub s_cmp(ar + 192, jdhead + 24, 32);
                        if (cmp_r != 0) {
                            jb_reason = 2;
                            rj_ph = 12;
                        } else {
                            rj_ph = 4;
                        }
                    } else {
                    if (rj_ph == 4) {
                        m_apply_replay();
                        if (ar_r == 1) {
                            # The answer is the digest of the result (live.cpp):
                            # the dump of the world the replay made, into ar+192
                            # and jb_emitted, before the commit rolls the journal.
                            # A dump that does not answer is the image's own
                            # refusal (live.cpp: REASON_ARENA, BAD_IMAGE).
                            jb_override = 6;
                            jemit_next = 5;
                            rj_ph = 0;
                        } else {
                            rj_ph = 12;
                        }
                    } else {
                            if (rj_ph == 5) {
                                rj_ph = 6;
                                callsub s_linkable();
                                if (lk_r == 1) {
                                    jdry = 0;
                                    jrelink_next = 6;
                                    rj_ph = 1;
                                }
                            } else {
                                if (rj_ph == 6) {
                                    m_commit();
                                    rj_ph = 11;
                                } else {
                                    if (rj_ph == 7) {
                                        m_compact_scan();
                                        if (cs2_r == 0) {
                                            rj_ph = 12;
                                        } else {
                                            rj_ph = 8;
                                            callsub s_linkable();
                                            if (lk_r == 1) {
                                                jdry = 1;
                                                jrelink_next = 8;
                                                rj_ph = 1;
                                            }
                                        }
                                    } else {
                                        if (rj_ph == 8) {
                                            # The compaction's dump (docs/20 S8):
                                            # phase 0 runs the walk -- the
                                            # canonical bytes into the emit
                                            # region, verified by the walk
                                            # itself (docs/32 5.4). A dump that
                                            # does not answer is the image's own
                                            # refusal (live.cpp: REASON_ARENA,
                                            # REFUSED), the arena untouched.
                                            jdry = 0;
                                            jb_override = 6;
                                            jemit_next = 9;
                                            rj_ph = 0;
                                        } else {
                                            if (rj_ph == 9) {
                                                rj_ph = 10;
                                                callsub s_linkable();
                                                if (lk_r == 1) {
                                                    jdry = 1;
                                                    jguard = 1;
                                                    jrelink_next = 10;
                                                    rj_ph = 1;
                                                }
                                            } else {
                                                if (rj_ph == 10) {
                                                    jdry = 0;
                                                    jguard = 0;
                                                    rj_ph = 11;
                                                    m_compact_copy();
                                                    if (cc_r == 0) {
                                                        rj_ph = 12;
                                                    } else {
                                                        callsub s_linkable();
                                                        if (lk_r == 1) {
                                                            jrelink_next = 11;
                                                            rj_ph = 1;
                                                        }
                                                    }
                                                } else {
                                                    if (rj_ph == 12) {
                                                        if (aj != 0) {
                                                            m_rollback();
                                                            callsub s_build_table();
                                                            if (bt_r == 1) {
                                                                store32(ar + 140, 1);
                                                            } else {
                                                                store32(ar + 140, 0);
                                                            }
                                                        }
                                                        jok = 0;
                                                        rj_loop = 0;
                                                    } else {
                                                        if (Zjob != 1) {
                                                            store32(ar + 268, load32(ar + 268) + 1);
                                                        }
                                                        jok = 1;
                                                        rj_loop = 0;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# serve(op, argument, rq, rl, rs) -> sv_status, sv_rsl, sv_rarg (live.cpp:180).
macro m_serve(Zop, Zarg, Zrq, Zrl, Zrs) {
    var se_c;
    var se_name;
    var se_n;
    var se_h;
    var se_at;
    var se_k;
    var se_count;
    var se_bytes;
    var se_job;
    var se_done;
    sv_status = 0;
    sv_rsl = 0;
    sv_rarg = Zarg;
    callsub s_scratch_reset();
    se_job = 0;
    se_done = 0;
    # The read side is on the v7 model (docs/32 5.3) and answers, and so does the
    # write side of the image: DIGEST and EMIT answer the rebuild (docs/32 5.4)
    # and STAGE_COMMIT applies the physical delta (docs/19) - two passes,
    # SHA-checked, rolled back on failure, the answer the digest of the result.
    # COMPACT (job 3, docs/20 S8) and RELINK (job 2) are served below through
    # the job machine - the compaction's own canonical walk, and the relink's -
    # and REFUSED is what a well formed request that is not done gets (live.h):
    # the pin's reason 13 before a byte is moved, the unbound context's 15.
    if (Zop == 1) {
        callsub s_cpy(Zrs, Zrq, Zrl);
        sv_rsl = Zrl;
        se_done = 1;
    }
    if (se_done == 0) {
        if (Zop == 2) {
            store32(Zrs, 1);
            store32(Zrs + 4, 0);
            store64(Zrs + 8, load32(ab + 4120));
            store64(Zrs + 16, load64(ah + 8));
            store64(Zrs + 24, load64(ar + 16));
            store64(Zrs + 32, load64(ar + 48));
            store64(Zrs + 40, load64(ar + 80));
            store64(Zrs + 48, load64(ar + 64));
            store64(Zrs + 56, load64(ar + 160));
            store64(Zrs + 64, load64(ar + 168));
            store64(Zrs + 72, acomm);
            sv_rsl = 80;
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 3) {
            callsub s_cpy(Zrs, ah, 192);
            sv_rsl = 192;
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 4) {
            callsub s_resolve(Zrq, Zrl);
            se_h = rv_r;
            if (se_h == 0xFFFFFFFFFFFFFFFF) {
                sv_status = 3;
            } else {
                store64(Zrs, se_h);
                sv_rsl = 8;
            }
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 5) {
            if (Zrl < 8) {
                sv_status = 4;
            } else {
                callsub s_path_of(load64(Zrq), Zrs, 1024);
                if (po_r == 0) {
                    sv_status = 3;
                } else {
                    sv_rsl = po_n;
                }
            }
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 6) {
            if (Zrl < 8) {
                sv_status = 4;
            } else {
                callsub s_cell(load64(Zrq));
                se_c = ce_r;
                if (se_c == 0) {
                    sv_status = 3;
                } else {
                    callsub s_name(load64(Zrq));
                    se_name = nm_r;
                    callsub s_len(se_name);
                    se_n = len_r;
                    if (se_n > 900) {
                        se_n = 900;
                    }
                    store64(Zrs, load64(se_c));
                    store64(Zrs + 8, load64(se_c + 8));
                    store64(Zrs + 16, load64(se_c + 16));
                    store64(Zrs + 24, load64(se_c + 24));
                    store32(Zrs + 32, load32(se_c + 40));
                    store32(Zrs + 36, load32(se_c + 44));
                    store32(Zrs + 40, load32(se_c + 56));
                    store32(Zrs + 44, se_n);
                    callsub s_cpy(Zrs + 48, se_name, se_n);
                    sv_rsl = 48 + se_n;
                }
            }
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 7) {
            if (Zrl < 16) {
                sv_status = 4;
            } else {
                callsub s_cell(load64(Zrq));
                se_c = ce_r;
                if (se_c == 0) {
                    sv_status = 3;
                } else {
                    if (load32(Zrq + 8) > load64(se_c + 16)) {
                        sv_status = 4;
                    } else {
                        se_count = load32(Zrq + 12);
                        if (se_count > 1024) {
                            se_count = 1024;
                        }
                        if (se_count > load64(se_c + 16) - load32(Zrq + 8)) {
                            se_count = load64(se_c + 16) - load32(Zrq + 8);
                        }
                        callsub s_payload(load64(Zrq));
                        callsub s_cpy(Zrs, pa_r + load32(Zrq + 8), se_count);
                        sv_rsl = se_count;
                    }
                }
            }
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 8) {
            if (Zrl < 12) {
                sv_status = 4;
            } else {
                se_at = load32(Zrq + 8);
                se_count = 0;
                while (se_at < load32(ab + 4120) & se_count < 120) {
                    m_pack_i(se_at);
                    callsub s_cell(hx_r);
                    se_c = ce_r;
                    if (se_c != 0) {
                        if (load64(se_c + 8) == load64(Zrq)) {
                            store64(Zrs + 8 + 8 * se_count, hx_r);
                            se_count = se_count + 1;
                        }
                    }
                    se_at = se_at + 1;
                }
                store32(Zrs, se_count);
                if (se_at >= load32(ab + 4120)) {
                    store32(Zrs + 4, 0xFFFFFFFF);
                } else {
                    store32(Zrs + 4, se_at);
                }
                sv_rsl = 8 + 8 * se_count;
            }
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 9) {
            if (Zrl < 12) {
                sv_status = 4;
            } else {
                callsub s_cell(load64(Zrq));
                se_c = ce_r;
                if (se_c == 0) {
                    sv_status = 3;
                } else {
                    callsub s_refs(load64(Zrq));
                    se_count = 0;
                    se_k = load32(Zrq + 8);
                    while (se_k < load32(se_c + 44) & se_count < 40) {
                        callsub s_cpy(Zrs + 8 + 24 * se_count, rr_r + 24 * se_k, 24);
                        se_k = se_k + 1;
                        se_count = se_count + 1;
                    }
                    store32(Zrs, se_count);
                    store32(Zrs + 4, load32(se_c + 44));
                    sv_rsl = 8 + 24 * se_count;
                }
            }
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 16) {
            store32(ar + 144, 0);
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 17) {
            if (Zarg + Zrl > load64(ar + 48)) {
                sv_status = 5;
            } else {
                callsub s_cpy(load64(ar + 40) + Zarg, Zrq, Zrl);
                if (Zarg + Zrl > load32(ar + 144)) {
                    store32(ar + 144, Zarg + Zrl);
                }
            }
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 18) {
            if (Zrl < 36) {
                sv_status = 4;
            } else {
                jb_len = load32(Zrq);
                if (jb_len > load32(ar + 144)) {
                    sv_status = 4;
                } else {
                    callsub s_sha_init(shh);
                    callsub s_sha_upd(shh, load64(ar + 40), jb_len);
                    callsub s_sha_finish(shh, shd);
                    callsub s_cmp(shd, Zrq + 4, 32);
                    if (cmp_r != 0) {
                        sv_status = 6;
                    } else {
                        se_job = 4;
                    }
                }
            }
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 32 | Zop == 33) {
            se_job = 1;
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 34) {
            if (Zrl < 4) {
                sv_status = 4;
            } else {
                se_count = load32(Zrq);
                if (Zarg > load64(ar + 184)) {
                    sv_status = 4;
                } else {
                    if (se_count > 1024) {
                        se_count = 1024;
                    }
                    if (se_count > load64(ar + 184) - Zarg) {
                        se_count = load64(ar + 184) - Zarg;
                    }
                    callsub s_cpy(Zrs, jemit_base + Zarg, se_count);
                    sv_rsl = se_count;
                }
            }
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 36) {
            if (Zrl < 8) {
                sv_status = 4;
            } else {
                se_bytes = load64(Zrq);
                if (se_bytes < acomm | se_bytes > load64(ar + 16)) {
                    store32(Zrs, 0);
                    store32(Zrs + 4, 14);
                    sv_rsl = 8;
                    sv_status = 9;
                } else {
                    store64(ar + 224, se_bytes);
                    store64(ar + 232, 0);
                    store64(Zrs, se_bytes);
                    sv_rsl = 8;
                }
            }
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 35) {
            se_job = 3;
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 37) {
            se_job = 2;
            se_done = 1;
        }
    }
    if (se_done == 0) {
        if (Zop == 48) {
            store32(ar + 176, Zarg);
            store32(Zrs, load32(ar + 180));
            sv_rsl = 4;
            se_done = 1;
        }
    }
    if (se_done == 0) {
        sv_status = 2;
    }
    if (sv_status == 0) {
        if (se_job != 0) {
            m_run_job(se_job);
            if (se_job == 1) {
                if (jok == 0) {
                    store32(Zrs, 0);
                    store32(Zrs + 4, jb_reason);
                    sv_rsl = 8;
                    sv_status = 8;
                } else {
                    if (Zop == 32) {
                        callsub s_cpy(Zrs, ar + 192, 32);
                        sv_rsl = 32;
                    } else {
                        store64(Zrs, jb_emitted);
                        callsub s_cpy(Zrs + 8, ar + 192, 32);
                        sv_rsl = 40;
                    }
                }
            } else {
                if (se_job == 2) {
                    if (jok == 0) {
                        store32(Zrs, 0);
                        store32(Zrs + 4, jb_reason);
                        sv_rsl = 8;
                        sv_status = 9;
                    } else {
                        store32(Zrs, jb_le);
                        store32(Zrs + 4, jb_ls);
                        sv_rsl = 8;
                    }
                } else {
                    if (se_job == 3) {
                        if (jok == 0) {
                            store32(Zrs, 0);
                            store32(Zrs + 4, jb_reason);
                            sv_rsl = 8;
                            sv_status = 9;
                        } else {
                            store64(Zrs, load32(ab + 4120));
                            store64(Zrs + 8, load64(ah + 8));
                            callsub s_cpy(Zrs + 16, ar + 192, 32);
                            store64(Zrs + 48, jb_reclaimed);
                            sv_rsl = 56;
                        }
                    } else {
                        if (jok == 1) {
                            store64(ar + 160, load64(ar + 160) + 1);
                            callsub s_cpy(Zrs, ar + 192, 32);
                            sv_rsl = 32;
                        } else {
                            store64(ar + 168, load64(ar + 168) + 1);
                            if (jb_reason == 6) {
                                if (aneed > acomm) {
                                    se_bytes = aneed + 3 * jb_len + 4096;
                                    if (se_bytes > load64(ar + 16)) {
                                        se_bytes = load64(ar + 16);
                                    }
                                    store64(ar + 232, se_bytes);
                                }
                            }
                            store32(Zrs, jb_at_op);
                            store32(Zrs + 4, jb_reason);
                            sv_rsl = 8;
                            sv_status = 7;
                        }
                    }
                }
            }
        }
    }
}

# --- end of part 4c ---




# ============================================================================
# open / pump (native/live.cpp Session::open + Session::pump)
# ============================================================================

macro m_open() {
    op_r = 0;
    if (load32(ar) == 0x4556494C) {
        if (load32(ar + 4) == 1) {
            ab = load64(ar + 8);
            acomm = load64(ar + 224);
            if (acomm == 0) {
                acomm = load64(ar + 16);
            }
            alim = load64(ar + 16);
            if (acomm <= alim) {
                callsub s_attach();
                if (at_r == 0) {
                    slts = load32(ar + 136);
                    if (slts >= 8) {
                        if ((slts & (slts - 1)) == 0) {
                            if (slts * 4 <= load64(ar + 64)) {
                                taddr = load64(ar + 56);
                                sbase = load64(ar + 56) + ((slts * 4 + 15) & ~15);
                                # The three world-cell views (docs/32 5.3) live above the
                                # lookup table and below the scratch a request takes from,
                                # so they hold for the whole run and never alias a scratch
                                # allocation.
                                raddr = sbase;
                                sbase = sbase + ((slts * 4 + 15) & ~15);
                                cva = sbase;
                                cvb = sbase + 64;
                                cvc = sbase + 128;
                                sbase = sbase + 192;
                                send = load64(ar + 56) + load64(ar + 64);
                                sat = sbase;
                                if (load32(ar + 140) == 1) {
                                    op_r = 1;
                                } else {
                                    callsub s_build_table();
                                    if (bt_r == 1) {
                                        m_build_rels();
                                        store32(ar + 140, 1);
                                        op_r = 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

macro m_pump(Zlimit, Zreloc) {
    m_open();
    pu_served = 0;
    if (op_r == 1) {
        pu_rx = load64(ar + 88);
        pu_tx = load64(ar + 104);
        pu_rx_mask = load32(ar + 96) - 1;
        pu_tx_mask = load32(ar + 112) - 1;
        pu_go = 1;
        while (pu_served < Zlimit & pu_go == 1) {
            pu_head = load32(ar + 120);
            pu_tail = load32(ar + 124);
            pu_available = pu_head - pu_tail;
            if (pu_available < 20) {
                pu_go = 0;
            } else {
                pu_i = 0;
                while (pu_i < 16) {
                    store8(rqbuf + pu_i, load8(pu_rx + ((pu_tail + pu_i) & pu_rx_mask)));
                    pu_i = pu_i + 1;
                }
                pu_len = load16(rqbuf + 12);
                if (load16(rqbuf) != 0x5852 | pu_len > 1024) {
                    store32(ar + 124, pu_tail + 1);
                } else {
                    pu_total = 16 + pu_len + 4;
                    if (pu_available < pu_total) {
                        pu_go = 0;
                    } else {
                        pu_i = 16;
                        while (pu_i < pu_total) {
                            store8(rqbuf + pu_i, load8(pu_rx + ((pu_tail + pu_i) & pu_rx_mask)));
                            pu_i = pu_i + 1;
                        }
                        callsub s_crc32(rqbuf, pu_total - 4);
                        if (load32(rqbuf + pu_total - 4) != crc_r) {
                            store32(ar + 124, pu_tail + 1);
                        } else {
                            pu_tx_used = load32(ar + 128) - load32(ar + 132);
                            if (load32(ar + 112) - pu_tx_used < 1044) {
                                pu_go = 0;
                            } else {
                                pu_stop = 0;
                                if (Zreloc != 0) {
                                    if (load8(rqbuf + 2) == 35) {
                                        if (load32(ar + 264) == 0 & load32(ar + 260) == 0 &
                                            load32(ar + 256) == 0) {
                                            if (load32(ar + 252) != 3) {
                                                store32(ar + 264, 1);
                                                pu_stop = 1;
                                            }
                                        }
                                    }
                                }
                                if (pu_stop == 0) {
                                    m_serve(load8(rqbuf + 2), load32(rqbuf + 8), rqbuf + 16, pu_len, rsbuf + 16);
                                    store16(rsbuf, 0x5852);
                                    store8(rsbuf + 2, load8(rqbuf + 2) | 128);
                                    store8(rsbuf + 3, 0);
                                    store32(rsbuf + 4, load32(rqbuf + 4));
                                    store32(rsbuf + 8, sv_rarg);
                                    store16(rsbuf + 12, sv_rsl);
                                    store16(rsbuf + 14, sv_status);
                                    pu_out_total = 16 + sv_rsl + 4;
                                    callsub s_crc32(rsbuf, pu_out_total - 4);
                                    store32(rsbuf + pu_out_total - 4, crc_r);
                                    pu_out_head = load32(ar + 128);
                                    pu_i = 0;
                                    while (pu_i < pu_out_total) {
                                        store8(pu_tx + ((pu_out_head + pu_i) & pu_tx_mask), load8(rsbuf + pu_i));
                                        pu_i = pu_i + 1;
                                    }
                                    store32(ar + 128, pu_out_head + pu_out_total);
                                    store32(ar + 124, pu_tail + pu_total);
                                    store32(ar + 148, sv_status);
                                    store64(ar + 152, load64(ar + 152) + 1);
                                    pu_served = pu_served + 1;
                                } else {
                                    pu_go = 0;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# native/live.cpp own_body: which native_slot_24 owns `pc()` -- and the code size
# that owns it. Needed so live_pump can copy its own rx body into log space and
# tail-call it after the compactor overwrote the image.
macro m_own_body() {
    ob_self = 0;
    ob_size = 0;
    if (context != 0) {
        ob_slots = load64(context + 24);
        ob_entries = load64(context + 40);
        ob_pc = pc();
        ob_done = 0;
        ob_k = 0;
        while (ob_k < load64(context + 16) & ob_done == 0) {
            if (load64(ob_slots + 24 * ob_k) == 29) {
                ob_i = 0;
                while (ob_i < load64(context + 32) & ob_done == 0) {
                    if (load64(ob_entries + 80 * ob_i + 24) == load64(ob_slots + 24 * ob_k + 16)) {
                        if (ob_pc >= load64(ob_slots + 24 * ob_k + 16)) {
                            if (ob_pc < load64(ob_slots + 24 * ob_k + 16) + load64(ob_entries + 80 * ob_i + 32)) {
                                ob_size = load64(ob_entries + 80 * ob_i + 32);
                                ob_self = load64(ob_slots + 24 * ob_k + 16);
                                ob_done = 1;
                            }
                        }
                    }
                    ob_i = ob_i + 1;
                }
            }
            ob_k = ob_k + 1;
        }
    }
}

# ============================================================================
# entry points (safe_point is NOT here: its one defining source is native/safe/safe.rxfs,
# wired by tools/native/seed_build.py SOURCES -- this file is the live pump alone)
# ============================================================================

fn live_pump(context, area) {
    var at, caps, capc, cap_i, cap_go, ctx;
    var ab, acomm, alim, at_r, op_r, slts, taddr, sbase, send, sat;
    var aneed, ar, ah, aj, amark, aused, abitmap, al_at, al_r;
    var alog_base, alog_comm, alog_lim;
    var in_r, bg_r, cm_r, rb_r, rz_r, de_r, el_r;
    var ob_slots, ob_entries, ob_pc, ob_k, ob_i, ob_done, ob_self, ob_size, ob_ground, ob_copy_i;
    var pu_served, pu_rx, pu_tx, pu_rx_mask, pu_tx_mask, pu_go, pu_stop;
    var pu_head, pu_tail, pu_available, pu_i, pu_len, pu_total, pu_tx_used, pu_out_total, pu_out_head;
    var pu_limit, pu_stop_after, pu_clear_reloc, pu_phase, pu_again;
    var crc_r, crc_i, crc_k, cmp_r, len_r;
    var cr_h, cr_r, cs2_r, ck_r, cn_r, cc_r;
    var cl_mod, cl_head, cl_walk, cl_next, cl_stop, cs_refc;
    var em_name, em_nlen, em_nrw, em_src, em_hnd, sg_r, acursor, em_slots, em_claim, em_cmt, cc_ix, cc_n, cc_rec, cc_k, cc_w, em_syms, em_id, src_syms;
    var em_osyms, em_oaspec, em_ocursor;
    var cs_type, cs_parent, cs_generation, cs_flags, cs_index, cs_name, cs_name_len, cs_payload, cs_refs, cs_kind;
    var ce_r, sp_r, lv_r, pa_r, rr_r, kd_r, nm_r, fc_r;
    var ne_r, nh_r, hm_r, tin_r, it_r, tk_r, pw_r, rw_r, lss_r;
    var bk_r, bt_r, rv_r, vf_r, po_n, po_r, tif_r, fif_r, hf_r, bk_par;
    var n_kids, kstart, klist, kmemo, kpool, kpfx, pool_len;
    var ro_r, ro_words, ro2_r, sa_r, sa_p, sa_n, ni_r, em_r, em_rsn, em_len, em_state;
    var lk_r, ca_r, ca_at, ca_rng0, ca_rng1, rl_r, rl_entries, rl_slots;
    var sv_status, sv_rsl, sv_rarg, jok, jb_le, jb_ls, jb_override, jemit_next, jrelink_next;
    var jb_at_op, jb_len, jb_ssize, jb_fixups, jb_reason, jb_emitted, jb_reclaimed;
    var jguard, jdry, jops_start, ap_r, ap_len, ap_s, ap_op, ap_ops_start, ap_strings_end;
    var ap_i, ap_k, ap_d, ap_ab, ap_ah, ap_alim, ap_acomm, ap_aneed, ap_aj;
    var ap_alb, ap_alc, ap_all, ap_amark, ap_abitmap, ap_aused, ap_fixups, ap_pos, ap_size, ap_go, ap_tail, ap_padded;
    var ap_asyms, ap_aspec, ap_arel, ap_raddr, ap_acursor;
    var gn_r, ar_r, ws_r, bw_r;
    var cva, cvb, cvc, asyms, aspec, arel, fv_r, rc_r, rt_at, hx_r, raddr, rp_r, at_sys, pw2_r, rm_r, rm_h;
    var cn_at, it_id, sr_at, sf_r, sk_r, sn2_r;
    var la_r, ru_r, ri_r, rl2_r, pi_r;
    var cb_r, en_r, disp_r, mob_r, so_r, pi_r, pi_id, pt_r;
    var smr_r;
    var rqbuf[1044], rsbuf[1044];
    var shk[256], shw[256], shh[128], shd[32];
    var saved[192], jdhead[64], srt[32], empty0[8], lit[64];
    var tyT[48], tyV[48], flF[48], flH[48];
    var rframes[432], roffsets[512], rext_off[2048], rext_end[2048];
    var jemit_base, jemit_cap, scratch_base;

    # The journal state is established per request by m_begin; it starts empty here whatever the
    # frame carried in. The frame of a run is zero in tests/host/runner.c, but a dirty frame must
    # never look like a journal that is already open (a refusal would roll back over garbage).
    aj = 0;

    # native/live.cpp:101
    at = area;
    if (at == 0) {
        if (context != 0) {
            caps = load64(context + 56);
            capc = load64(context + 48);
            cap_i = 0;
            cap_go = 1;
            while (cap_i < capc & cap_go == 1) {
                if (load64(caps + 24 * cap_i) == 1) {
                    at = load64(caps + 24 * cap_i + 16);
                    cap_go = 0;
                }
                cap_i = cap_i + 1;
            }
        }
    }
    if (at == 0) {
        refuse 13;
    }
    ar = at;
    ctx = context;
    jemit_base = load64(ar + 72);
    jemit_cap = load64(ar + 80);
    scratch_base = load64(ar + 56);

    # native/live.cpp:120..168 -- one pump macro expansion, two phases. The C++ calls
    # pump() at four sites (wasm stop / relocated / batch / decay-failure); the Seed
    # port drives those sites through pu_limit/pu_stop_after/pu_phase so the serve
    # machinery exists exactly once in the emitted body -- the self-copy in the
    # relocation path copies THIS body, and four copies would quadruple it.
    pu_limit = 64;
    pu_stop_after = 0;
    pu_clear_reloc = 0;
    if (load32(ar + 252) == 3) {
        pu_stop_after = 1;
    } else {
        if (load32(ar + 260) != 0) {
            pu_limit = 1;
            pu_stop_after = 1;
            pu_clear_reloc = 1;
        }
    }
    pu_phase = 0;
    pu_again = 1;
    while (pu_again == 1) {
        pu_again = 0;
        m_pump(pu_limit, 1);
        if (pu_clear_reloc == 1) {
            store32(ar + 260, 0);
        }
        if (pu_stop_after == 1) {
            refuse 0;
        }
        if (pu_phase == 0) {
            if (load32(ar + 264) != 1) {
                refuse 0;
            }
            # native/live.cpp:139 -- the compactor asked for relocation: copy our own
            # rx body into log space (aligned) and tail-call the copy
            ob_self = 0;
            ob_size = 0;
            if (context != 0) {
                m_own_body();
            }
            ob_ground = (load64(ar + 24) + 63) & ~63;
            if (ob_self == 0 | ob_ground + ob_size > load64(ar + 24) + load64(ar + 32)) {
                store32(ar + 264, 2);
                pu_phase = 1;
                pu_again = 1;
            } else {
                ob_copy_i = 0;
                while (ob_copy_i < ob_size) {
                    store8(ob_ground + ob_copy_i, load8(ob_self + ob_copy_i));
                    ob_copy_i = ob_copy_i + 1;
                }
                store32(ar + 260, 1);
                store32(ar + 264, 0);
                tailcall_pp(ob_ground, context, area);
                refuse 0;
            }
        } else {
            store32(ar + 264, 0);
            refuse 0;
        }
    }
    refuse 0;
}

