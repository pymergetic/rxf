                                    store16(ar_to + 24 * ar_k + 18, load16(ar_rlist + 16 * ar_k + 10));
                                    store32(ar_to + 24 * ar_k + 20, load32(ar_rlist + 16 * ar_k + 12));
                                    if (load32(ar_rlist + 16 * ar_k) != 0xFFFFFFFF) {
                                        store32(ar_pend + 20 * ar_npend, ar_h);
                                        store32(ar_pend + 20 * ar_npend + 4, 2);
                                        store32(ar_pend + 20 * ar_npend + 8, ar_k);
                                        store32(ar_pend + 20 * ar_npend + 12,
                                                load32(ar_rlist + 16 * ar_k));
                                        store32(ar_pend + 20 * ar_npend + 16, ar_i);
                                        ar_npend = ar_npend + 1;
                                    }
                                    if (load32(ar_rlist + 16 * ar_k + 4) != 0xFFFFFFFF) {
                                        store32(ar_pend + 20 * ar_npend, ar_h);
                                        store32(ar_pend + 20 * ar_npend + 4, 3);
                                        store32(ar_pend + 20 * ar_npend + 8, ar_k);
                                        store32(ar_pend + 20 * ar_npend + 12,
                                                load32(ar_rlist + 16 * ar_k + 4));
                                        store32(ar_pend + 20 * ar_npend + 16, ar_i);
                                        ar_npend = ar_npend + 1;
                                    }
                                    ar_k = ar_k + 1;
                                }
                            }
                        }
                    }
                }
            } else {
                if (ar_op == 3) {
                    callsub s_string_at(load32(ar_d + ar_opos + 4), ar_strings, jb_ssize);
                    ar_p = sa_p;
                    ar_n = sa_n;
                    ar_pos = ar_opos + 8;
                    callsub s_resolve(ar_p, ar_n);
                    ar_h = rv_r;
                    if (ar_h == 0xFFFFFFFFFFFFFFFF) {
                        jb_reason = 3;
                        ar_ok = 0;
                    } else {
                        if (ar_h <= 2) {
                            jb_reason = 10;
                            ar_ok = 0;
                        } else {
                            m_table_del(ar_h);
                            m_destroy(ar_h);
                            if (de_r != 0) {
                                callsub s_reason_of(de_r);
                                jb_reason = ro2_r;
                                ar_ok = 0;
                            }
                        }
                    }
                } else {
                    ar_s = load32(ar_d + ar_opos + 4);
                    ar_pos = ar_opos + 8;
                    ar_h = 0xFFFFFFFFFFFFFFFF;
                    if (ar_s != 0xFFFFFFFF) {
                        callsub s_string_at(ar_s, ar_strings, jb_ssize);
                        callsub s_resolve(sa_p, sa_n);
                        ar_h = rv_r;
                        if (ar_h == 0xFFFFFFFFFFFFFFFF) {
                            jb_reason = 3;
                            ar_ok = 0;
                        }
                    }
                    if (ar_ok == 1) {
                        store32(ab + 28, ar_h);
                    }
                }
            }
            ar_i = ar_i + 1;
        }
    }
    if (ar_ok == 1) {
        ar_k = 0;
        while (ar_k < ar_npend & ar_ok == 1) {
            jb_at_op = load32(ar_pend + 20 * ar_k + 16);
            callsub s_string_at(load32(ar_pend + 20 * ar_k + 12), ar_strings, jb_ssize);
            callsub s_resolve(sa_p, sa_n);
            ar_t = rv_r;
            if (ar_t == 0xFFFFFFFFFFFFFFFF) {
                jb_reason = 3;
                ar_ok = 0;
            } else {
                if (load32(ar_pend + 20 * ar_k + 4) == 0) {
                    callsub s_set_field(load32(ar_pend + 20 * ar_k), 0, ar_t);
                    if (sf_r != 0) {
