# ---- the front end: what the interpreter checks, once, here (compile.c:1405) ---------------------

# have(): compile.c:1407 -- at <= count && words <= count - at.
macro m_have(pat, pn) {
  ok = 0;
  if ((pat) <= cc_count) {
    if ((pn) <= cc_count - (pat)) {
      ok = 1;
    }
  }
}

# in_frame(): compile.c:1412 -- width <= frame && offset <= frame - width.
macro m_in_frame(po, pw) {
  ok = 0;
  if ((pw) <= cc_frame) {
    if ((po) <= cc_frame - (pw)) {
      ok = 1;
    }
  }
}

# find_leaf(): compile.c:1417 -- the address of a leaf of the function table of the
# context (rxf_native_slot: id, generation, address).
macro m_find_leaf(pleaf) {
  fl_id = (pleaf);
  fl_addr = 0;
  fl_i = 0;
  fl_count = load64(c + 16);
  fl_table = load64(c + 24);
  while (fl_i < fl_count) {
    if (fl_addr == 0) {
      if (load64(fl_table + fl_i * 24) == fl_id) {
        fl_addr = load64(fl_table + fl_i * 24 + 16);
      }
    }
    fl_i = fl_i + 1;
  }
}

# channel_area(): compile.c:1426 -- the area of the first Channel in the capability table
# of the context, or 0.
macro m_channel_area() {
  ca_area = 0;
  ca_i = 0;
  ca_count = load64(c + 48);
  ca_table = load64(c + 56);
  while (ca_i < ca_count) {
    if (ca_area == 0) {
      if (load64(ca_table + ca_i * 24) == 1) {
        ca_area = load64(ca_table + ca_i * 24 + 16);
      }
    }
    ca_i = ca_i + 1;
  }
}

# entry(): stdlib_runtime.h:86 -- the halving search of the sorted table of the context.
macro m_entry(pident) {
  ent = 0;
  ent_lo = 0;
  ent_hi = load64(c + 32);
  ent_id = (pident);
  while (ent_lo < ent_hi) {
    ent_mi = ent_lo + ((ent_hi - ent_lo) / 2);
    if (load64(load64(c + 40) + ent_mi * 80) < ent_id) {
      ent_lo = ent_mi + 1;
    }
    else {
      ent_hi = ent_mi;
    }
  }
  if (ent_lo < load64(c + 32)) {
    ent = load64(c + 40) + ent_lo * 80;
    if (load64(ent) != ent_id) {
      ent = 0;
    }
  }
}

# check(): compile.c:1436 -- locate() of graph.c: the operand has `need` bytes; the address
# of an object. ck_st is the refusal, ck_obj the object's payload.
macro m_check(pop, pneed) {
  ck_st = 0;
  ck_obj = 0;
  ck_kind = load64(pop);
  if (ck_kind == 0) {
    m_in_frame(load64((pop) + 8), pneed);
    if (ok == 0) {
      ck_st = 6;
    }
  }
  else {
    if (ck_kind == 1) {
      if ((pneed) > 8) {
        ck_st = 6;
      }
    }
    else {
      if (ck_kind == 2) {
        m_entry(load64((pop) + 8));
        ck_found = ent;
        if (ck_found == 0) {
          ck_st = 13;
        }
        else {
          if ((pneed) > load64(ck_found + 32)) {
            ck_st = 6;
          }
          else {
            ck_obj = load64(ck_found + 24);
          }
        }
      }
      else {
        ck_st = 6;
      }
    }
  }
}

# value_check(): compile.c:1455 -- load() and pointer() of graph.c: an operand that becomes
# a value. A slot is read whole when its width is one a machine reads (1, 2, 4, 8), by
# address when it is wider (`wide`).
macro m_value_check(pop, pwide) {
  vc_st = 0;
  vc_obj = 0;
  vc_kind = load64(pop);
  if (vc_kind == 1) {
    if (load64((pop) + 16) > 8) {
      vc_st = 6;
    }
  }
  else {
    if (vc_kind == 2) {
      m_check(pop, 0);
      vc_st = ck_st;
      vc_obj = ck_obj;
    }
    else {
      if (vc_kind != 0) {
        vc_st = 6;
      }
      else {
        if ((pwide != 0) & (load64((pop) + 16) > 8)) {
          m_check(pop, load64((pop) + 16));
          vc_st = ck_st;
          vc_obj = ck_obj;
        }
        else {
          vc_need = load64((pop) + 16);
          if (vc_need >= 8) {
            vc_need = 8;
          }
          m_check(pop, vc_need);
          vc_st = ck_st;
          vc_obj = ck_obj;
          if (vc_st == 0) {
            vc_size = load64((pop) + 16);
            if (vc_size >= 8) {
              vc_size = 8;
            }
            if ((vc_size != 1) & (vc_size != 2) & (vc_size != 4) & (vc_size != 8)) {
              vc_st = 16;
            }
            else {
              if ((load64((pop) + 8) & (vc_size - 1)) != 0) {
                vc_st = 16;
              }
            }
          }
        }
      }
    }
  }
}

# terminal(): compile.c:1474 -- RETURN and REFUSE at `at`, written where the code is now.
macro m_terminal(pat) {
  t_w = cc_code + 8 * (pat);
  t_obj = 0;
  t_st = 0;
  if (load64(t_w) == 11) {
    t_width = load64(t_w + 32);
    if (t_width > 8) {
      m_check(t_w + 8, t_width);
      t_st = ck_st;
      t_obj = ck_obj;
    }
    else {
      m_value_check(t_w + 8, 0);
      t_st = vc_st;
      t_obj = vc_obj;
    }
    if (t_st == 0) {
      m_be_return(t_w + 8, t_obj, t_width);
      t_st = 0;
    }
  }
  else {
    m_value_check(t_w + 8, 0);
    t_st = vc_st;
    t_obj = vc_obj;
    if (t_st == 0) {
      m_be_refuse(t_w + 8, t_obj);
      t_st = 0;
    }
  }
}

# ---- plan(): the arguments of a call (compile.c:142) ---------------------------------------------

# plan(): compile.c:144 -- the arguments of a call, in the order of the C function of the
# leaf: an operand of the call, the context (6), the output (7), or the staged arguments
# of a program call (8). The letters are those of the shapes of graph.c; the shapes are
# those of graph.h:238. m_arg/m_type hold the words, pl_n how many.
macro m_plan(pshape) {
  pl_n = 0;
  if ((pshape) == 1) {
    store32(m_arg, 0);
    store32(m_type, 113);
    store32(m_arg + 4, 7);
    store32(m_type + 4, 111);
    pl_n = 2;
  }
  if ((pshape) == 2) {
    store32(m_arg, 0);
    store32(m_type, 113);
    store32(m_arg + 4, 1);
    store32(m_type + 4, 113);
    store32(m_arg + 8, 7);
    store32(m_type + 8, 111);
    pl_n = 3;
  }
  if ((pshape) == 5) {
    store32(m_arg, 6);
    store32(m_type, 99);
    store32(m_arg + 4, 0);
    store32(m_type + 4, 113);
    store32(m_arg + 8, 1);
    store32(m_type + 8, 113);
    store32(m_arg + 12, 2);
    store32(m_type + 12, 113);
    store32(m_arg + 16, 3);
    store32(m_type + 16, 113);
    store32(m_arg + 20, 4);
    store32(m_type + 20, 113);
    store32(m_arg + 24, 5);
    store32(m_type + 24, 112);
    store32(m_arg + 28, 7);
    store32(m_type + 28, 111);
    pl_n = 8;
  }
  if ((pshape) == 6) {
    store32(m_arg, 6);
    store32(m_type, 99);
    store32(m_arg + 4, 0);
    store32(m_type + 4, 112);
    pl_n = 2;
  }
  if ((pshape) == 13) {
    store32(m_arg, 0);
    store32(m_type, 119);
    store32(m_arg + 4, 1);
    store32(m_type + 4, 119);
    store32(m_arg + 8, 7);
    store32(m_type + 8, 111);
    pl_n = 3;
  }
  if ((pshape) == 17) {
    store32(m_arg, 0);
    store32(m_type, 113);
    store32(m_arg + 4, 1);
    store32(m_type + 4, 119);
    store32(m_arg + 8, 7);
    store32(m_type + 8, 111);
    pl_n = 3;
  }
  if ((pshape) == 14) {
    store32(m_arg, 0);
    store32(m_type, 112);
    store32(m_arg + 4, 1);
    store32(m_type + 4, 113);
    store32(m_arg + 8, 2);
    store32(m_type + 8, 112);
    store32(m_arg + 12, 3);
    store32(m_type + 12, 113);
    store32(m_arg + 16, 4);
    store32(m_type + 16, 113);
    pl_n = 5;
  }
  if ((pshape) == 15) {
    store32(m_arg, 0);
    store32(m_type, 112);
    store32(m_arg + 4, 1);
    store32(m_type + 4, 113);
    store32(m_arg + 8, 2);
    store32(m_type + 8, 112);
    store32(m_arg + 12, 3);
    store32(m_type + 12, 113);
    store32(m_arg + 16, 4);
    store32(m_type + 16, 113);
    store32(m_arg + 20, 7);
    store32(m_type + 20, 111);
    pl_n = 6;
  }
  if ((pshape) == 16) {
    store32(m_arg, 0);
    store32(m_type, 112);
    store32(m_arg + 4, 1);
    store32(m_type + 4, 113);
    store32(m_arg + 8, 2);
    store32(m_type + 8, 98);
    store32(m_arg + 12, 3);
    store32(m_type + 12, 113);
    pl_n = 4;
  }
  if ((pshape) == 3) {
    store32(m_arg, 6);
    store32(m_type, 99);
    store32(m_arg + 4, 0);
    store32(m_type + 4, 104);
    store32(m_arg + 8, 1);
    store32(m_type + 8, 112);
    store32(m_arg + 12, 2);
    store32(m_type + 12, 113);
    store32(m_arg + 16, 3);
    store32(m_type + 16, 113);
    store32(m_arg + 20, 7);
    store32(m_type + 20, 111);
    pl_n = 6;
  }
  if ((pshape) == 4) {
    store32(m_arg, 6);
    store32(m_type, 99);
    store32(m_arg + 4, 0);
    store32(m_type + 4, 104);
    store32(m_arg + 8, 1);
    store32(m_type + 8, 113);
    store32(m_arg + 12, 7);
    store32(m_type + 12, 111);
    pl_n = 4;
  }
  if ((pshape) == 7) {
    store32(m_arg, 6);
    store32(m_type, 99);
    store32(m_arg + 4, 0);
    store32(m_type + 4, 104);
    store32(m_arg + 8, 1);
    store32(m_type + 8, 113);
    pl_n = 3;
  }
  if ((pshape) == 8) {
    store32(m_arg, 6);
    store32(m_type, 99);
    store32(m_arg + 4, 0);
    store32(m_type + 4, 104);
    pl_n = 2;
  }
  if ((pshape) == 9) {
    store32(m_arg, 6);
    store32(m_type, 99);
    store32(m_arg + 4, 0);
    store32(m_type + 4, 104);
    store32(m_arg + 8, 1);
    store32(m_type + 8, 112);
    store32(m_arg + 12, 2);
    store32(m_type + 12, 113);
    store32(m_arg + 16, 3);
    store32(m_type + 16, 113);
    pl_n = 5;
  }
  if ((pshape) == 10) {
    store32(m_arg, 6);
    store32(m_type, 99);
    store32(m_arg + 4, 0);
    store32(m_type + 4, 104);
    store32(m_arg + 8, 1);
    store32(m_type + 8, 112);
    store32(m_arg + 12, 2);
    store32(m_type + 12, 113);
    store32(m_arg + 16, 3);
    store32(m_type + 16, 113);
    store32(m_arg + 20, 4);
    store32(m_type + 20, 113);
    pl_n = 6;
  }
  if ((pshape) == 11) {
    store32(m_arg, 6);
    store32(m_type, 99);
    store32(m_arg + 4, 0);
    store32(m_type + 4, 104);
    store32(m_arg + 8, 1);
    store32(m_type + 8, 112);
    store32(m_arg + 12, 2);
    store32(m_type + 12, 119);
    pl_n = 4;
  }
  if ((pshape) == 12) {
    store32(m_arg, 6);
    store32(m_type, 99);
    store32(m_arg + 4, 0);
    store32(m_type + 4, 104);
    store32(m_arg + 8, 1);
    store32(m_type + 8, 113);
    store32(m_arg + 12, 2);
    store32(m_type + 12, 104);
    store32(m_arg + 16, 3);
    store32(m_type + 16, 113);
    store32(m_arg + 20, 4);
    store32(m_type + 20, 112);
    store32(m_arg + 24, 7);
    store32(m_type + 24, 111);
    pl_n = 7;
  }
}

