}

# w_base(): compile.c:1038 -- the base is a local, or W_ABSOLUTE=255 for an absolute
# address (the instruction then carries it as its offset).
macro m_w_base(pbase) {
  if ((pbase) == 255) {
    m_w_i32(0);
  }
  else {
    m_w_get(pbase);
  }
}

macro m_w_load(psize, pwide, pbase, pdisp) {
  m_w_base(pbase);
  if ((pwide) != 0) {
    wl_op = 49;
    if ((psize) == 8) {
      wl_op = 41;
    }
    if ((psize) == 4) {
      wl_op = 53;
    }
    if ((psize) == 2) {
      wl_op = 51;
    }
    m_w_mem(wl_op, pdisp);
  }
  else {
    wl_op = 45;
    if ((psize) == 4) {
      wl_op = 40;
    }
    if ((psize) == 2) {
      wl_op = 47;
    }
    m_w_mem(wl_op, pdisp);
  }
}

macro m_w_store_size(psize) {
  ws2_op = 58;
  if ((psize) == 8) {
    ws2_op = 55;
  }
  if ((psize) == 4) {
    ws2_op = 54;
  }
  if ((psize) == 2) {
    ws2_op = 59;
  }
}

macro m_w_copy(pdb, pdst, psb, psrc, pcount) {
  wcp_done = 0;
  while (wcp_done < (pcount)) {
    wcp_left = (pcount) - wcp_done;
    wcp_size = 8;
    if (wcp_left < 8) {
      wcp_size = 4;
      if (wcp_left < 4) {
        wcp_size = 2;
        if (wcp_left < 2) {
          wcp_size = 1;
        }
      }
    }
    m_w_base(pdb);
    m_w_load(wcp_size, wcp_size == 8, psb, (psrc) + wcp_done);
    m_w_store_size(wcp_size);
    m_w_mem(ws2_op, (pdst) + wcp_done);
    wcp_done = wcp_done + wcp_size;
  }
}

macro m_w_zero(pbase, pdisp, pcount) {
  wz_done = 0;
  while (wz_done < (pcount)) {
    wz_left = (pcount) - wz_done;
    wz_size = 8;
    if (wz_left < 8) {
      wz_size = 4;
      if (wz_left < 4) {
        wz_size = 2;
        if (wz_left < 2) {
          wz_size = 1;
        }
      }
    }
    m_w_base(pbase);
    if (wz_size == 8) {
      m_w_i64(0);
    }
    else {
      m_w_i32(0);
    }
    m_w_store_size(wz_size);
    m_w_mem(ws2_op, (pdisp) + wz_done);
    wz_done = wz_done + wz_size;
  }
}

