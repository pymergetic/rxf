macro m_be_call_w() {
  bcw_ordinal = 0;
  bcw_i = 0;
  while (bcw_i < pl_n) {
    if (load32(m_type + 4 * bcw_i) == 104) {
      bcw_op = bc_operands + 24 * load32(m_arg + 4 * bcw_i);
      bcw_copy = 1280 + 24 * bcw_ordinal;
      bcw_ordinal = bcw_ordinal + 1;
      if (load64(bcw_op) == 2) {
        m_w_copy(4, bcw_copy, 255, load64(bc_objects + 8 * load32(m_arg + 4 * bcw_i)), 24);
      }
      else {
        m_w_copy(4, bcw_copy, 4, load64(bcw_op + 8), 24);
      }
    }
    bcw_i = bcw_i + 1;
  }
  bcw_ordinal = 0;
  bcw_i = 0;
  while (bcw_i < pl_n) {
    bcw_which = load32(m_arg + 4 * bcw_i);
    bcw_kind = load32(m_type + 4 * bcw_i);
    if (bcw_kind == 104) {
      m_w_get(4);
      m_w_i32(1280 + 24 * bcw_ordinal);
