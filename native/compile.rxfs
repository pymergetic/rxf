# be_if_else()/be_if_end(): compile.c:959 -- the skip is patched into the instruction that
# is there (the branch itself is kept).
macro m_be_if_else_a(pat) {
  if (o_write != 0) {
    if ((pat) + 4 <= o_cap) {
      afx_skip = (o_size - (pat)) / 4;
      afx_word = 0;
      afx_word = afx_word | load8(o_buf + (pat));
      afx_word = afx_word | (load8(o_buf + (pat) + 1) << 8);
      afx_word = afx_word | (load8(o_buf + (pat) + 2) << 16);
      afx_word = afx_word | (load8(o_buf + (pat) + 3) << 24);
      m_patch32(pat, afx_word | (afx_skip << 5));
    }
  }
}

macro m_be_if_end_a(pat) {
  if (o_write != 0) {
    if ((pat) + 4 <= o_cap) {
      afxe_skip = (o_size - (pat)) / 4;
      afxe_word = 0;
      afxe_word = afxe_word | load8(o_buf + (pat));
      afxe_word = afxe_word | (load8(o_buf + (pat) + 1) << 8);
      afxe_word = afxe_word | (load8(o_buf + (pat) + 2) << 16);
      afxe_word = afxe_word | (load8(o_buf + (pat) + 3) << 24);
      m_patch32(pat, afxe_word | (afxe_skip << 5));
    }
  }
}

macro m_be_if_else_end_a() {
  cc_nest = cc_nest;
