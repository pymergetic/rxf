}

# ---- compile_pass(): compile.c:1922 ---------------------------------------------------------------

# compile_pass(): one pass over the whole program: the prologue, the parameters, every
# instruction.
macro m_compile_pass(pwords, pparams) {
  cp_st = 0;
  o_size = 0;
  cc_nest = 0;
  o_failed = 0;
  m_be_begin(pwords);
  cp_used = 0;
  cp_i = 0;
  while (cp_i < (pparams)) {
    if (cp_st == 0) {
      cp_slot = load64(cc_code + 8 * (5 + 2 * cp_i));
      cp_width = load64(cc_code + 8 * (5 + 2 * cp_i + 1));
      m_in_frame(cp_slot, cp_width);
      if ((ok == 0) | (cp_width > (pwords) * 8 - cp_used)) {
        cc_at = 0;
        cp_st = 6;
      }
      else {
        m_be_param(cp_slot, cp_width, cp_used);
        cp_used = cp_used + ((cp_width + 7) & 0xFFFFFFFFFFFFFFF8);
      }
    }
    cp_i = cp_i + 1;
  }
  if (cp_st == 0) {
    m_be_dispatch();
    cp_pc = load64(cc_code + 32);
    cp_i = 0;
    while (cp_i < cc_instructions) {
      if (cp_st == 0) {
        cc_current = cp_i;
        store32(cc_offset + 4 * cp_i, o_size & 0xFFFFFFFF);
        m_instruction_size(cp_pc);
        cp_size = is_words;
        m_be_enter();
        m_compile_instruction(cp_pc, cp_size);
        cp_st = ci_st;
        if (cp_st != 0) {
          cc_at = cp_pc;
        }
        else {
          cp_pc = cp_pc + cp_size;
        }
      }
      cp_i = cp_i + 1;
    }
  }
  if (cp_st == 0) {
    m_be_tail();
  }
}

# ---- compile_program(): compile.c:1957 ------------------------------------------------------------

fn compile_program(c, request) {
  var ok, pk_size;
  var o_buf, o_cap, o_size, o_write, o_failed, o_word, o_pair;
  var cc_code, cc_count, cc_frame, cc_alloc, cc_instructions, cc_current, cc_nest, cc_at;
  var cc_index, cc_offset;
  var cc_area, cc_safe;
  var xr_rex, xc_done, xc_size, xz_done, xz_left, xz_size, xv_kind, xv_size;
  var bbx_at, bmx_kind, bmx_done, bmx_size, bmx_piece, xar_r, xaw_w, xaw_op, xhw_word;
  var bcx_handles, bcx_i, bcx_registers, bcx_left, bcx_at, bisx_size, bspx_at;
  var aii_shift, aii_piece, aal_op, aas_op, ac_done, ac_size, az_done, az_size;
  var av_kind, av_size, baa_at, bma_kind, bma_done, bma_size, bma_piece;
  var aah_op, aah_copy, aaw_w, aaw_op, bca_handles, bca_i, bcaa_at, bisa_size, bspaa_at;
  var afx_skip, afx_word, afxe_skip, afxe_word, bjw_words;
  var wu_value, wu_more, wu_byte, ws_value, ws_more, ws_byte, ws_sign, wss_value;
  var wl_op, ws2_op, wcp_done, wcp_left, wcp_size, wz_done, wz_left, wz_size;
  var wv_kind, wv_size, bmw_kind, bmw_done, bmw_left, bmw_size, bmw_piece;
  var bcw_ordinal, bcw_i, bcw_which, bcw_kind, bcw_op, bcw_copy, biww_op, bdi;
  var bc_function, bc_leaf, bc_operands, bc_objects, bc_has_out, bc_out_slot, bc_out_width;
  var bc_status;
  var fl_id, fl_addr, fl_i, fl_count, fl_table;
  var ca_area, ca_i, ca_count, ca_table;
  var ent, ent_lo, ent_hi, ent_mi, ent_id;
  var ck_st, ck_obj, ck_kind, ck_found;
  var vc_st, vc_obj, vc_kind, vc_need, vc_size;
  var t_w, t_obj, t_st, t_width;
  var pl_n;
  var so_id, so_shape, sl_n, sl_handles, sl_has_out;
  var cpc_at, cpc_w, cpc_st, cpc_count, cpc_out_slot, cpc_out_width, cpc_status, cpc_name;
  var cpc_operands, cpc_found, cpc_callee, cpc_cwords, cpc_params, cpc_words;
  var cpc_i, cpc_used, cpc_width, cpc_op, cpc_present, cpc_obj, cpc_word;
  var cpc_answer, cpc_zeroes, cpc_uncaught, cpc_function;
  var ccl_at, ccl_w, ccl_st, ccl_leaf, ccl_count, ccl_out_slot, ccl_out_width, ccl_shape;
  var ccl_n, ccl_has_out, ccl_i, ccl_function, ccl_which, ccl_op, ccl_obj, ccl_operands;
  var es_st, es_words, es_count;
  var is_st, is_words, is_w, is_op, is_named, is_count, is_first, is_second, is_at, is_i;
  var ce_at, ce_st, ce_words, ce_count, ce_used, ce_copy, ce_i, ce_width, ce_present;
  var ce_obj, ce_dst, ce_target, ce_next, ce_take;
  var ci_pc, ci_w, ci_st, ci_object, ci_other, ci_op, ci_have, ci_i, ci_from, ci_to;
  var ci_patch, ci_bytes, ci_width, ci_mask, ci_first, ci_words, ci_at;
  var cp_st, cp_used, cp_i, cp_slot, cp_width, cp_pc, cp_size;
  var if_at;
  var fn_st, fn_parameters, fn_words, fn_entry, fn_i, fn_pc, fn_size, fn_scan;
  var m_arg[32], m_type[32], m_objects[48];
  var cpc_call[72], cpc_handle[24], cpc_objects[24], ccl_objects[48];
  var op_field[24], op_literal[24], op_part[24], op_tag[24];

  # valid(): stdlib_runtime.h:99, and a place to write (compile.c:1959).
  fn_st = 13;
  if (c != 0) {
    if (load64(c) == 2) {
      if (load64(c + 8) >= 144) {
        if (request != 0) {
          if (load64(request) != 0) {
            if (load64(request + 16) != 0) {
              fn_st = 0;
            }
          }
        }
      }
    }
  }
  if (fn_st != 0) {
    refuse fn_st;
  }

  cc_code = load64(request);
  cc_count = load64(request + 8) / 8;
  o_buf = load64(request + 16);
  o_cap = load64(request + 24);
  o_size = 0;
  o_failed = 0;
  o_write = 0;
  cc_at = 0;
  cc_instructions = 0;
  cc_current = 0;
  cc_nest = 0;
  m_channel_area();
  cc_area = ca_area;
  cc_safe = 0;
  if (cc_area != 0) {
    m_find_leaf(38);
    cc_safe = fl_addr;
  }
  store64(request + 48, 0);
  store64(request + 56, 0);

  # the magic, the frame, the words of the program (compile.c:1978).
  m_have(0, 5);
  if (ok == 0) {
    refuse 14;
  }
  if (load64(cc_code) != 0x31475852) {
    refuse 14;
  }
  cc_frame = load64(cc_code + 8);
  fn_parameters = load64(cc_code + 16);
  fn_words = load64(cc_code + 24);
  fn_entry = load64(cc_code + 32);
  if (cc_frame > 1024) {
    refuse 6;
  }
  if ((cc_frame & 7) != 0) {
    refuse 6;
  }
  if (fn_parameters > cc_count) {
    refuse 6;
  }
  m_have(5, fn_parameters * 2);
  if (ok == 0) {
    refuse 6;
  }
  if (fn_words > 1024) {
    refuse 6;
  }

  # the tables of the passes (compile.c:1991).
  if (load64(request + 32) == 0) {
    store64(request + 56, cc_count * 8);
    refuse 9;
  }
  if ((load64(request + 32) & 3) != 0) {
    store64(request + 56, cc_count * 8);
    refuse 9;
  }
  if (load64(request + 40) / 8 < cc_count) {
    store64(request + 56, cc_count * 8);
    refuse 9;
  }
  cc_index = load64(request + 32);
  cc_offset = cc_index + 4 * cc_count;
  fn_i = 0;
  while (fn_i < cc_count) {
    store32(cc_index + 4 * fn_i, 0xFFFFFFFF);
    store32(cc_offset + 4 * fn_i, 0);
    fn_i = fn_i + 1;
  }

  # where each instruction starts (compile.c:2002).
  fn_pc = fn_entry;
  fn_st = 0;
  fn_scan = 1;
  while (fn_scan != 0) {
    if (fn_pc < cc_count) {
      if (fn_st == 0) {
        m_instruction_size(fn_pc);
        fn_st = is_st;
        if (fn_st == 0) {
          store32(cc_index + 4 * fn_pc, cc_instructions & 0xFFFFFFFF);
          cc_instructions = cc_instructions + 1;
          fn_pc = fn_pc + is_words;
        }
        else {
          fn_scan = 0;
        }
      }
      else {
        fn_scan = 0;
      }
    }
    else {
      fn_scan = 0;
    }
  }
  if ((fn_st == 0) & (cc_instructions == 0)) {
    fn_st = 6;
  }
  if (fn_st != 0) {
    store64(request + 56, fn_pc);
    refuse fn_st;
  }

  # the two passes (compile.c:2015).
  m_compile_pass(fn_words, fn_parameters);
  fn_st = cp_st;
  if (fn_st == 0) {
    store64(request + 48, o_size);
    if (o_size > o_cap) {
      refuse 9;
    }
    o_write = 1;
    m_compile_pass(fn_words, fn_parameters);
    fn_st = cp_st;
    if ((fn_st == 0) & (o_failed != 0)) {
      refuse 9;
    }
  }
  store64(request + 48, o_size);
  store64(request + 56, cc_at);
  refuse fn_st;
}
