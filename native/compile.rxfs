                    }
                    else {
                      store64(op_part + 8, 0);
                    }
                  }
                }
                m_be_move(load64(ci_w + 8), load64(ci_w + 16), op_part, ci_object,
                          load64(ci_w + 56));
              }
            }
          }
        }
        else {
          if (ci_op == 5) {
            m_in_frame(load64(ci_w + 8), load64(ci_w + 16));
            if (ok == 0) {
              ci_st = 6;
            }
            else {
              m_in_frame(load64(ci_w + 8) + load64(ci_w + 24), 4);
              if (ok == 0) {
                ci_st = 6;
              }
              else {
                if (load64(ci_w + 72) > load64(ci_w + 16)) {
                  ci_st = 6;
                }
                else {
                  if (load64(ci_w + 64) > load64(ci_w + 16) - load64(ci_w + 72)) {
                    ci_st = 6;
                  }
                  else {
                    ci_bytes = load64(ci_w + 72);
                    if (load64(ci_w + 56) < ci_bytes) {
                      ci_bytes = load64(ci_w + 56);
                    }
                    m_check(ci_w + 40, ci_bytes);
                    ci_object = ck_obj;
                    ci_st = ck_st;
                    if (ci_st == 0) {
                      m_be_zero(load64(ci_w + 8), load64(ci_w + 16));
                      store64(op_tag, 1);
                      store64(op_tag + 8, load64(ci_w + 32) & 0xFFFFFFFF);
                      store64(op_tag + 16, 4);
                      m_be_move(load64(ci_w + 8) + load64(ci_w + 24), 4, op_tag, 0, 4);
                      m_be_move(load64(ci_w + 8) + load64(ci_w + 64), ci_bytes, ci_w + 40,
                                ci_object, ci_bytes);
                    }
                  }
                }
              }
            }
          }
          else {
            if (ci_op == 6) {
              m_in_frame(load64(ci_w + 8), 1);
              if (ok == 0) {
                ci_st = 6;
              }
              else {
                m_value_check(ci_w + 16, 0);
                ci_object = vc_obj;
                ci_st = vc_st;
                if (ci_st == 0) {
                  m_value_check(ci_w + 40, 0);
                  ci_other = vc_obj;
                  ci_st = vc_st;
                }
                if (ci_st == 0) {
                  m_be_less(load64(ci_w + 8), ci_w + 16, ci_object, ci_w + 40, ci_other);
                }
              }
            }
            else {
              if (ci_op == 7) {
                m_in_frame(load64(ci_w + 8), load64(ci_w + 16));
                if (ok == 0) {
                  ci_st = 6;
                }
                else {
                  m_value_check(ci_w + 24, 0);
                  ci_object = vc_obj;
                  ci_st = vc_st;
                  if (ci_st == 0) {
                    if (load64(ci_w + 16) != 0) {
                      ci_width = load64(ci_w + 16);
                      ci_mask = ci_width;
                      if (ci_width >= 8) {
                        ci_mask = 8;
                      }
                      if (((ci_width != 1) & (ci_width != 2) & (ci_width != 4) & (ci_width < 8))
                          | ((load64(ci_w + 8) & (ci_mask - 1)) != 0)) {
                        ci_st = 16;
