  else {
    m_a_value(9, psrc, pobject, 0);
    m_a_store(8, 9, 21, 0);
  }
  m_put32(0x2A1F03E0);
  m_a_epilogue();
}

macro m_be_refuse_a(psrc, pobject) {
  m_a_value(0, psrc, pobject, 0);
  m_a_epilogue();
}

macro m_be_safe_point_a() {
  m_a_mov(0, 19);
  m_a_imm(1, cc_area);
  m_a_imm(16, cc_safe);
