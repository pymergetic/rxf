# shape_layout(): graph.h:332 -- the operands of a shape, which of them are handles (bit
# n), and whether it has an out. compile_call uses only how many operands it has.
macro m_shape_layout() {
  sl_n = 0;
  sl_handles = 0;
  sl_has_out = 1;
  if (so_shape == 1) { sl_n = 1; }
  if (so_shape == 2) { sl_n = 2; }
  if (so_shape == 3) { sl_n = 4; sl_handles = 1; }
  if (so_shape == 4) { sl_n = 2; sl_handles = 1; }
  if (so_shape == 5) { sl_n = 6; }
  if (so_shape == 6) { sl_n = 1; sl_has_out = 0; }
  if (so_shape == 7) { sl_n = 2; sl_handles = 1; sl_has_out = 0; }
  if (so_shape == 8) { sl_n = 1; sl_handles = 1; sl_has_out = 0; }
  if (so_shape == 9) { sl_n = 4; sl_handles = 1; sl_has_out = 0; }
  if (so_shape == 10) { sl_n = 5; sl_handles = 1; sl_has_out = 0; }
  if (so_shape == 11) { sl_n = 3; sl_handles = 1; sl_has_out = 0; }
  if (so_shape == 12) { sl_n = 5; sl_handles = 5; }
  if (so_shape == 13) { sl_n = 2; }
  if (so_shape == 14) { sl_n = 5; sl_has_out = 0; }
  if (so_shape == 15) { sl_n = 5; }
  if (so_shape == 16) { sl_n = 4; sl_has_out = 0; }
  if (so_shape == 17) { sl_n = 2; }
}

