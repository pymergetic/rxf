            else {
              m_check(ci_w + 24, load64(ci_w + 48) + load64(ci_w + 56));
              ci_object = ck_obj;
              ci_st = ck_st;
              if (ci_st == 0) {
                store64(op_part, load64(ci_w + 24));
                store64(op_part + 16, load64(ci_w + 56));
                if (load64(ci_w + 24) == 0) {
                  store64(op_part + 8, load64(ci_w + 32) + load64(ci_w + 48));
                }
                else {
                  if (load64(ci_w + 24) == 2) {
                    store64(op_part + 8, load64(ci_w + 32));
                    ci_object = ci_object + load64(ci_w + 48);
                  }
                  else {
