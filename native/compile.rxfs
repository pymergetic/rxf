  m_w_i64(1);
  m_put(124);
  if ((pwidth) >= 8) {
    m_w_mem(55, pdst);
  }
  else {
    m_put(167);
    biww_op = 58;
    if ((pwidth) == 4) {
      biww_op = 54;
    }
    if ((pwidth) == 2) {
      biww_op = 59;
    }
    m_w_mem(biww_op, pdst);
  }
}

macro m_be_value_w(pop, pobject) {
  m_w_value(pop, pobject, 0);
  m_put(33);
  m_w_uleb(7);
}

macro m_be_if_zero_w(pon_zero) {
  m_w_get(7);
  m_put(80);
  if ((pon_zero) == 0) {
    m_put(69);
  }
  m_put(4);
  m_put(64);
  cc_nest = cc_nest + 1;
  if_at = 0;
}

macro m_be_if_tag_w(ptag) {
  m_w_get(7);
  m_w_i64(ptag);
  m_put(81);
  m_put(4);
  m_put(64);
  cc_nest = cc_nest + 1;
  if_at = 0;
}

macro m_be_if_else_w(pat) {
  m_put(5);
}

macro m_be_if_end_w(pat) {
  m_put(11);
  cc_nest = cc_nest - 1;
}

macro m_be_if_else_end_w() {
  m_put(11);
  cc_nest = cc_nest - 1;
}

# be_dispatch(): compile.c:1369 -- a loop around one block for each instruction; br_table
# on the next instruction goes to the end of its block, which is where its code is.
macro m_be_dispatch_w() {
  m_put(3);
  m_put(64);
  bdi = 0;
  while (bdi < cc_instructions) {
    m_put(2);
    m_put(64);
    bdi = bdi + 1;
  }
  m_w_get(6);
  m_put(14);
  m_w_uleb(cc_instructions);
  bdi = 0;
  while (bdi < cc_instructions) {
    m_w_uleb(bdi);
    bdi = bdi + 1;
  }
  m_w_uleb(cc_instructions - 1);
}

macro m_be_enter_w() {
  m_put(11);
}

# be_jump(): compile.c:1391 -- the next instruction is `target`: back to the loop.
macro m_be_jump_w(ptarget) {
  m_w_i32(ptarget);
  m_put(33);
  m_w_uleb(6);
  m_put(12);
  m_w_uleb(cc_instructions - 1 - cc_current + cc_nest);
}

macro m_be_tail_w() {
  m_put(11);
  m_w_i32(6);
  m_w_leave();
  m_put(15);
  m_put(11);
}

# ---- the one dispatcher: host() folds to one seat -------------------------------------------------

macro m_be_begin(pwords) {
  if (host() == 0) {
    m_be_begin_x(pwords);
  }
  else {
    if (host() == 1) {
      m_be_begin_a(pwords);
    }
    else {
      m_be_begin_w(pwords);
    }
  }
}

macro m_be_param(pslot, pwidth, pused) {
