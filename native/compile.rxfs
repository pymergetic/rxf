    }
  }
}

# m_be_call(): the arguments are the plan's (m_arg/m_type, pl_n words); the wasm32 backend
# carries the leaf as well (the type of its call_indirect).
macro m_be_call(pfunction, pleaf, poperands, pobjects, phas_out, pout_slot, pout_width,
                pstatus) {
  bc_function = (pfunction);
  bc_leaf = (pleaf);
  bc_operands = (poperands);
  bc_objects = (pobjects);
  bc_has_out = (phas_out);
  bc_out_slot = (pout_slot);
  bc_out_width = (pout_width);
  bc_status = (pstatus);
  if (host() == 0) {
    m_be_call_x();
  }
  else {
    if (host() == 1) {
      m_be_call_a();
    }
    else {
      m_be_call_w();
    }
  }
}

macro m_be_return(psrc, pobject, pwidth) {
  if (host() == 0) {
