            m_w_i32(1024);
            m_put(106);
            m_put(173);
          }
          else {
            bcw_op = bc_operands + 24 * bcw_which;
            if ((bcw_kind == 98) & (load64(bcw_op) == 1)) {
              m_w_i32(load64(bcw_op + 8) & 255);
            }
            else {
              m_w_value(bcw_op, load64(bc_objects + 8 * bcw_which), 1);
