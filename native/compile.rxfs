                  ci_st = ce_st;
                }
                else {
                  if (ci_op == 9) {
                    ci_first = ci_pc + 5;
                    m_value_check(ci_w + 8, 0);
                    ci_object = vc_obj;
                    ci_st = vc_st;
                    if (ci_st == 0) {
                      m_edge_size(ci_first);
                      ci_st = es_st;
                      ci_words = es_words;
