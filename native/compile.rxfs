      else {
        av_size = 8;
        if (load64((pop) + 16) < 8) {
          av_size = load64((pop) + 16);
        }
        m_a_load(av_size, preg, 20, load64((pop) + 8));
      }
    }
  }
}

macro m_be_begin_a(pwords) {
  cc_alloc = 1424;
  m_put32(0xA9BD7BFD);
  m_put32(0xA90153F3);
  m_put32(0xF90013F5);
  m_put32(0xD10003FF | (cc_alloc << 10));
  m_a_add(20, 31, 0);
  m_a_mov(19, 0);
  m_a_mov(21, 3);
  m_put32(0xF100001F | ((pwords) << 10) | (2 << 5));
  baa_at = o_size;
  m_put32(0x54000000);
  m_put32(0x528000C0);
  m_a_epilogue();
  if (baa_at + 4 <= o_cap) {
    m_patch32(baa_at, 0x54000000 | (((o_size - baa_at) / 4) << 5));
  }
  m_a_zero(20, 0, cc_frame);
}

macro m_be_param_a(pslot, pwidth, pused) {
  m_a_copy(20, pslot, 1, pused, pwidth);
}

macro m_be_move_a(pslot, pwidth, psrc, pobject, phave) {
  m_a_zero(20, pslot, pwidth);
  bma_kind = load64(psrc);
  if (bma_kind == 0) {
    m_a_copy(20, pslot, 20, load64((psrc) + 8), phave);
  }
  else {
    if (bma_kind == 2) {
      m_a_imm(10, pobject);
      m_a_copy(20, pslot, 10, 0, phave);
    }
    else {
      bma_done = 0;
      while (bma_done < (phave)) {
        m_pick((phave) - bma_done, (pslot) + bma_done, 0);
        bma_size = pk_size;
        bma_piece = load64((psrc) + 8) >> (8 * bma_done);
        if (bma_size == 8) {
          m_a_imm(9, bma_piece);
        }
        else {
          m_a_imm(9, bma_piece & ((1 << (8 * bma_size)) - 1));
        }
        m_a_store(bma_size, 9, 20, (pslot) + bma_done);
        bma_done = bma_done + bma_size;
      }
    }
  }
}

# a_handle(): compile.c:819 -- a handle goes by address of a copy that the callee may
# change: the copy is in the frame.
macro m_a_handle(preg, pwhich, pordinal) {
  aah_op = bc_operands + 24 * (pwhich);
  aah_copy = 1280 + 24 * (pordinal);
  if (load64(aah_op) == 2) {
    m_a_imm(10, load64(bc_objects + 8 * (pwhich)));
    m_a_copy(20, aah_copy, 10, 0, 24);
  }
  else {
    m_a_copy(20, aah_copy, 20, load64(aah_op + 8), 24);
  }
  m_a_add(preg, 20, aah_copy);
}

macro m_a_argument(preg, pwhich, ptype, pout_slot) {
  aaw_w = (pwhich);
  if (aaw_w == 6) {
    m_a_mov(preg, 19);
  }
  else {
    if (aaw_w == 7) {
      m_a_add(preg, 20, pout_slot);
    }
    else {
      if (aaw_w == 8) {
        m_a_add(preg, 20, 1024);
      }
      else {
        aaw_op = bc_operands + 24 * aaw_w;
        if (((ptype) == 98) & (load64(aaw_op) == 1)) {
          m_a_imm(preg, load64(aaw_op + 8) & 255);
        }
        else {
          m_a_value(preg, aaw_op, load64(bc_objects + 8 * aaw_w), 1);
        }
      }
    }
  }
}

# be_call(): compile.c:843 (aarch64) -- each handle is copied to the frame and its address
# is passed; every argument goes in its register x0..x7.
macro m_be_call_a() {
  bca_handles = 0;
  bca_i = 0;
  while (bca_i < pl_n) {
    if (load32(m_type + 4 * bca_i) == 104) {
      m_a_handle(bca_i, load32(m_arg + 4 * bca_i), bca_handles);
      bca_handles = bca_handles + 1;
    }
    else {
      m_a_argument(bca_i, load32(m_arg + 4 * bca_i), load32(m_type + 4 * bca_i), bc_out_slot);
    }
    bca_i = bca_i + 1;
  }
  if (bc_has_out != 0) {
    m_a_zero(20, bc_out_slot, bc_out_width);
  }
  m_a_imm(16, bc_function);
  m_put32(0xD63F0000 | (16 << 5));
  if (bc_status == 0xFFFFFFFFFFFFFFFE) {
    bcaa_at = o_size;
    m_put32(0xB4000000);
    m_a_epilogue();
    if (bcaa_at + 4 <= o_cap) {
      m_patch32(bcaa_at, 0xB4000000 | (((o_size - bcaa_at) / 4) << 5));
    }
  }
  else {
    if (bc_status != 0xFFFFFFFFFFFFFFFF) {
      m_a_store(4, 0, 20, bc_status);
    }
  }
}

macro m_be_return_a(psrc, pobject, pwidth) {
  if ((pwidth) > 8) {
