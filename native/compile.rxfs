# compile_program_call(): a call of a program (word 1 is RXF_GRAPH_CALL): the callee runs
# in a run of its own -- the interpreter entry is leaf RXF_LEAF_GRAPH_RUN=49 -- with its
# handle and its arguments staged at RXF_STAGE_AT the way a run binds them. The compile
# resolves the callee where it stands: one published anew between this and the run refuses
# STALE_GENERATION -- the seam of a call that names its callee by the generation it has
# here.
macro m_compile_program_call(pat) {
  cpc_at = (pat);
  cpc_w = cc_code + 8 * cpc_at;
  cpc_st = 0;
  cpc_count = load64(cpc_w + 16);
  cpc_out_slot = load64(cpc_w + 24);
  cpc_out_width = load64(cpc_w + 32);
  cpc_status = load64(cpc_w + 40);
  cpc_name = cpc_w + 48;
  cpc_operands = cpc_name + 24;
  if ((load64(cpc_name) != 2) | (load64(cpc_name + 16) != 0)) {
    cpc_st = 6;
  }
  if (cpc_st == 0) {
    m_entry(load64(cpc_name + 8));
    cpc_found = ent;
    if (cpc_found == 0) {
      cpc_st = 13;
    }
    else {
      if (load64(cpc_found + 48) != 1) {
        cpc_st = 13;
      }
    }
  }
  if (cpc_st == 0) {
    if ((load64(cpc_found + 24) & 7) != 0) {
      cpc_st = 6;
    }
  }
  if (cpc_st == 0) {
    cpc_callee = load64(cpc_found + 24);
    cpc_cwords = load64(cpc_found + 32) / 8;
    if (cpc_cwords < 5) {
      cpc_st = 14;
    }
    else {
      if (load64(cpc_callee) != 0x31475852) {
        cpc_st = 14;
      }
    }
  }
  if (cpc_st == 0) {
    cpc_params = load64(cpc_callee + 16);
    cpc_words = load64(cpc_callee + 24);
    if ((cpc_params != cpc_count) | (cpc_params > cpc_cwords) | (5 + cpc_params * 2 > cpc_cwords)) {
      cpc_st = 6;
    }
  }
  if (cpc_st == 0) {
    if (cpc_out_slot != 0xFFFFFFFFFFFFFFFF) {
      if (cpc_out_width != 8) {
        cpc_st = 16;
      }
      else {
        m_in_frame(cpc_out_slot, cpc_out_width);
        if (ok == 0) {
          cpc_st = 16;
        }
      }
    }
  }
  if (cpc_st == 0) {
    if (cpc_status != 0xFFFFFFFFFFFFFFFF) {
      m_in_frame(cpc_status, 4);
      if ((ok == 0) | ((cpc_status & 3) != 0)) {
        if ((cpc_status & 3) != 0) {
          cpc_st = 16;
        }
        else {
          cpc_st = 6;
        }
      }
    }
  }
  if (cpc_st == 0) {
    cpc_i = 0;
    while (cpc_i + 5 <= cpc_cwords) {
      if (cpc_st == 0) {
        if (load64(cpc_callee + 8 * cpc_i) == 11) {
          if (load64(cpc_callee + 8 * (cpc_i + 4)) > 8) {
            cpc_st = 16;
          }
        }
      }
      cpc_i = cpc_i + 1;
    }
  }
  if (cpc_st == 0) {
    m_find_leaf(49);
    cpc_function = fl_addr;
    if (cpc_function == 0) {
      cpc_st = 13;
    }
  }
  if (cpc_st == 0) {
    cpc_used = 0;
    cpc_i = 0;
    while (cpc_i < cpc_params) {
      if (cpc_st == 0) {
        cpc_width = load64(cpc_callee + 8 * (5 + 2 * cpc_i + 1));
        cpc_op = cpc_operands + 24 * cpc_i;
        cpc_present = load64(cpc_op + 16);
        if (cpc_width < cpc_present) {
          cpc_present = cpc_width;
        }
        m_check(cpc_op, cpc_present);
        cpc_obj = ck_obj;
        cpc_st = ck_st;
        if (cpc_st == 0) {
          if (cpc_width > 256 - 24 - cpc_used) {
            cpc_st = 16;
          }
          else {
            m_be_move(1024 + cpc_used, cpc_width, cpc_op, cpc_obj, cpc_present);
            cpc_used = cpc_used + ((cpc_width + 7) & 0xFFFFFFFFFFFFFFF8);
          }
        }
      }
      cpc_i = cpc_i + 1;
    }
  }
  if (cpc_st == 0) {
    cpc_word = 0;
    while (cpc_word < 3) {
      store64(cpc_handle, 1);
      if (cpc_word == 0) {
        store64(cpc_handle + 8, load64(cpc_name + 8));
      }
      else {
        if (cpc_word == 1) {
          store64(cpc_handle + 8, load64(cpc_found + 8));
        }
        else {
          store64(cpc_handle + 8, 0);
        }
      }
      store64(cpc_handle + 16, 8);
      m_be_move(1024 + cpc_used + 8 * cpc_word, 8, cpc_handle, 0, 8);
      cpc_word = cpc_word + 1;
    }
  }
  if (cpc_st == 0) {
    store64(cpc_call, 0);
    store64(cpc_call + 8, 1024 + cpc_used);
    store64(cpc_call + 16, 24);
    store64(cpc_call + 24, 0);
    store64(cpc_call + 32, 0);
    store64(cpc_call + 40, 0);
    store64(cpc_call + 48, 1);
    store64(cpc_call + 56, cpc_words);
    store64(cpc_call + 64, 8);
    store64(cpc_objects, 0);
    store64(cpc_objects + 8, 0);
    store64(cpc_objects + 16, 0);
    store32(m_arg, 6);
    store32(m_type, 99);
    store32(m_arg + 4, 0);
    store32(m_type + 4, 104);
    store32(m_arg + 8, 8);
    store32(m_type + 8, 113);
    store32(m_arg + 12, 2);
    store32(m_type + 12, 113);
    store32(m_arg + 16, 7);
    store32(m_type + 16, 111);
    pl_n = 5;
    cpc_answer = cpc_out_slot;
    cpc_zeroes = 1;
    if (cpc_out_slot == 0xFFFFFFFFFFFFFFFF) {
      cpc_answer = 1304;
      cpc_zeroes = 0;
    }
    cpc_uncaught = cpc_status;
    if (cpc_status == 0xFFFFFFFFFFFFFFFF) {
      cpc_uncaught = 0xFFFFFFFFFFFFFFFE;
    }
    m_be_call(cpc_function, 49, cpc_call, cpc_objects, cpc_zeroes, cpc_answer, 8, cpc_uncaught);
  }
}

# ---- compile_call(): compile.c:1584 --------------------------------------------------------------

# compile_call(): the CALL of a leaf of the function table, or of a program.
macro m_compile_call(pat) {
  ccl_at = (pat);
  ccl_w = cc_code + 8 * ccl_at;
  ccl_operands = ccl_w + 48;
  ccl_st = 0;
  if (load64(ccl_w + 8) == 0) {
    m_compile_program_call(ccl_at);
    ccl_st = cpc_st;
  }
  else {
    ccl_leaf = load64(ccl_w + 8);
    ccl_count = load64(ccl_w + 16);
    ccl_out_slot = load64(ccl_w + 24);
    ccl_out_width = load64(ccl_w + 32);
    m_shape_of(ccl_leaf);
    ccl_shape = so_shape;
    m_plan(ccl_shape);
    ccl_n = pl_n;
    if (ccl_n == 0) {
      ccl_st = 16;
    }
    if (ccl_st == 0) {
      ccl_has_out = 0;
      ccl_i = 0;
      while (ccl_i < ccl_n) {
        if (load32(m_arg + 4 * ccl_i) == 7) {
          ccl_has_out = 1;
        }
        ccl_i = ccl_i + 1;
      }
    }
    if (ccl_st == 0) {
      m_shape_layout();
      if (sl_n != ccl_count) {
        ccl_st = 6;
      }
    }
    if (ccl_st == 0) {
      m_find_leaf(ccl_leaf);
      ccl_function = fl_addr;
      if (ccl_function == 0) {
        ccl_st = 13;
      }
    }
    if (ccl_st == 0) {
      ccl_i = 0;
      while (ccl_i < ccl_n) {
        if (ccl_st == 0) {
          ccl_which = load32(m_arg + 4 * ccl_i);
          if (ccl_which < 6) {
            ccl_op = ccl_operands + 24 * ccl_which;
            store64(ccl_objects + 8 * ccl_which, 0);
            if (load32(m_type + 4 * ccl_i) == 104) {
              m_check(ccl_op, 24);
              ccl_obj = ck_obj;
              ccl_st = ck_st;
            }
            else {
              m_value_check(ccl_op, 1);
              ccl_obj = vc_obj;
              ccl_st = vc_st;
            }
            if (ccl_st == 0) {
              if (load32(m_type + 4 * ccl_i) == 98) {
                if ((load64(ccl_op) != 1) & ((load64(ccl_op) != 0) | (load64(ccl_op + 16) != 1))) {
                  ccl_st = 16;
                }
              }
            }
            if (ccl_st == 0) {
              store64(ccl_objects + 8 * ccl_which, ccl_obj);
            }
          }
        }
        ccl_i = ccl_i + 1;
      }
    }
    if (ccl_st == 0) {
      if (ccl_has_out != 0) {
        if (ccl_out_slot == 0xFFFFFFFFFFFFFFFF) {
          ccl_st = 6;
        }
        else {
          m_in_frame(ccl_out_slot, ccl_out_width);
          if (ok == 0) {
            ccl_st = 6;
          }
        }
      }
      else {
        if (ccl_out_slot != 0xFFFFFFFFFFFFFFFF) {
          ccl_st = 6;
        }
      }
    }
    if (ccl_st == 0) {
      if (load64(ccl_w + 40) != 0xFFFFFFFFFFFFFFFF) {
        m_in_frame(load64(ccl_w + 40), 4);
        if ((ok == 0) | ((load64(ccl_w + 40) & 3) != 0)) {
          if ((load64(ccl_w + 40) & 3) != 0) {
            ccl_st = 16;
          }
          else {
            ccl_st = 6;
          }
        }
      }
    }
    if (ccl_st == 0) {
      m_be_call(ccl_function, ccl_leaf, ccl_operands, ccl_objects, ccl_has_out, ccl_out_slot,
                ccl_out_width, load64(ccl_w + 40));
    }
  }
}

# ---- edge_size()/instruction_size(): compile.c:1637, compile.c:1655 -------------------------------

# edge_size(): the words of an edge: its header, and five for each copy.
macro m_edge_size(pat) {
  es_st = 0;
  es_words = 0;
  m_have(pat, 2);
  if (ok == 0) {
    es_st = 6;
  }
  if (es_st == 0) {
    es_count = load64(cc_code + 8 * ((pat) + 1));
    if (es_count > 256) {
      es_st = 6;
    }
    else {
      m_have((pat) + 2, es_count * 5);
      if (ok == 0) {
        es_st = 6;
      }
    }
  }
  if (es_st == 0) {
    es_words = 2 + es_count * 5;
  }
}

# instruction_size(): the words of the instruction at `pc`, and that all of it is in the
# program.
macro m_instruction_size(ppc) {
  is_w = cc_code + 8 * (ppc);
  is_st = 0;
  is_words = 0;
  is_op = load64(is_w);
  if (is_op == 1) {
    is_named = 0;
    if (load64(is_w + 8) == 0) {
      is_named = 3;
    }
    m_have(ppc, 6);
    if (ok == 0) {
      is_st = 6;
    }
    else {
      is_count = load64(is_w + 16);
      if (is_count > 6) {
        is_st = 6;
      }
      else {
        m_have(ppc, 6 + is_named + is_count * 3);
        if (ok == 0) {
          is_st = 6;
        }
        else {
          is_words = 6 + is_named + is_count * 3;
        }
      }
    }
  }
  else {
    if ((is_op == 2) | (is_op == 7)) {
      is_words = 6;
      m_have(ppc, 6);
      if (ok == 0) {
        is_st = 6;
      }
    }
    else {
      if (is_op == 3) {
        m_have(ppc, 8);
        if (ok == 0) {
          is_st = 6;
        }
        else {
          is_count = load64(is_w + 56);
          if (is_count > cc_count) {
            is_st = 6;
          }
          else {
            m_have(ppc, 8 + is_count * 2);
            if (ok == 0) {
              is_st = 6;
            }
            else {
              is_words = 8 + is_count * 2;
            }
          }
        }
      }
      else {
        if ((is_op == 4) | (is_op == 6)) {
          is_words = 8;
          m_have(ppc, 8);
          if (ok == 0) {
            is_st = 6;
          }
        }
        else {
          if (is_op == 5) {
            is_words = 10;
            m_have(ppc, 10);
            if (ok == 0) {
              is_st = 6;
            }
          }
          else {
            if (is_op == 8) {
              m_edge_size((ppc) + 1);
              is_st = es_st;
              is_first = es_words;
              if (is_st == 0) {
                is_words = 1 + is_first;
              }
            }
            else {
              if (is_op == 9) {
                m_have(ppc, 5);
                if (ok == 0) {
                  is_st = 6;
                }
                else {
                  m_edge_size((ppc) + 5);
                  is_st = es_st;
                  is_first = es_words;
                  if (is_st == 0) {
                    m_edge_size((ppc) + 5 + is_first);
                    is_st = es_st;
                    is_second = es_words;
                    if (is_st == 0) {
                      is_words = 5 + is_first + is_second;
                    }
                  }
                }
              }
              else {
                if (is_op == 10) {
                  m_have(ppc, 5);
                  if (ok == 0) {
                    is_st = 6;
                  }
                  else {
                    is_count = load64(is_w + 32);
                    if (is_count > cc_count) {
                      is_st = 6;
                    }
                    else {
                      m_have(ppc, 5 + is_count);
                      if (ok == 0) {
                        is_st = 6;
                      }
                      else {
                        is_at = (ppc) + 5 + is_count;
                        is_i = 0;
                        while (is_i <= is_count) {
                          if (is_st == 0) {
                            m_edge_size(is_at);
                            is_st = es_st;
                            is_first = es_words;
                            if (is_st == 0) {
                              is_at = is_at + is_first;
                            }
                          }
                          is_i = is_i + 1;
                        }
                        if (is_st == 0) {
                          is_words = is_at - (ppc);
                        }
                      }
                    }
                  }
                }
                else {
                  if (is_op == 11) {
                    is_words = 5;
                    m_have(ppc, 5);
                    if (ok == 0) {
                      is_st = 6;
                    }
                  }
                  else {
                    if (is_op == 12) {
                      is_words = 4;
                      m_have(ppc, 4);
                      if (ok == 0) {
                        is_st = 6;
                      }
                    }
                    else {
                      is_st = 6;
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

# ---- compile_edge(): compile.c:1725 ---------------------------------------------------------------

# compile_edge(): take(): the copies of an edge staged and then written, and the jump to
# its target. `last` is the edge after which the next instruction follows: no jump to it
# is needed.
macro m_compile_edge(pat, plast) {
  ce_at = (pat);
  m_edge_size(ce_at);
  ce_st = es_st;
  ce_words = es_words;
  if (ce_st == 0) {
    ce_count = load64(cc_code + 8 * (ce_at + 1));
    ce_used = 0;
    ce_copy = ce_at + 2;
    ce_i = 0;
    while (ce_i < ce_count) {
      if (ce_st == 0) {
        ce_width = load64(cc_code + 8 * (ce_copy + 4));
        ce_present = load64(cc_code + 8 * (ce_copy + 2));
        if (ce_width < ce_present) {
          ce_present = ce_width;
        }
        m_check(cc_code + 8 * ce_copy, ce_present);
        ce_obj = ck_obj;
        ce_st = ck_st;
        if (ce_st == 0) {
          if (ce_width > 256 - ce_used) {
            ce_st = 6;
          }
          else {
            m_be_move(1024 + ce_used, ce_width, cc_code + 8 * ce_copy, ce_obj, ce_present);
            ce_used = ce_used + ce_width;
          }
        }
      }
      ce_copy = ce_copy + 5;
      ce_i = ce_i + 1;
    }
  }
  if (ce_st == 0) {
    ce_used = 0;
    ce_copy = ce_at + 2;
    ce_i = 0;
    while (ce_i < ce_count) {
      if (ce_st == 0) {
        ce_dst = load64(cc_code + 8 * (ce_copy + 3));
        ce_width = load64(cc_code + 8 * (ce_copy + 4));
        m_in_frame(ce_dst, ce_width);
        if (ok == 0) {
          ce_st = 6;
        }
        else {
          m_be_slot_copy(ce_dst, 1024 + ce_used, ce_width);
          ce_used = ce_used + ce_width;
        }
      }
      ce_copy = ce_copy + 5;
      ce_i = ce_i + 1;
    }
  }
  if (ce_st == 0) {
    ce_target = load64(cc_code + 8 * ce_at);
    ce_next = 0xFFFFFFFF;
    if (ce_target < cc_count) {
      ce_next = load32(cc_index + 4 * ce_target) & 0xFFFFFFFF;
    }
    if (ce_next == 0xFFFFFFFF) {
      ce_st = 16;
    }
    else {
      ce_take = 1;
      if ((plast != 0) & (ce_next == cc_current + 1)) {
        ce_take = 0;
      }
      if (ce_take != 0) {
        if ((ce_next <= cc_current) & (cc_area != 0) & (cc_safe != 0)) {
          m_be_safe_point();
        }
        m_be_jump(ce_next);
      }
    }
  }
}

# ---- compile_instruction(): compile.c:1762 --------------------------------------------------------

# compile_instruction(): the instruction at `pc`, written where the code is now.
macro m_compile_instruction(ppc, psize) {
  ci_pc = (ppc);
  ci_w = cc_code + 8 * ci_pc;
  ci_st = 0;
  ci_object = 0;
  ci_other = 0;
  ci_op = load64(ci_w);
  if (ci_op == 1) {
    m_compile_call(ci_pc);
    ci_st = ccl_st;
  }
  else {
    if (ci_op == 2) {
      ci_have = load64(ci_w + 40);
      if (load64(ci_w + 16) < ci_have) {
        ci_have = load64(ci_w + 16);
      }
      m_in_frame(load64(ci_w + 8), load64(ci_w + 16));
      if (ok == 0) {
        ci_st = 6;
      }
      else {
        m_check(ci_w + 24, ci_have);
        ci_object = ck_obj;
        ci_st = ck_st;
        if (ci_st == 0) {
          m_be_move(load64(ci_w + 8), load64(ci_w + 16), ci_w + 24, ci_object, ci_have);
