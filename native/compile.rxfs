# native/compile.rxfs: the in-image compiler of native/compile.c, in the Seed `fn` dialect.
#
# The port is line-by-line from native/compile.c: every helper is a macro (it expands
# inline; the state a helper shares with its callers -- the status, the object address --
# is named at the use site), and the driver is `compile_program` itself.
#
#     fn compile_program(c, request)
#
# is rxf_compile_program(c, request), the leaf RXF_LEAF_COMPILE_PROGRAM=31, shape `!pp`.
# Every exit is `refuse N` (the u32 status the C returns, no store through out): the
# request is filled through its own struct words -- out_size at +48, at at +56 -- exactly
# as the C writes them, and the memory effects and refusal codes are identical, including
# the edge cases (the work table checked last before use, `at` left 0 on an early
# RXF_REFUSE_OUT_OF_MEMORY, the word the scan stopped at).
#
# The state mirrors rxf_cc (compile.c:65): the program code/count, the writer (buf, cap,
# size, write, failed), the frame/alloc, the pass tables index/offset as one region each,
# instructions/current/nest, and at/area/safe. The three machine backends are three sets
# of macros -- m_be_*_x (x86_64, compile.c:260), m_be_*_a (aarch64, compile.c:677),
# m_be_*_w (wasm32, compile.c:985) -- and the m_be_* dispatchers pick by host(), which
# folds at compile time to one seat. Where the C has a quirk (the order of two checks, a
# width capped at 8, unsigned wraps), the quirk is kept: the C is the spec, and
# tests/graph_world.py's compiled() is the oracle.
#
# The translation table is docs/114-native-port.md §11.

# ---- the writer: put/put32/put64/patch32 (compile.c:86) ------------------------------------------

# put(): the byte is written only in the second pass (write), where there is room.
macro m_put(pb) {
  if (o_write != 0) {
    if (o_size < o_cap) {
      store8(o_buf + o_size, (pb) & 255);
    }
    else {
      o_failed = 1;
    }
  }
  o_size = o_size + 1;
}

# put32()/put64(): the value is taken ONCE, before the first byte moves `o_size`. A macro
# argument is spliced in textually: an expression over `o_size` passed straight into the four
# puts is re-evaluated as `o_size` grows (a jump distance of 0 came out 0xffffff00 that way --
# each byte was the borrow of the next put). compile.c evaluates the argument once.
macro m_put32(pv) {
  o_word = (pv);
  m_put(o_word);
  m_put(o_word >> 8);
  m_put(o_word >> 16);
  m_put(o_word >> 24);
}

macro m_put64(pv) {
  o_pair = (pv);
  m_put32((o_pair) & 4294967295);
  m_put32((o_pair) >> 32);
}

# patch32(): a word written into what was written before (a branch distance).
macro m_patch32(pat, pv) {
  if (o_write != 0) {
    if ((pat) + 4 <= o_cap) {
      store8(o_buf + (pat), (pv) & 255);
      store8(o_buf + (pat) + 1, ((pv) >> 8) & 255);
      store8(o_buf + (pat) + 2, ((pv) >> 16) & 255);
      store8(o_buf + (pat) + 3, ((pv) >> 24) & 255);
    }
  }
}

# pick(): compile.c:114 -- the size of the next piece of a copy: whole words where both
# ends are aligned. pk_size is 8, 4, 2 or 1.
macro m_pick(pl, pa, pb) {
  pk_size = 1;
  if ((pl) >= 2) {
    if ((((pa) | (pb)) & 1) == 0) {
      pk_size = 2;
      if ((pl) >= 4) {
        if ((((pa) | (pb)) & 3) == 0) {
          pk_size = 4;
          if ((pl) >= 8) {
            if ((((pa) | (pb)) & 7) == 0) {
              pk_size = 8;
            }
          }
        }
      }
    }
  }
}

# ---- x86_64 (compile.c:260) ----------------------------------------------------------------------

# x_rex(): compile.c:273 -- the REX byte only when it says something.
macro m_x_rex(pw, preg, prm) {
  xr_rex = 64 | ((pw) << 3) | (((preg) >> 3) << 2) | ((prm) >> 3);
  if (xr_rex != 64) {
    m_put(xr_rex);
  }
}

# x_mem(): compile.c:280 -- [base + disp32]; the bases used are never rsp or r12.
macro m_x_mem(preg, pbase, pdisp) {
  m_put(128 | (((preg) & 7) << 3) | ((pbase) & 7));
  m_put32(pdisp);
}

macro m_x_load(psize, preg, pbase, pdisp) {
  if ((psize) == 8) {
    m_x_rex(1, preg, pbase);
    m_put(139);
  }
  else {
    if ((psize) == 4) {
      m_x_rex(0, preg, pbase);
      m_put(139);
    }
    else {
      m_x_rex(1, preg, pbase);
      m_put(15);
      if ((psize) == 2) {
        m_put(183);
      }
      else {
        m_put(182);
      }
    }
  }
  m_x_mem(preg, pbase, pdisp);
}

macro m_x_store(psize, preg, pbase, pdisp) {
  if ((psize) == 2) {
    m_put(102);
  }
  if ((psize) == 8) {
    m_x_rex(1, preg, pbase);
  }
  else {
    m_x_rex(0, preg, pbase);
  }
  if ((psize) == 1) {
    m_put(136);
  }
  else {
    m_put(137);
  }
  m_x_mem(preg, pbase, pdisp);
}

macro m_x_imm(preg, pv) {
  if (((pv) >> 32) != 0) {
    m_x_rex(1, 0, preg);
    m_put(184 + ((preg) & 7));
    m_put64(pv);
  }
  else {
    m_x_rex(0, 0, preg);
    m_put(184 + ((preg) & 7));
    m_put32(pv);
  }
}

macro m_x_lea(preg, pbase, pdisp) {
  m_x_rex(1, preg, pbase);
  m_put(141);
  m_x_mem(preg, pbase, pdisp);
}

macro m_x_mov(pdst, psrc) {
  m_x_rex(1, psrc, pdst);
  m_put(137);
  m_put(192 | (((psrc) & 7) << 3) | ((pdst) & 7));
}

macro m_x_copy(pdb, pdst, psb, psrc, pcount) {
  xc_done = 0;
  while (xc_done < (pcount)) {
    m_pick((pcount) - xc_done, (pdst) + xc_done, (psrc) + xc_done);
    xc_size = pk_size;
    m_x_load(xc_size, 0, psb, (psrc) + xc_done);
    m_x_store(xc_size, 0, pdb, (pdst) + xc_done);
    xc_done = xc_done + xc_size;
  }
}

macro m_x_zero(pbase, pdisp, pcount) {
  if ((pcount) != 0) {
    m_put(49);
    m_put(192);
    xz_done = 0;
    while (xz_done < (pcount)) {
      xz_left = (pcount) - xz_done;
      xz_size = 8;
      if (xz_left < 8) {
        xz_size = 4;
        if (xz_left < 4) {
          xz_size = 2;
          if (xz_left < 2) {
            xz_size = 1;
          }
        }
      }
      m_x_store(xz_size, 0, pbase, (pdisp) + xz_done);
      xz_done = xz_done + xz_size;
    }
  }
}

macro m_x_epilogue() {
  m_put(72);
  m_put(129);
  m_put(196);
  m_put32(cc_alloc);
  m_put(65);
  m_put(95);
  m_put(91);
  m_put(93);
  m_put(195);
}

# x_value(): compile.c:385 -- the value of an operand in a register (load()/pointer() of
# graph.c). `pop` is the address of the operand's three words.
macro m_x_value(preg, pop, pobject, pwide) {
  xv_kind = load64(pop);
  if (xv_kind == 1) {
    m_x_imm(preg, load64((pop) + 8));
  }
  else {
    if (xv_kind == 2) {
      m_x_imm(preg, pobject);
    }
    else {
      if ((pwide != 0) & (load64((pop) + 16) > 8)) {
        m_x_lea(preg, 5, load64((pop) + 8));
      }
      else {
        xv_size = 8;
        if (load64((pop) + 16) < 8) {
          xv_size = load64((pop) + 16);
        }
        m_x_load(xv_size, preg, 5, load64((pop) + 8));
      }
    }
  }
}

# be_begin(): compile.c:407 -- the prologue: the interpreter's frame and more.
macro m_be_begin_x(pwords) {
  cc_alloc = 1424;
  m_put(85);
  m_put(83);
  m_put(65);
  m_put(87);
  m_put(72);
  m_put(129);
  m_put(236);
  m_put32(cc_alloc);
  m_put(72);
  m_put(137);
  m_put(229);
  m_x_mov(3, 7);
  m_x_mov(15, 1);
  m_put(72);
  m_put(129);
  m_put(250);
  m_put32(pwords);
  m_put(15);
  m_put(132);
  bbx_at = o_size;
  m_put32(0);
  m_x_imm(0, 6);
  m_x_epilogue();
  m_patch32(bbx_at, o_size - (bbx_at + 4));
  m_x_zero(5, 0, cc_frame);
}

macro m_be_param_x(pslot, pwidth, pused) {
  m_x_copy(5, pslot, 6, pused, pwidth);
}

macro m_be_move_x(pslot, pwidth, psrc, pobject, phave) {
  m_x_zero(5, pslot, pwidth);
  bmx_kind = load64(psrc);
  if (bmx_kind == 0) {
    m_x_copy(5, pslot, 5, load64((psrc) + 8), phave);
  }
  else {
    if (bmx_kind == 2) {
      m_x_imm(1, pobject);
      m_x_copy(5, pslot, 1, 0, phave);
    }
    else {
      bmx_done = 0;
      while (bmx_done < (phave)) {
        m_pick((phave) - bmx_done, (pslot) + bmx_done, 0);
        bmx_size = pk_size;
        bmx_piece = load64((psrc) + 8) >> (8 * bmx_done);
        if (bmx_size == 8) {
          m_x_imm(0, bmx_piece);
        }
        else {
          m_x_imm(0, bmx_piece & ((1 << (8 * bmx_size)) - 1));
        }
        m_x_store(bmx_size, 0, 5, (pslot) + bmx_done);
        bmx_done = bmx_done + bmx_size;
      }
    }
  }
}

macro m_x_argument_register(pi) {
  xar_r = 7;
  if ((pi) == 1) {
    xar_r = 6;
  }
  if ((pi) == 2) {
    xar_r = 2;
  }
  if ((pi) == 3) {
    xar_r = 1;
  }
  if ((pi) == 4) {
    xar_r = 8;
  }
  if ((pi) == 5) {
    xar_r = 9;
  }
}

# x_argument(): compile.c:458 -- one argument of a call in a register: the context, the
# output, the staged arguments of a program call, or an operand.
macro m_x_argument(preg, pwhich, ptype, pout_slot) {
  xaw_w = (pwhich);
  if (xaw_w == 6) {
    m_x_mov(preg, 3);
  }
  else {
    if (xaw_w == 7) {
      m_x_lea(preg, 5, pout_slot);
    }
    else {
      if (xaw_w == 8) {
        m_x_lea(preg, 5, 1024);
      }
      else {
        xaw_op = bc_operands + 24 * xaw_w;
        if (((ptype) == 98) & (load64(xaw_op) == 1)) {
          m_x_imm(preg, load64(xaw_op + 8) & 255);
        }
        else {
          m_x_value(preg, xaw_op, load64(bc_objects + 8 * xaw_w), 1);
        }
      }
    }
  }
}

macro m_x_push_slot(pdisp) {
  m_put(255);
  m_put(181);
  m_put32(pdisp);
}

macro m_x_push_object(pdisp) {
  m_put(255);
  if ((pdisp) != 0) {
    m_put(112);
    m_put(pdisp);
  }
  else {
    m_put(48);
  }
}

# x_push_handle(): compile.c:484 -- a handle goes by value on the stack: the three words,
# the last first, so that the first is the lowest.
macro m_x_push_handle(pop, pobject) {
  if (load64(pop) == 2) {
    m_x_imm(0, pobject);
  }
  xhw_word = 3;
  while (xhw_word > 0) {
    if (load64(pop) == 2) {
      m_x_push_object(8 * (xhw_word - 1));
    }
    else {
      m_x_push_slot(load64((pop) + 8) + 8 * (xhw_word - 1));
    }
    xhw_word = xhw_word - 1;
  }
}

# be_call(): compile.c:497 (x86_64) -- the handles are pushed first (the last first), the
# register arguments are loaded, the arguments beyond the six registers are pushed (the
# last first), and the callee is called through rax.
macro m_be_call_x() {
  bcx_handles = 0;
  bcx_i = 0;
  while (bcx_i < pl_n) {
    if (load32(m_type + 4 * bcx_i) == 104) {
      bcx_handles = bcx_handles + 1;
    }
    bcx_i = bcx_i + 1;
  }
  if ((bcx_handles & 1) != 0) {
    m_put(72);
    m_put(131);
    m_put(236);
    m_put(8);
  }
  bcx_i = pl_n;
  while (bcx_i > 0) {
    if (load32(m_type + 4 * (bcx_i - 1)) == 104) {
      m_x_push_handle(bc_operands + 24 * load32(m_arg + 4 * (bcx_i - 1)),
                      load64(bc_objects + 8 * load32(m_arg + 4 * (bcx_i - 1))));
    }
    bcx_i = bcx_i - 1;
  }
  bcx_registers = 0;
  bcx_i = 0;
  while (bcx_i < pl_n) {
    if (load32(m_type + 4 * bcx_i) != 104) {
      if (bcx_registers < 6) {
        m_x_argument_register(bcx_registers);
        bcx_registers = bcx_registers + 1;
        m_x_argument(xar_r, load32(m_arg + 4 * bcx_i), load32(m_type + 4 * bcx_i), bc_out_slot);
      }
    }
    bcx_i = bcx_i + 1;
  }
  bcx_i = pl_n;
  while (bcx_i > 6 + bcx_handles) {
    m_x_argument(0, load32(m_arg + 4 * (bcx_i - 1)), load32(m_type + 4 * (bcx_i - 1)),
                 bc_out_slot);
    m_put(80);
    bcx_i = bcx_i - 1;
  }
  if (bc_has_out != 0) {
    m_x_zero(5, bc_out_slot, bc_out_width);
  }
  m_x_imm(0, bc_function);
  m_put(255);
  m_put(208);
  bcx_left = 3 * bcx_handles + (bcx_handles & 1);
  if (pl_n > 6 + bcx_handles) {
    bcx_left = bcx_left + (pl_n - 6 - bcx_handles);
  }
  if (bcx_left != 0) {
    m_put(72);
    m_put(131);
    m_put(196);
    m_put(8 * bcx_left);
  }
  if (bc_status == 0xFFFFFFFFFFFFFFFE) {
    m_put(72);
    m_put(133);
    m_put(192);
    m_put(15);
    m_put(132);
    bcx_at = o_size;
    m_put32(0);
    m_x_epilogue();
    m_patch32(bcx_at, o_size - (bcx_at + 4));
  }
  else {
    if (bc_status != 0xFFFFFFFFFFFFFFFF) {
      m_x_store(4, 0, 5, bc_status);
    }
  }
}

macro m_be_return_x(psrc, pobject, pwidth) {
  if ((pwidth) > 8) {
    if (load64(psrc) == 2) {
      m_x_imm(1, pobject);
      m_x_copy(15, 0, 1, 0, pwidth);
    }
    else {
      m_x_copy(15, 0, 5, load64((psrc) + 8), pwidth);
    }
  }
  else {
    m_x_value(0, psrc, pobject, 0);
    m_x_store(8, 0, 15, 0);
  }
  m_put(49);
  m_put(192);
  m_x_epilogue();
}

macro m_be_refuse_x(psrc, pobject) {
  m_x_value(0, psrc, pobject, 0);
  m_x_epilogue();
}

# be_safe_point(): compile.c:572 -- the leaf is called on the context and the area, and
# what it answers other than OK is the status of the program.
macro m_be_safe_point_x() {
  m_x_mov(7, 3);
  m_x_imm(6, cc_area);
  m_x_imm(0, cc_safe);
  m_put(255);
  m_put(208);
  m_put(133);
  m_put(192);
  m_put(15);
  m_put(132);
  bspx_at = o_size;
  m_put32(0);
  m_x_epilogue();
  m_patch32(bspx_at, o_size - (bspx_at + 4));
}

macro m_be_zero_x(pslot, pwidth) {
  m_x_zero(5, pslot, pwidth);
}

macro m_be_slot_copy_x(pdst, psrc, pwidth) {
  m_x_copy(5, pdst, 5, psrc, pwidth);
}

# be_less(): compile.c:593 -- dst (one byte) = a < b, unsigned.
macro m_be_less_x(pdst, pa, paobj, pb, pbobj) {
  m_x_value(0, pa, paobj, 0);
  m_x_value(1, pb, pbobj, 0);
  m_put(72);
  m_put(57);
  m_put(200);
  m_put(15);
  m_put(146);
  m_put(192);
  m_x_store(1, 0, 5, pdst);
}

# be_increment(): compile.c:604 -- dst (width 1, 2, 4 or 8 bytes) = src + 1.
macro m_be_increment_x(pdst, pwidth, psrc, pobject) {
  m_x_value(0, psrc, pobject, 0);
  m_put(72);
  m_put(131);
  m_put(192);
  m_put(1);
  bisx_size = 8;
  if ((pwidth) < 8) {
    bisx_size = pwidth;
  }
  m_x_store(bisx_size, 0, 5, pdst);
}

macro m_be_value_x(pop, pobject) {
  m_x_value(10, pop, pobject, 0);
}

# be_if_zero(): compile.c:619 -- the code up to the matching end runs only when the value
# is zero (on_zero) or not. The place to patch is the distance of the skip.
macro m_be_if_zero_x(pon_zero) {
  m_put(77);
  m_put(133);
  m_put(210);
  m_put(15);
  if ((pon_zero) != 0) {
    m_put(133);
  }
  else {
    m_put(132);
  }
  if_at = o_size;
  m_put32(0);
}

# be_if_tag(): compile.c:630 -- ... only when the value is the tag.
macro m_be_if_tag_x(ptag) {
  m_x_imm(11, ptag);
  m_put(77);
  m_put(57);
  m_put(218);
  m_put(15);
  m_put(133);
  if_at = o_size;
  m_put32(0);
}

macro m_be_if_else_x(pat) {
  m_patch32(pat, o_size - ((pat) + 4));
}

macro m_be_if_end_x(pat) {
  m_patch32(pat, o_size - ((pat) + 4));
}

macro m_be_if_else_end_x() {
  cc_nest = cc_nest;
}

# be_jump(): compile.c:657 -- jmp to the start of instruction `target`.
macro m_be_jump_x(ptarget) {
  m_put(233);
  m_put32(load32(cc_offset + 4 * (ptarget)) - (o_size + 4));
}

macro m_be_tail_x() {
  m_x_imm(0, 6);
  m_x_epilogue();
}

# ---- aarch64 (compile.c:677) ---------------------------------------------------------------------

macro m_a_imm(preg, pv) {
  m_put32(0xD2800000 | (((pv) & 65535) << 5) | (preg));
  aii_shift = 1;
  while (aii_shift < 4) {
    aii_piece = ((pv) >> (16 * aii_shift)) & 65535;
    if (aii_piece != 0) {
      m_put32(0xF2800000 | (aii_shift << 21) | (aii_piece << 5) | (preg));
    }
    aii_shift = aii_shift + 1;
  }
}

macro m_a_load(psize, preg, pbase, pdisp) {
  aal_op = 0x39400000;
  if ((psize) == 8) {
    aal_op = 0xF9400000;
  }
  if ((psize) == 4) {
    aal_op = 0xB9400000;
  }
  if ((psize) == 2) {
    aal_op = 0x79400000;
  }
  m_put32(aal_op | (((pdisp) / (psize)) << 10) | ((pbase) << 5) | (preg));
}

macro m_a_store(psize, preg, pbase, pdisp) {
  aas_op = 0x39000000;
  if ((psize) == 8) {
    aas_op = 0xF9000000;
  }
  if ((psize) == 4) {
    aas_op = 0xB9000000;
  }
  if ((psize) == 2) {
    aas_op = 0x79000000;
  }
  m_put32(aas_op | (((pdisp) / (psize)) << 10) | ((pbase) << 5) | (preg));
}

macro m_a_mov(pdst, psrc) {
  m_put32(0xAA0003E0 | ((psrc) << 16) | (pdst));
}

macro m_a_add(pdst, pbase, pimm) {
  m_put32(0x91000000 | ((pimm) << 10) | ((pbase) << 5) | (pdst));
}

macro m_a_copy(pdb, pdst, psb, psrc, pcount) {
  ac_done = 0;
  while (ac_done < (pcount)) {
    m_pick((pcount) - ac_done, (pdst) + ac_done, (psrc) + ac_done);
    ac_size = pk_size;
    m_a_load(ac_size, 9, psb, (psrc) + ac_done);
    m_a_store(ac_size, 9, pdb, (pdst) + ac_done);
    ac_done = ac_done + ac_size;
  }
}

macro m_a_zero(pbase, pdisp, pcount) {
  az_done = 0;
  while (az_done < (pcount)) {
    m_pick((pcount) - az_done, (pdisp) + az_done, 0);
    az_size = pk_size;
    m_a_store(az_size, 31, pbase, (pdisp) + az_done);
    az_done = az_done + az_size;
  }
}

macro m_a_epilogue() {
  m_put32(0x910003FF | (cc_alloc << 10));
  m_put32(0xF94013F5);
  m_put32(0xA94153F3);
  m_put32(0xA8C37BFD);
  m_put32(0xD65F03C0);
}

# a_value(): compile.c:778 -- x20 is the frame.
macro m_a_value(preg, pop, pobject, pwide) {
  av_kind = load64(pop);
  if (av_kind == 1) {
    m_a_imm(preg, load64((pop) + 8));
  }
  else {
    if (av_kind == 2) {
      m_a_imm(preg, pobject);
    }
    else {
      if ((pwide != 0) & (load64((pop) + 16) > 8)) {
        m_a_add(preg, 20, load64((pop) + 8));
