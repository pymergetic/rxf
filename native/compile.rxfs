    bcw_i = bcw_i + 1;
  }
  if (bc_has_out != 0) {
    m_w_zero(4, bc_out_slot, bc_out_width);
  }
  m_w_i32(bc_function);
  m_put(17);
  m_w_uleb(bc_leaf - 1);
  m_put(0);
