    else {
      if (ci_op == 3) {
        ci_have = load64(ci_w + 40);
        if (load64(ci_w + 16) < ci_have) {
          ci_have = load64(ci_w + 16);
        }
        m_in_frame(load64(ci_w + 8), load64(ci_w + 16));
        if (ok != 0) {
          m_in_frame(load64(ci_w + 8) + load64(ci_w + 48), 4);
        }
        if (ok == 0) {
          ci_st = 6;
        }
        else {
          m_check(ci_w + 24, ci_have);
          ci_object = ck_obj;
          ci_st = ck_st;
          if (ci_st == 0) {
            m_be_move(load64(ci_w + 8), load64(ci_w + 16), ci_w + 24, ci_object, ci_have);
            if (load64(ci_w + 56) != 0) {
              store64(op_field, 0);
              store64(op_field + 8, load64(ci_w + 8) + load64(ci_w + 48));
              store64(op_field + 16, 4);
              m_value_check(op_field, 0);
              ci_other = vc_obj;
              ci_st = vc_st;
              if (ci_st == 0) {
                m_be_value(op_field, 0);
                ci_i = load64(ci_w + 56);
                while (ci_i > 0) {
                  ci_from = load64(ci_w + 8 * (8 + 2 * (ci_i - 1)));
                  ci_to = load64(ci_w + 8 * (9 + 2 * (ci_i - 1)));
                  if ((ci_from >> 32) == 0) {
                    m_be_if_tag(ci_from & 0xFFFFFFFF);
                    ci_patch = if_at;
                    store64(op_literal, 1);
                    store64(op_literal + 8, ci_to & 0xFFFFFFFF);
                    store64(op_literal + 16, 4);
                    m_be_move(load64(ci_w + 8) + load64(ci_w + 48), 4, op_literal, 0, 4);
                    m_be_if_end(ci_patch);
                  }
                  ci_i = ci_i - 1;
                }
              }
            }
          }
        }
      }
      else {
        if (ci_op == 4) {
          m_in_frame(load64(ci_w + 8), load64(ci_w + 16));
          if ((ok == 0) | (load64(ci_w + 56) > load64(ci_w + 16))) {
            ci_st = 6;
          }
          else {
            if ((load64(ci_w + 48) >> 32) != 0) {
              ci_st = 6;
