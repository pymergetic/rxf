# ---- wasm32 (compile.c:985) ----------------------------------------------------------------------

macro m_w_uleb(pv) {
  wu_value = (pv);
  wu_more = 1;
  while (wu_more != 0) {
    wu_byte = wu_value & 127;
    wu_value = wu_value >> 7;
    if (wu_value != 0) {
      m_put(wu_byte | 128);
    }
    else {
      m_put(wu_byte);
      wu_more = 0;
    }
  }
}

# w_sleb(): compile.c:1006 -- the shift of the C is arithmetic (the value is rxf_i64);
# here it is the logical shift of u64 with the sign bits put back.
macro m_w_sleb(pv) {
  ws_value = (pv);
  ws_more = 1;
  while (ws_more != 0) {
    ws_byte = ws_value & 127;
    ws_sign = ws_value & 0x8000000000000000;
    ws_value = ws_value >> 7;
    if (ws_sign != 0) {
      ws_value = ws_value | 0xFE00000000000000;
    }
    if ((ws_value == 0) & ((ws_byte & 64) == 0)) {
      m_put(ws_byte);
      ws_more = 0;
    }
    else {
      if ((ws_value == 0xFFFFFFFFFFFFFFFF) & ((ws_byte & 64) != 0)) {
        m_put(ws_byte);
        ws_more = 0;
      }
      else {
        m_put(ws_byte | 128);
      }
    }
  }
}

macro m_w_get(plocal) {
  m_put(32);
  m_w_uleb(plocal);
}

macro m_w_i32(pv) {
  m_put(65);
  m_w_sleb_sext(pv);
}

# w_i32(): compile.c:1017 -- the value is first the i32 it is taken from (the low 32 bits,
# sign-extended as the C casts it through (int)).
macro m_w_sleb_sext(pv) {
  wss_value = (pv) & 4294967295;
  if (wss_value >= 2147483648) {
    wss_value = wss_value | 0xFFFFFFFF00000000;
  }
  m_w_sleb(wss_value);
}

macro m_w_i64(pv) {
  m_put(66);
