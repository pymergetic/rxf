"""Echo: bounce a packet back to where it came from."""

import net.slip
from pymergetic.rxf import u16, u32, Option

u16 MTU = 1500
"""Largest payload in bytes."""

struct Packet:
    """One datagram."""
    u32 src
    u32 dst
    u16 length

class Echo:
    """Swaps source and destination and sends the packet on."""
    ref net.slip.Line line
    u32 count = 0

    class Stats:
        """Counters kept by one echo."""
        u32 seen = 0
        u32 span_total = 0

    Stats stats

    def swap(self, Packet p):
        """Swap the two addresses in place."""
        u32 tmp = p.src
        p.src = p.dst
        p.dst = tmp

    def Option<Packet> handle(self, Packet p):
        def u32 span(Packet q):
            return q.dst - q.src
        self.stats.seen += 1
        self.stats.span_total += span(p)
        if p.dst == 0:
            return none
        self.swap(p)
        self.count += 1
        return p

def Packet make(u32 src, u32 dst):
    Packet p = Packet(src, dst, 0)
    return p

def u16 length_of(Packet p):
    return p.length

fn<u16(Packet)> measure = length_of
