"""Echo: bounce a packet back to where it came from."""

import net.slip
from pymergetic.rxf.types import uint16_t, uint32_t
from pymergetic.rxf.templates import Option

uint16_t MTU = 1500
"""Largest payload in bytes."""

struct Packet:
    """One datagram."""
    uint32_t src
    uint32_t dst
    uint16_t length

class Echo:
    """Swaps source and destination and sends the packet on."""
    static uint32_t created = 0
    net.slip.Line line
    uint32_t count = 0

    class Stats:
        """Counters kept by one echo."""
        uint32_t seen = 0
        uint32_t span_total = 0

    Stats stats

    def swap(Echo self, Packet p):
        """Swap the two addresses in place."""
        uint32_t tmp = p.src
        p.src = p.dst
        p.dst = tmp

    def Option<Packet> handle(Echo self, Packet p):
        def uint32_t span(Packet q):
            return q.dst - q.src
        self.stats.seen += 1
        self.stats.span_total += span(p)
        if p.dst == 0:
            return none
        self.swap(p)
        self.count += 1
        return p

def Packet make(uint32_t src, uint32_t dst):
    Packet p = Packet(src, dst, 0)
    return p

def Packet duplicate(Packet p):
    Packet q = copy(p)
    return q

def uint16_t length_of(Packet p):
    return p.length

fn<uint16_t(Packet)> measure = length_of
