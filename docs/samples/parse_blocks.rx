"""Parse a large source in blocks, in parallel, and put the result together again in order.

A sketch for the workflow direction (docs/38, section 10). There is no run per block: the blocks lie
on a belt, and the carriers that are free take them. Nothing in it is agreed except what the earlier
sections fix; map and blocks are proposals.
"""

from pymergetic.rxf.types import uint8_t, uint32_t
from pymergetic.rxf.templates import list

class Record:
    """One parsed element."""
    uint32_t key
    uint32_t value

def list<Record> parse_block(list<uint8_t> block):
    """Parse one block. Writes only what it made itself, so any carrier may take it."""
    list<Record> out = list<Record>()
    for uint32_t i in range(len(block)):
        out.append(parse_one(block, i))
    return out

def list<Record> parse_all(list<uint8_t> source):
    list<list<Record>> parts = map(parse_block, blocks(source, 1000))
    list<Record> result = list<Record>()
    for list<Record> part in parts:
        result.extend(part)
    return result
