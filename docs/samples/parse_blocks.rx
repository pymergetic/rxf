"""Parse a large source in blocks, in parallel, and put the result together again in order.

A sketch for the workflow direction (docs/38, section 10). No run per block: blocks lie on a belt,
free carriers take them, and a stage that waits is an object with a wait state. Nothing here is
agreed except what the earlier sections fix; belt, map and blocks are proposals.
"""

from pymergetic.rxf.types import uint8_t, uint32_t
from pymergetic.rxf.templates import belt

class Record:
    """One parsed element."""
    uint32_t key
    uint32_t value

def list<Record> parse_block(list<uint8_t> block):
    """Parse one block. Writes only what it made itself, so any carrier may take it."""
    list<Record> out = list<Record>()
    for uint32_t i in range(len(block)):
        out.append(parse_one(block, i))
    return out

def list<Record> parse_all(list<uint8_t> source):
    belt<list<Record>> parts = source.blocks(1000).map(parse_block)
    return parts.collect()
