{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RXF",
  "scopeName": "source.rxf",
  "patterns": [
    { "include": "#comment" },
    { "include": "#declaration" },
    { "include": "#call" },
    { "include": "#keyword" },
    { "include": "#builtin" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#constant" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.rxf",
      "match": "#.*$"
    },
    "declaration": {
      "match": "\\b(program|proc|macro|fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.rxf" },
        "2": { "name": "entity.name.function.rxf" }
      }
    },
    "call": {
      "match": "\\b(call)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.flow.rxf" },
        "2": { "name": "entity.name.function.rxf" }
      }
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.directive.rxf",
          "match": "\\b(include|const)\\b"
        },
        {
          "name": "storage.type.rxf",
          "match": "\\bvar\\b"
        },
        {
          "name": "keyword.control.flow.rxf",
          "match": "\\b(if|else|while|switch|case|default|break|continue|return|refuse|ret)\\b"
        }
      ]
    },
    "builtin": {
      "patterns": [
        {
          "name": "support.function.memory.rxf",
          "match": "\\b(load(8|16|32|64)|store(8|16|32|64)|put|copy|fill)\\b(?=\\s*\\()"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.rxf",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.rxf", "match": "\\\\." }]
    },
    "number": {
      "patterns": [
        { "name": "constant.numeric.hex.rxf", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.decimal.rxf", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "constant": {
      "name": "constant.other.rxf",
      "match": "\\b[A-Z][A-Z0-9_]{1,}\\b"
    },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.comparison.rxf", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.shift.rxf", "match": "<<|>>" },
        { "name": "keyword.operator.arithmetic.rxf", "match": "[-+*]" },
        { "name": "keyword.operator.bitwise.rxf", "match": "[&|~]" },
        { "name": "keyword.operator.logical.rxf", "match": "!" },
        { "name": "keyword.operator.assignment.rxf", "match": "=" }
      ]
    }
  }
}
