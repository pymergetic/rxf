{
  "name": "rxf-lang",
  "displayName": "RXF source language",
  "description": "Syntax highlighting for .rxf, the source language of tools/native/rxfc.py",
  "version": "0.1.0",
  "publisher": "pymergetic",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "rxf",
        "aliases": ["RXF", "rxf"],
        "extensions": [".rxf"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rxf",
        "scopeName": "source.rxf",
        "path": "./syntaxes/rxf.tmLanguage.json"
      }
    ]
  }
}
