{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"], ["[", "]"], ["<", ">"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "\"\"\"", "close": "\"\"\"" }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(def|class|struct|if|elif|else|for|while)\\b.*:\\s*(#.*)?$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(def|class|struct|if|elif|else|for|while)\\b.*:\\s*(#.*)?$",
      "action": { "indent": "indent" }
    }
  ]
}
