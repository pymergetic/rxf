<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RXF Inspector · Loading {{ relative_path }}</title><style>
:root{color-scheme:dark;--bg:#0d1117;--panel:#161b22;--border:#30363d;--text:#c9d1d9;--muted:#8b949e;--accent:#58a6ff}*{box-sizing:border-box}body{min-height:100vh;margin:0;display:grid;place-items:center;background:var(--bg);color:var(--text);font:13px/1.45 system-ui,sans-serif}.card{width:min(560px,calc(100vw - 32px));padding:24px;border:1px solid var(--border);border-radius:8px;background:var(--panel)}h1{margin:0 0 6px;font-size:20px}.muted{color:var(--muted)}.track{height:10px;margin:20px 0 10px;overflow:hidden;border-radius:999px;background:#090c10}.bar{height:100%;width:0;background:var(--accent);transition:width .2s}.track.indeterminate .bar{width:35%;animation:slide 1.2s infinite ease-in-out}.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.fact{padding:8px;border:1px solid var(--border);border-radius:4px}.error{color:#ff7b72;white-space:pre-wrap}@keyframes slide{from{transform:translateX(-100%)}to{transform:translateX(300%)}}
</style></head><body><main class="card"><h1>Loading {{ relative_path }}</h1><p class="muted" id="phase">Starting measured RXF preload…</p><div class="track indeterminate" id="track"><div class="bar" id="bar"></div></div><div class="facts"><div class="fact"><strong id="work">—</strong><br><span class="muted">completed work</span></div><div class="fact"><strong id="percent">—</strong><br><span class="muted">completion</span></div><div class="fact"><strong id="elapsed">0.0s</strong><br><span class="muted">elapsed</span></div><div class="fact"><strong id="eta">—</strong><br><span class="muted">ETA · throughput</span></div></div><p class="error" id="error"></p></main><script>
const token={{ entry_id|tojson }};const originalQuery={{ query|tojson }};let stopped=false,reloaded=false,delay=300;const phase=document.querySelector('#phase'),track=document.querySelector('#track'),bar=document.querySelector('#bar'),work=document.querySelector('#work'),percent=document.querySelector('#percent'),elapsed=document.querySelector('#elapsed'),eta=document.querySelector('#eta'),error=document.querySelector('#error');
function seconds(value){return value==null?'—':`${value.toFixed(1)}s`}
function readyUrl(){const url=new URL(`/rxf/${token}`,location.origin);if(originalQuery.object!=null)url.searchParams.set('object',originalQuery.object);url.searchParams.set('ready','1');return url}
async function poll(){if(stopped)return;try{const response=await fetch(`/api/rxfs/${token}/load-progress`,{cache:'no-store'}),data=await response.json();if(!response.ok)throw new Error(data.detail||`Progress request failed (${response.status})`);phase.textContent=data.phase.replaceAll('_',' ');work.textContent=data.phase_total>0?`${data.phase_completed.toLocaleString()} / ${data.phase_total.toLocaleString()} ${data.phase_unit}`:`${data.phase_completed.toLocaleString()} ${data.phase_unit}`;elapsed.textContent=seconds(data.elapsed_seconds);eta.textContent=data.eta_seconds==null?(data.throughput==null?'—':`${data.throughput.toFixed(1)} work B/s`):`${seconds(data.eta_seconds)} · ${data.throughput.toFixed(1)} work B/s`;if(data.percent==null){track.classList.add('indeterminate');percent.textContent='indeterminate'}else{track.classList.remove('indeterminate');bar.style.width=`${data.percent}%`;percent.textContent=`${data.percent.toFixed(1)}%`}if(data.state==='done'){stopped=true;if(!reloaded){reloaded=true;location.replace(readyUrl())}return}if(data.state==='error'){stopped=true;error.textContent=data.error||'RXF preload failed.';return}delay=Math.min(750,delay+50);setTimeout(poll,delay)}catch(cause){delay=Math.min(1500,delay*1.5);error.textContent=`Progress temporarily unavailable: ${cause.message}`;setTimeout(poll,delay)}}poll();
</script></body></html>
