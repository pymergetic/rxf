<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RXF Inspector · {{ selected.relative_path }}</title><style>
:root{color-scheme:dark;--bg:#0d1117;--panel:#161b22;--border:#30363d;--text:#c9d1d9;--muted:#8b949e;--accent:#58a6ff;--selected:#f2cc60}*{box-sizing:border-box}html,body{height:100%;margin:0;background:var(--bg);color:var(--text);font:13px/1.4 system-ui,sans-serif}header{height:48px;display:flex;align-items:center;gap:12px;padding:8px 12px;border-bottom:1px solid var(--border);background:var(--panel)}header strong{color:var(--accent)}button{background:#21262d;color:var(--text);border:1px solid var(--border);border-radius:4px;padding:5px 8px}.split{height:calc(100% - 48px);display:grid;grid-template-columns:minmax(300px,.8fr) minmax(360px,1.2fr) minmax(320px,.9fr)}.pane{min-width:0;min-height:0;overflow:auto;padding:12px}.pane+ .pane{border-left:1px solid var(--border)}h2{margin:0 0 10px;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.08em}.canvas-wrap{height:calc(100% - 50px);min-height:300px;position:relative;border:1px solid var(--border);background:#090c10}canvas{width:100%;height:100%;display:block;cursor:crosshair}.tooltip{position:absolute;pointer-events:none;display:none;max-width:calc(100% - 12px);padding:5px 7px;background:#21262d;border:1px solid var(--border);border-radius:4px;overflow-wrap:anywhere}.catalog{display:flex;gap:6px;align-items:center}.catalog a{color:var(--text);padding:4px 7px;border-radius:4px;text-decoration:none}.catalog a.active{background:#263140;color:var(--accent)}.tree-tools,.object-nav{display:flex;gap:6px;margin-bottom:8px;flex-wrap:wrap}.object-nav button{color:var(--accent)}.tree-tools input{min-width:0;flex:1;background:#090c10;color:var(--text);border:1px solid var(--border);padding:5px}.detail-card{border:1px solid var(--border);margin-bottom:9px}.detail-card h3{font-size:11px;color:var(--muted);margin:0;padding:7px;border-bottom:1px solid var(--border)}.native-code .metadata{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.badge{display:inline-block;padding:1px 6px;border:1px solid var(--border);border-radius:999px}.badge.good{color:#3fb950}.badge.bad{color:#ff7b72}.hex-dump{overflow:auto;max-height:24rem;background:#090c10;padding:7px;font:12px/1.6 ui-monospace,monospace}.hex-row{display:grid;grid-template-columns:5.5rem minmax(27rem,1fr) 10rem;gap:8px;white-space:pre}.hex-row.entry-row{background:#332d17}.hex-offset{color:var(--muted)}.hex-byte{display:inline-block;width:1.75rem;text-align:center}.hex-byte.entry-byte{background:var(--selected);color:#111;font-weight:700}.hex-ascii{color:#a5d6ff}.native-list{display:grid;gap:5px;padding:7px}.native-item{border:1px solid #202832;padding:6px}.legend{padding:6px;color:var(--muted)}@media(max-width:600px){.native-code .metadata{grid-template-columns:1fr}}.detail-row,.object-link{display:block;width:100%;padding:6px 8px;border:0;border-bottom:1px solid #202832;background:transparent;color:var(--text);text-align:left}.object-link:hover{background:#21262d}.tree ul{list-style:none;margin:0;padding-left:18px}.tree>ul{padding:0}.tree li{position:relative;min-width:0}.tree .row{width:100%;min-width:0;display:grid;grid-template-columns:24px minmax(0,1fr);align-items:center}.tree .twisty-button{width:24px;min-width:0;border:0;background:transparent;padding:4px;color:var(--muted)}.tree .object-label{width:100%;min-width:0;overflow:hidden;display:grid;grid-template-columns:minmax(5.5rem,7.5rem) minmax(0,1fr) minmax(4.5rem,8rem);align-items:center;gap:6px;text-align:left;border:0;background:transparent;padding:4px}.tree .object-label:hover,.tree .object-label.selected{background:#21262d}.tree .object-label.selected{outline:1px solid var(--selected)}.tree .kind,.tree .name,.tree .id{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tree .kind{display:block;padding:1px 5px;border:1px solid var(--border);border-radius:999px;background:#161b22;color:var(--muted);font-size:10px;font-weight:600;letter-spacing:.03em;text-align:center;text-transform:uppercase}.tree .id{color:var(--muted);font-variant-numeric:tabular-nums;text-align:right}.summary{margin-left:auto;color:var(--muted)}@media(max-width:850px){.split{grid-template-columns:1fr;grid-template-rows:1fr 1fr}.pane+.pane{border-left:0;border-top:1px solid var(--border)}}
</style></head><body><header><strong>RXF Inspector</strong><nav class="catalog">{% for mount in mounts %}{% for entry in mount.entries %}<a class="{% if entry.id == selected.id %}active{% endif %}" href="/rxf/{{ entry.encoded_id }}">{{ entry.relative_path }}</a>{% endfor %}{% endfor %}</nav><label>Global HeapImage · {{ selected.heap.committed_size }} B committed · limit {{ selected.heap.limit if selected.heap.limit is not none else "unknown" }}</label><label>Active target <select id="active-target"><option value="">none</option></select></label><button id="binding-health">Binding health</button><button id="reset">Reset zoom</button><span class="summary" id="summary">{{ selected.function_count }} Functions · {{ selected.code_count }} Code · {{ selected.module_count }} Modules · {{ selected.target_count }} targets{% if not selected.code_count %} · no Code in this image{% endif %}</span></header><main class="split"><section class="pane tree"><h2>Parent / child object tree</h2><div class="object-nav"><button data-nav="entry">Entry</button><button data-nav="application">Application</button><button data-nav="library">Library</button><button data-nav="basic">Basic</button><button data-nav="foundation">Foundation</button><button data-nav="code">Code{% if selected.code_count > 1 %} ({{ selected.code_count }}){% endif %}</button></div><div class="tree-tools"><input id="search" type="search" placeholder="Find object by FQN or ID"><button id="collapse-all">Collapse all</button></div><ul id="tree"></ul><div id="results"></div></section><section class="pane"><h2>Global HeapImage — image {{ selected.heap.image_size }} B · committed {{ selected.heap.committed_size }} B · frontier {{ selected.heap.frontier }} B · limit {{ selected.heap.limit if selected.heap.limit is not none else "unknown" }} · page {{ selected.heap.page_size }} B</h2><div class="canvas-wrap"><canvas id="memory"></canvas><div class="tooltip" id="tooltip"></div></div></section><section class="pane"><h2>Selected object details</h2><div id="details" class="muted">Select an object from the tree, search, or memory.</div></section></main><script>
const token={{ selected.encoded_id|tojson }};const initialObject={{ selected.initial_object|tojson }};const objectNav={{ selected.navigation|tojson }};const canvas=document.querySelector('#memory'),ctx=canvas.getContext('2d'),tooltip=document.querySelector('#tooltip'),tree=document.querySelector('#tree'),summary=document.querySelector('#summary');let memory=null,selected=null,view={start:0,end:0};const colors=['#58a6ff','#3fb950','#d2a8ff','#f0883e','#db61a2','#39c5cf','#a5d6ff','#ff7b72'];
function color(type){if(type==null)return '#21262d';let h=0;for(const c of String(type))h=(h*33+c.charCodeAt(0))>>>0;return colors[h%colors.length]}
async function loadMemory(){const bins=Math.max(64,Math.min(2048,Math.floor(canvas.clientWidth*devicePixelRatio)));const q=new URLSearchParams({bins,start:view.start,end:view.end});memory=await fetch(`/api/rxfs/${token}/memory?${q}`).then(r=>r.json());view.start=memory.start;view.end=memory.end;draw()}
function draw(){const r=canvas.getBoundingClientRect(),d=devicePixelRatio;canvas.width=Math.floor(r.width*d);canvas.height=Math.floor(r.height*d);ctx.clearRect(0,0,canvas.width,canvas.height);const cols=Math.max(8,Math.floor(Math.sqrt(memory.bins.length*canvas.width/canvas.height))),rows=Math.ceil(memory.bins.length/cols),cw=canvas.width/cols,ch=canvas.height/rows;memory.bins.forEach((b,i)=>{const x=(i%cols)*cw,y=Math.floor(i/cols)*ch;ctx.fillStyle=b.used?color(b.dominant_type):'#161b22';ctx.globalAlpha=b.used?.25+.75*b.occupancy:1;ctx.fillRect(x+.5,y+.5,Math.max(1,cw-1),Math.max(1,ch-1));if(selected&&b.node_id===selected){ctx.globalAlpha=1;ctx.strokeStyle='#f2cc60';ctx.lineWidth=2*d;ctx.strokeRect(x+1,y+1,cw-2,ch-2)}});ctx.globalAlpha=1;canvas._grid={cols,rows,cw,ch}}
function binAt(e){if(!memory)return null;const r=canvas.getBoundingClientRect(),g=canvas._grid,x=(e.clientX-r.left)*devicePixelRatio,y=(e.clientY-r.top)*devicePixelRatio,i=Math.floor(y/g.ch)*g.cols+Math.floor(x/g.cw);return {bin:memory.bins[i],index:i,x:e.clientX-r.left,y:e.clientY-r.top}}
function positionTooltip(e){const wrap=canvas.closest('.canvas-wrap'),bounds=wrap.getBoundingClientRect(),margin=6,offset=12,cursorX=e.clientX-bounds.left,cursorY=e.clientY-bounds.top,tipWidth=tooltip.offsetWidth,tipHeight=tooltip.offsetHeight;let x=cursorX+offset,y=cursorY+offset;if(x+tipWidth>bounds.width-margin)x=cursorX-offset-tipWidth;if(y+tipHeight>bounds.height-margin)y=cursorY-offset-tipHeight;x=Math.max(margin,Math.min(x,bounds.width-tipWidth-margin));y=Math.max(margin,Math.min(y,bounds.height-tipHeight-margin));tooltip.style.left=`${x}px`;tooltip.style.top=`${y}px`}
canvas.onmousemove=e=>{const hit=binAt(e);if(!hit?.bin)return;const span=memory.end-memory.start,a=memory.start+Math.floor(hit.index*span/memory.bins.length),b=memory.start+Math.floor((hit.index+1)*span/memory.bins.length);tooltip.textContent=`0x${a.toString(16)}–0x${b.toString(16)} · ${hit.bin.count} cells · ${hit.bin.used} used bytes`;tooltip.style.display='block';positionTooltip(e)};canvas.onmouseleave=()=>tooltip.style.display='none';canvas.onclick=e=>{const b=binAt(e)?.bin;if(b?.node_id!=null)selectNode(b.node_id)};canvas.ondblclick=e=>{const h=binAt(e);if(!h)return;const span=view.end-view.start,c=Math.floor(view.start+(h.index+.5)*span/memory.bins.length),next=Math.max(64,Math.floor(span/4));view={start:Math.max(0,c-next/2),end:Math.min(memory.heap.committed_size,c+next/2)};loadMemory()};
async function children(parent=null){const q=parent==null?'':`?parent=${encodeURIComponent(parent)}`;return fetch(`/api/rxfs/${token}/tree${q}`).then(r=>r.json())}
async function toggleNode(li,twisty,n,forceOpen=false){if(!n.has_children)return;let child=li.querySelector(':scope > ul');if(!child){child=document.createElement('ul');li.append(child);await appendChildren(child,n.id)}const open=forceOpen||child.hidden;child.hidden=!open;twisty.textContent=open?'▾':'▸';twisty.setAttribute('aria-expanded',String(open))}
async function appendChildren(ul,parent){for(const n of await children(parent)){const li=document.createElement('li'),row=document.createElement('div'),twisty=document.createElement('button'),label=document.createElement('button');row.className='row';twisty.className='twisty-button';twisty.type='button';twisty.textContent=n.has_children?'▸':'·';twisty.setAttribute('aria-label',n.has_children?`Expand ${n.fqn}`:`${n.fqn} has no children`);twisty.setAttribute('aria-expanded','false');twisty.disabled=!n.has_children;label.className='object-label';label.type='button';label.dataset.id=n.id;label.innerHTML=`<span class="kind" title="${escapeHtml(n.kind)}">${escapeHtml(n.kind)}</span><span class="name" title="${escapeHtml(n.fqn)}">${escapeHtml(n.name)}</span><span class="id" title="#${escapeHtml(n.id)}">#${escapeHtml(n.id)}</span>`;twisty.onclick=e=>{e.stopPropagation();toggleNode(li,twisty,n)};label.onclick=()=>selectNode(n.id,true);row.append(twisty,label);li.append(row);ul.append(li)}}
function linkButton(id,name,label=''){if(id==null)return '';return `<button class="object-link" data-object="${id}">${label}${name||'object'} #${id}</button>`}
async function showDetails(id){const n=await fetch(`/api/rxfs/${token}/nodes/${encodeURIComponent(id)}`).then(r=>r.json());const parent=n.parent_object?linkButton(n.parent_object.id,n.parent_object.name):'<div class="detail-row">ROOT has no parent.</div>';const childrenHtml=n.children.map(c=>linkButton(c.id,c.name,`${c.kind} · `)).join('')||'<div class="detail-row">No direct children.</div>';const refs=n.references.map(r=>linkButton(r.target,r.target_name,`${r.kind} → `)).join('')||'<div class="detail-row">No references.</div>';const type=n.type_id!=='0'?linkButton(n.type_id,'type object'): '<div class="detail-row">No TYPE object.</div>';const owner=n.owner?linkButton(n.owner,'owner object'): '<div class="detail-row">Shared / no owner object.</div>';const execution=n.execution?executionDetails(n.execution):'';details.innerHTML=`<h1>${escapeHtml(n.fqn)}</h1><p>${n.kind} · #${n.id}</p><section class="detail-card"><h3>Parent</h3>${parent}<h3>Direct children</h3>${childrenHtml}</section><section class="detail-card"><h3>References (distinct from parent tree)</h3>${refs}</section><section class="detail-card"><h3>Type</h3>${type}<h3>Ownership / lifecycle</h3>${owner}<div class="detail-row">${n.owner_kind} · ${n.state.disposition} · ${n.state.cleanliness}</div></section>${execution}<section class="detail-card"><h3>Attributes</h3><pre>${escapeHtml(JSON.stringify(n.attrs,null,2))}</pre></section>`;details.querySelectorAll('[data-object]').forEach(b=>b.onclick=()=>selectNode(b.dataset.object,true))}
function executionDetails(execution){if(execution.category==='Code')return nativeCodeDetails(execution);const links=(execution.object_links||[]).map(link=>linkButton(link.id,link.name,`${link.role} · `)).join('');const facts=Object.fromEntries(Object.entries(execution).filter(([key])=>key!=='object_links'));return `<section class="detail-card"><h3>Function / Call / Code</h3>${links}<pre>${escapeHtml(JSON.stringify(facts,null,2))}</pre></section>`}
function nativeCodeDetails(code){const effects=code.effects.names.length?code.effects.names.join(', '):'NONE';const meta=[['Format',code.format],['Bytes',`${code.byte_count} (${code.hexdump.displayed_byte_count} displayed${code.hexdump.truncated?', truncated':''})`],['Entry',`${code.entry_offset} / 0x${code.entry_offset.toString(16)}`],['Effects',`${effects} · flags 0x${code.effects.flags.toString(16)}`],['Version',code.semantic_version],['Digest',code.semantic_digest]].map(([k,v])=>`<div class="detail-row"><strong>${escapeHtml(k)}</strong> · ${escapeHtml(v)}</div>`).join('');const rows=code.hexdump.rows.map(row=>{const bytes=row.cells.map((cell,i)=>`<span class="hex-byte ${row.entry_index===i?'entry-byte':''}">${cell||'  '} </span>`).join('');return `<div class="hex-row ${row.contains_entry?'entry-row':''}"><span class="hex-offset">${escapeHtml(row.offset_hex)}</span><span>${bytes}</span><span class="hex-ascii">${escapeHtml(row.ascii)}</span></div>`}).join('');const target=code.target;const targetFacts=target?`<div class="native-list">${linkButton(target.id,target.name,'RuntimeTarget · ')}${linkButton(target.architecture.id,target.architecture.name,'Architecture · ')}${linkButton(target.abi.id,target.abi.name,'ABI · ')}${linkButton(target.environment.id,target.environment.name,'Environment · ')}${linkButton(target.feature_set.id,target.feature_set.name,'FeatureSet · ')}${target.features.map(x=>linkButton(x.id,x.name,'Feature · ')).join('')}</div>`:'<div class="detail-row">Target unavailable.</div>';const agreement=Object.entries(code.contract).filter(([k])=>k!=='agrees').map(([k,v])=>`${k}: ${v?'yes':'no'}`).join(' · ');const imports=code.imports.map(x=>`<div class="native-item">${linkButton(x.id,x.name,'Import · ')}${linkButton(x.function.id,x.function.name,`Function · ${x.optional?'optional':'required'} · `)}</div>`).join('')||'<div class="detail-row">No imports.</div>';const relocations=code.relocations.map(x=>`<div class="native-item">${linkButton(x.id,x.name,'Relocation · ')}<div>${escapeHtml(x.kind)} · offset ${x.offset} · width ${x.patch_width} · addend ${x.addend} · ${x.in_bounds?'in bounds':'out of bounds'}</div>${linkButton(x.target.id,x.target.name,'Target · ')}</div>`).join('')||'<div class="detail-row">No relocations.</div>';return `<section class="detail-card native-code"><h3>Native Code</h3><div class="metadata">${meta}</div>${linkButton(code.owner_function.id,code.owner_function.name,'Function · ')}${linkButton(code.signature.id,code.signature.name,'Signature · ')}<h3>Hex dump</h3><div class="legend"><span class="badge">entry byte / row highlighted</span> · raw bytes only; no disassembly</div><div class="hex-dump">${rows}</div><h3>Target facts</h3>${targetFacts}<h3>Contract status</h3><div class="detail-row"><span class="badge ${code.contract.agrees?'good':'bad'}">${code.contract.agrees?'agrees':'disagrees'}</span> · ${escapeHtml(agreement)}</div>${code.validation_warnings.map(x=>`<div class="detail-row">${escapeHtml(x)}</div>`).join('')}<h3>Imports</h3><div class="native-list">${imports}</div><h3>Relocations</h3><div class="native-list">${relocations}</div></section>`}

async function loadTargets(){const selector=document.querySelector('#active-target'),requested=new URL(location.href).searchParams.get('target'),query=requested?`?active_target=${encodeURIComponent(requested)}`:'';const data=await fetch(`/api/rxfs/${token}/targets${query}`).then(r=>r.json());for(const target of data.targets){const option=document.createElement('option');option.value=target.id;option.textContent=`${target.name} · ${target.architecture.name}/${target.abi.name}/${target.environment.name}`;option.selected=target.id===requested;selector.append(option)}return selector.value}
async function showBindingHealth(){const target=document.querySelector('#active-target').value;if(!target){details.textContent='Select an active target.';return}const entry=selected;if(!entry){details.textContent='Select a Function to preflight.';return}const node=await fetch(`/api/rxfs/${token}/nodes/${encodeURIComponent(entry)}`).then(r=>r.json());if(node.execution?.category!=='Function'){details.textContent='Selected object is not a Function.';return}const query=new URLSearchParams({entry_function:entry,active_target:target});const response=await fetch(`/api/rxfs/${token}/preflight?${query}`);const data=await response.json();if(!response.ok){details.textContent=data.detail||'Preflight failed.';return}const selectedRows=data.selected.map(x=>linkButton(x.code_id,'Code',`Function #${x.function_id} selected · `)).join('')||'<div class="detail-row">No selected Code.</div>';const refusals=data.diagnostics.map(x=>linkButton(x.object_id,x.message,`${x.code} · `)).join('')||'<div class="detail-row">No refusals.</div>';const candidateRows=data.candidates.map(x=>linkButton(x.code_id,'Code',`${x.compatible?'compatible':x.reason||'rejected'} · rank ${JSON.stringify(x.rank)} · `)).join('')||'<div class="detail-row">No candidates.</div>';details.innerHTML=`<h1>Native binding: ${escapeHtml(data.health)}</h1><section class="detail-card"><h3>Active target</h3>${linkButton(data.active_target,'RuntimeTarget')}<h3>Selected</h3>${selectedRows}<h3>Refusals</h3>${refusals}<h3>Candidates</h3>${candidateRows}</section>`;details.querySelectorAll('[data-object]').forEach(b=>b.onclick=()=>selectNode(b.dataset.object,true))}
document.querySelector('#binding-health').onclick=showBindingHealth;
document.querySelector('#active-target').onchange=e=>{const u=new URL(location.href);if(e.target.value)u.searchParams.set('target',e.target.value);else u.searchParams.delete('target');history.replaceState(null,'',u);if(selected)showBindingHealth()};
function escapeHtml(value){const e=document.createElement('span');e.textContent=value;return e.innerHTML}
async function revealPath(id){const path=[];let current=id;while(current!=null){const n=await fetch(`/api/rxfs/${token}/nodes/${encodeURIComponent(current)}`).then(r=>r.json());path.unshift(n.id);current=n.parent}for(let i=0;i<path.length-1;i++){const label=document.querySelector(`.object-label[data-id="${CSS.escape(path[i])}"]`);if(!label)break;const li=label.closest('li'),twisty=li.querySelector(':scope > .row > .twisty-button');await toggleNode(li,twisty,{id:path[i],name:label.textContent,has_children:true},true)}}
async function selectNode(id,push=false){selected=String(id);if(push){const u=new URL(location.href);u.searchParams.set('object',selected);history.replaceState(null,'',u)}await revealPath(selected);document.querySelectorAll('.object-label').forEach(b=>b.classList.toggle('selected',b.dataset.id===selected));summary.textContent=`Selected object #${selected}`;showDetails(selected);draw()}
const details=document.querySelector('#details'),search=document.querySelector('#search'),results=document.querySelector('#results');let searchTimer;search.oninput=()=>{clearTimeout(searchTimer);searchTimer=setTimeout(async()=>{const q=search.value.trim().toLowerCase();results.innerHTML='';if(!q)return;const nodes=await fetch(`/api/rxfs/${token}/nodes`).then(r=>r.json());for(const n of nodes.filter(n=>n.id.includes(q)||n.fqn.toLowerCase().includes(q)).slice(0,50)){const holder=document.createElement('div');holder.innerHTML=linkButton(n.id,n.fqn,`${n.kind} · `);holder.firstChild.onclick=()=>selectNode(n.id,true);results.append(holder.firstChild)}},150)};document.querySelector('#collapse-all').onclick=()=>{tree.querySelectorAll('ul').forEach(ul=>ul.hidden=true);tree.hidden=false;tree.querySelectorAll('.twisty-button').forEach(b=>{if(!b.disabled){b.textContent='▸';b.setAttribute('aria-expanded','false')}})};
document.querySelectorAll('[data-nav]').forEach(button=>button.onclick=()=>{const key=button.dataset.nav;const value=key==='entry'?initialObject:key==='code'?objectNav.code?.[0]:objectNav[key];if(value!=null)selectNode(value,true)});document.querySelector('#reset').onclick=()=>{view={start:0,end:0};loadMemory()};new ResizeObserver(()=>memory&&draw()).observe(canvas);appendChildren(tree).then(()=>{const q=new URL(location.href).searchParams.get('object')||location.hash.match(/^#object=(\d+)$/)?.[1]||initialObject;if(q)selectNode(q,false)});loadTargets();loadMemory();
</script></body></html>
