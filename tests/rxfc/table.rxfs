# memory: a table of 32-bit words written and summed, all widths, copy and fill, loops with break/continue
program table(base, n) {
    var i, p, q, acc, skipped;
    i = 0;
    p = base;
    while i < n {
        store32(p, i * 4 + 1);
        p = p + 4;
        i = i + 1;
    }
    store8(p, 255);
    store16(p + 2, 513);
    store64(p + 8, 0x1122334455667788);
    copy(p + 32, p, 16);
    fill(p + 48, 7, 4);
    acc = 0;
    i = 0;
    skipped = 0;
    while 1 {
        if i == n { break; }
        if (i & 1) == 1 {
            skipped = skipped + 1;
            i = i + 1;
            continue;
        }
        acc = acc + load32(base + i * 4);
        i = i + 1;
    }
    acc = acc + load8(p) + load16(p + 2) + load64(p + 40) + load32(p + 48) + (skipped << 56);
    q = p + 64;
    put(q, acc, 8);
    put(q, 1, 4);
    return load64(p + 64) + load64(p + 32);
}
