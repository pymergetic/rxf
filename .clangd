# RXF builds with CMake and has no entry in the editor's compile database
# (../../.vscode/compile_commands.json, which holds absolute paths too). `src` is the include
# root of every `#include <pymergetic/rxf/...>`.
CompileFlags:
  Add:
    - -I/home/ladmin/Devel/os-sdk/packages/rxf/src
    - -I/home/ladmin/Devel/os-sdk/packages/rxf/third_party/pugixml
---
If:
  PathMatch: .*\.(cpp|hpp)
CompileFlags:
  Add:
    - -std=c++20
---
# The wrapper seats are x86 freestanding C (binary/builder.py); pin what the builds pass
# so an editor without a compile entry cannot analyze them for another target.
If:
  PathMatch: .*/native/wrap/.*\.(c|h)$
CompileFlags:
  Add:
    - -target
    - x86_64-unknown-linux-gnu
    - -std=c11
    - -ffreestanding
    - -fno-builtin
