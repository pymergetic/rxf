# RXF builds with CMake. The compile database (nanobind, the Python headers, every core
# source) lives in build_clangd/, regenerated by
#   cmake -S . -B build_clangd -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -G Ninja
# (with the venv's python as Python_EXECUTABLE). Files outside the database (native/,
# tools/) fall back to the include roots below.
CompileFlags:
  CompilationDatabase: build_clangd
---
# `src` is the include root of every `#include <pymergetic/rxftk/...>`; nanobind and the
# Python headers ride along so an analysis without a database entry (a header, a fresh
# editor) still resolves `#include <nanobind/...>` — without it, NB_MODULE does not exist
# and every declaration of the module entry is red.
CompileFlags:
  Add:
    - -I/home/ladmin/Devel/os-sdk/packages/rxf/src
    - -I/home/ladmin/Devel/os-sdk/packages/rxf/third_party/pugixml
    - -isystem/home/ladmin/Devel/os-sdk/packages/rxf/.venv/lib/python3.14/site-packages/nanobind/include
    - -isystem/home/ladmin/.local/share/uv/python/cpython-3.14.4-linux-x86_64-gnu/include/python3.14
---
If:
  PathMatch: .*\.(cpp|hpp)
CompileFlags:
  Add:
    - -std=c++20
---
# The wrapper seats are x86 freestanding C (binary/builder.py); pin what the builds pass
# so an editor without a compile entry cannot analyze them for another target.
If:
  PathMatch: .*native/wrap/.*\.(c|h)$
CompileFlags:
  CompilationDatabase: None
  Add:
    - -target
    - x86_64-unknown-linux-gnu
    - -std=c11
    - -ffreestanding
    - -fno-builtin
---
# boot/ is freestanding per-seat C (boot/Makefile) with no compile database
# entry: one source per machine, no libc headers, include roots outside src/.
# Pin each file to the flags and target its seat builds with, or an editor
# analyzes an aarch64 UART with host defaults and every type in graph.h is
# red. entry.c, world.c and uart_x86_64.c build for several seats; they are
# pinned to their first seat (x86_64), the rest is one seat each.
If:
  PathMatch: .*boot/(image_stub/)?.*\.(c|h)$
CompileFlags:
  CompilationDatabase: None
  Add:
    - -ffreestanding
    - -fno-builtin
    - -fno-stack-protector
    - -fno-pic
    - -fno-asynchronous-unwind-tables
    - -I/home/ladmin/Devel/os-sdk/packages/rxf/boot
    - -I/home/ladmin/Devel/os-sdk/packages/rxf/boot/image_stub
    - -I/home/ladmin/Devel/os-sdk/packages/rxf/native
---
If:
  PathMatch: .*boot/image_stub/(entry|world|uart_x86_64)\.c$
CompileFlags:
  Add:
    - -target
    - x86_64-unknown-none-elf
    - -DRXF_BOOT_SEAT_X86
---
If:
  PathMatch: .*boot/uefi_stub\.c$
CompileFlags:
  Add:
    - -target
    - x86_64-windows-msvc
---
If:
  PathMatch: .*boot/image_stub/uart_aarch64\.c$
CompileFlags:
  Add:
    - -target
    - aarch64-none-elf
    - -DRXF_BOOT_SEAT_A64
---
If:
  PathMatch: .*boot/(image_stub/uart_wasm32\.c|wasm_shim\.c)$
CompileFlags:
  Add:
    - -target
    - wasm32
---
# The boot sector and aarch64 trampoline are pure gas (x86_64.S has no
# includes); clang's parser is not gas and every directive lights up.
If:
  PathMatch: .*boot/.*\.(S|s)$
Diagnostics:
  Suppress: ["*"]
