# RXF builds with CMake. The compile database (nanobind, the Python headers, every core
# source) lives in build_clangd/, regenerated by
#   cmake -S . -B build_clangd -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -G Ninja
# (with the venv's python as Python_EXECUTABLE). Files outside the database (native/,
# tools/) fall back to the include roots below.
CompileFlags:
  CompilationDatabase: build_clangd
---
# `src` is the include root of every `#include <pymergetic/rxftk/...>`.
CompileFlags:
  Add:
    - -I/home/ladmin/Devel/os-sdk/packages/rxf/src
    - -I/home/ladmin/Devel/os-sdk/packages/rxf/third_party/pugixml
---
If:
  PathMatch: .*\.(cpp|hpp)
CompileFlags:
  Add:
    - -std=c++20
---
# The wrapper seats are x86 freestanding C (binary/builder.py); pin what the builds pass
# so an editor without a compile entry cannot analyze them for another target.
If:
  PathMatch: .*/native/wrap/.*\.(c|h)$
CompileFlags:
  Add:
    - -target
    - x86_64-unknown-linux-gnu
    - -std=c11
    - -ffreestanding
    - -fno-builtin
